{% extends "_layouts/default.njk" %}

{% set title = __("team.show.title") %}

{% block content %}
  {{ super() }}

  {{ heading({
    caption: team.name,
    text: title,
    size: "l"
  }) }}

  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-one-quarter">
      {{ appSectionNavigation({
        vertical: true,
        items: navigationItems
      }) }}
    </div>

    <div class="nhsuk-grid-column-three-quarters">
      {{ summaryList({
        card: {
          heading: {
            text: __("team.contact.summary"),
            size: "m"
          }
        },
        lastRowBorder: false,
        rows: summaryRows(team, {
          email: {
            href: team.uri + "/edit/team"
          },
          tel: {
            href: team.uri + "/edit/team"
          },
          privacyPolicyUrl: {
            href: team.uri + "/edit/team"
          }
        })
      }) }}
    <div>
  </div>
{% endblock %}
