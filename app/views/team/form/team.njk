{% extends "_layouts/form.njk" %}

{% set title = __("team.team.title") %}

{% block form %}
  {{ heading({
    caption: team.team.name if team.team_id,
    text: title,
    size: "l"
  }) }}

  {{ input({
    label: __("team.name.label"),
    decorate: "team.name"
  }) if team.team_id }}

  {{ input({
    label: __("team.email.label"),
    decorate: "team.email"
  }) }}

  {{ input({
    label: __("team.tel.label"),
    decorate: "team.tel",
    type: "tel"
  }) }}

  {{ input({
    label: __("team.privacyPolicyUrl.label"),
    hint: __("team.privacyPolicyUrl.hint"),
    decorate: "team.privacyPolicyUrl",
    type: "url"
  }) }}
{% endblock %}
