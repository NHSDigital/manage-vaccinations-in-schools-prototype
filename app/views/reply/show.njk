{% extends "_layouts/default.njk" %}

{% set title = __("reply.show.title", reply.fullName) %}
{% set showContactDetails = true if not reply.patient.isSensitive else false %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [
      {
        text: __("home.show.title"),
        href: "/"
      },
      {
        text: __("session.list.title"),
        href: "/sessions"
      },
      {
        text: referringPatientSession.session.location.name,
        href: referringPatientSession.session.uri
      } if referringPatientSession else {
        text: reply.session.location.name,
        href: reply.session.uri
      },
      {
        text: reply.patient.fullName,
        href: referringPatientSession.uri if referringPatientSession else reply.session.uri + "/patients/" + reply.patient.nhsn + "/" + reply.programme.id
      }
    ]
  }) }}
{% endblock %}

{% block content %}
  <div class="nhsuk-u-width-three-quarters">
    {{ super() }}

    {{ heading({
      text: title,
      size: "l"
    }) }}

    {{ appActionList({
      items: [
        {
          text: __("reply.withdraw.label"),
          href: reply.uri + "/edit/withdraw"
        } if reply.hasGivenConsent,
        {
          text: __("reply.follow-up.label"),
          href: reply.uri + "/edit/follow-up"
        } if not reply.hasConfirmedRefusal and not reply.hasGivenConsent,
        {
          text: __("reply.invalidate.label"),
          href: reply.uri + "/edit/invalidate"
        }
      ]
    }) if reply.isValid }}

    {% call card({
        heading: {
          text: __("reply.label"),
          size: "m"
        }
      }) %}
      {# Expiring soon? #}
      {{ appStatus({
        text: __("reply.expiringSoon.label"),
        icon: "warning",
        colour: "blue",
        classes: "nhsuk-u-margin-top-2 nhsuk-u-margin-bottom-2"
      }) if reply.isExpiringSoon and not reply.isInvalidated }}

      {# Consent details #}
      {{ summaryList({
        lastRowBorder: false,
        rows: summaryRows(reply, {
          programme: {},
          createdAt: {},
          expiresAt: {},
          method: {},
          decisionStatus: {},
          vaccineCriteria: {},
          refusalReason: {},
          refusalReasonDetails: {},
          note: {
            href: reply.uri + "/edit/note"
          }
        })
      }) }}
    {% endcall %}

    {# Contact details #}
    {{ summaryList({
      card: {
        heading: {
          text: __("contact.label"),
          size: "m"
        }
      },
      lastRowBorder: false,
      rows: summaryRows(reply.contact, {
        fullName: {
          href: reply.uri + "/edit/contact"
        },
        relationship: {
          href: reply.uri + "/edit/contact"
        },
        hasParentalResponsibility: {},
        email: {
          href: reply.uri + "/edit/contact" if showContactDetails
        },
        tel: {
          href: reply.uri + "/edit/contact" if showContactDetails
        },
        canSms: {},
        communicationNeeds: {}
      })
    }) if reply.contact }}

    {# Child details #}
    {{ summaryList({
      card: {
        heading: {
          text: __("child.label"),
          size: "m"
        }
      },
      lastRowBorder: false,
      rows: summaryRows(reply.child, {
        fullName: {},
        preferredFirstName: {},
        preferredLastName: {},
        dob: {},
        address: {},
        gpSurgery: {},
        schoolName: {}
      })
    }) if reply.child }}

    {# Health answers #}
    {{ summaryList({
      classes: "app-summary-list--full-width",
      card: {
        heading: {
          text: __("reply.healthAnswers.label"),
          size: "m"
        }
      },
      rows: healthAnswerRows(reply.healthAnswers)
    }) if reply.healthAnswers }}
  </div>
{% endblock %}
