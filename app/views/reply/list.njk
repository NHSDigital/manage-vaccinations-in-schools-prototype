{% from "../_macros/consent-request.njk" import appConsentRequest with context %}
{% from "../_macros/reply.njk" import appReply with context %}

{% extends "_layouts/form.njk" %}

{% set gridColumns = "full" %}
{% set hideConfirmButton = true %}
{% set title = patient.fullName + " – " + patient.programmes[programme.slug].name %}
{% set formAction = patientProgramme.uri + "/record?referrer=" + referrer %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [{
      text: __("home.show.title"),
      href: "/"
    }, {
      text: __("patient.list.title"),
      href: "/patients"
    }, {
      text: patientProgramme.patient.fullName,
      href: patientProgramme.patient.uri
    }, {
      text: patientProgramme.activeSeason.programme.name,
      href: patientProgramme.activeSeason.uri
    }]
  }) }}
{% endblock %}

{% block form %}
  {{ super() }}

  {{ heading({
    caption: patientProgramme.patient.fullName,
    text: __("reply.list.title", patientProgramme.programme.nameSentenceCase),
    size: "l"
  }) }}

  <div class="nhsuk-u-reading-width">
    {{ patientProgramme.consentDescription | nhsukMarkdown }}
  </div>

  {{ actionLink({
    text: __("reply.new.title"),
    href: patientProgramme.uri + "/replies/new?referrer=" + referrer
  }) if not patientProgramme.isVaccinated and not patientProgramme.patient.isPost16 }}

  {% if patientProgramme.replies | length %}
    {{ heading({
      text: __("patientProgramme.replies.label"),
      level: 2,
      size: "m"
    }) }}

    {% for reply in patientProgramme.replies %}
      {{ appReply({
        reply: reply
      }) }}
    {% endfor %}
  {% elif patientProgramme.consentRequests | length %}
    {{ heading({
      text: __("patientProgramme.consentRequests.label"),
      level: 2,
      size: "m"
    }) }}

    {% for consentRequest in patientProgramme.consentRequests %}
      {{ appConsentRequest({
        consentRequest: consentRequest
      }) }}
    {% endfor %}
  {% endif %}
{% endblock %}
