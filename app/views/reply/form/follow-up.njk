{% extends "_layouts/form.njk" %}

{% set paths = { back: reply.uri } %}
{% set title = __("reply.follow-up.title") %}

{% block form %}
  {{ heading({
    caption: __("reply.follow-up.caption", { reply: reply }),
    text: title,
    size: "l"
  }) }}

  {{ insetText({
    html: summaryList({
      lastRowBorder: false,
      rows: summaryRows(reply, {
        contactRelationship: {
          value: reply.contactRelationship.fullNameAndRelationship
        },
        email: {
          label: __("contactRelationship.email.label"),
          value: reply.contactRelationship.formatted.email
        },
        tel: {
          label: __("contactRelationship.tel.label"),
          value: reply.contactRelationship.formatted.tel
        },
        communicationNeeds: {},
        refusalReason: {},
        refusalReasonDetails: {}
      })
    })
  }) }}

  {{ radios({
    fieldset: {
      legend: {
        text: __("reply.follow-up.decision.label"),
        size: "m"
      }
    },
    items: [
      {
        label: __("reply.follow-up.decision.consent.label"),
        value: false
      },
      {
        label: __("reply.follow-up.decision.refuse.label"),
        value: true
      }
    ],
    decorate: "decision"
  }) }}
{% endblock %}
