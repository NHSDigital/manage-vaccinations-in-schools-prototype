{% extends "_layouts/form.njk" %}

{% set title = __("reply.healthAnswers.title") %}
{% set vaccineName = "nasal spray flu" if reply.programme_id == "flu" else "MMR" %}

{% macro questions(healthQuestions) %}
  {% for key, value in healthQuestions %}
    {{ radios({
      fieldset: {
        legend: __("healthQuestions." + key + ".label")
      },
      hint: __("healthQuestions." + key + ".hint", vaccineName),
      items: [
        {
          label: __("reply.healthAnswers.yes"),
          conditional: {
            html: textarea({
              label: __("reply.healthAnswers.details"),
              hint: __("healthQuestions." + key + ".detailsHint"),
              decorate: ["reply", "healthAnswers", key, "details"]
            })
          } if not value.conditional else {
            html: questions(value.conditional)
          }
        },
        {
          label: __("reply.healthAnswers.no")
        }
      ],
      decorate: ["reply", "healthAnswers", key, "answer"]
    }) }}
  {% endfor %}
{% endmacro %}

{% block form %}
  {{ appHeading({
    caption: reply.patient.fullName,
    title: title
  }) }}

  {{ questions(reply.healthQuestionsForDecision) }}
{% endblock %}
