{% extends "_layouts/form.njk" %}

{% if reply.hasSelfConsent %}
  {% set title = __("reply.decision.title.Child", {
    programme: reply.programme
  }) %}
{% else %}
  {% set title = __("reply.decision.title.Contact", {
    programme: reply.programme,
    patient: reply.patient
  }) %}
{% endif %}

{% block form %}
  {# Flu asks about the nasal spray and injection, MMR about the vaccine without gelatine #}
  {% set hasFluChoice = programme.hasIntranasalVaccine %}
  {% set hasGelatineChoice = programme.alternativeVaccine and not programme.hasIntranasalVaccine %}

  {{ radios({
    fieldset: {
      legend: {
        caption: reply.patient.fullName,
        heading: title,
        size: "l"
      }
    },
    items: [
      {
        label: __("reply.decision.nasal.label"),
        value: ReplyDecision.Given,
        conditional: {
          html: radios({
            fieldset: {
              legend: __("reply.hasConsentForAlternativeVaccine.flu.title")
            },
            items: getBooleanItems(),
            decorate: "reply.hasConsentForAlternativeVaccine"
          })
        }
      } if hasFluChoice,
      {
        label: __("reply.decision.injection.label"),
        value: ReplyDecision.OnlyAlternativeInjection
      } if hasFluChoice,
      {
        label: __("reply.decision.yes.label"),
        value: ReplyDecision.Given,
        conditional: {
          html: radios({
            fieldset: {
              legend: __("reply.hasConsentForAlternativeVaccine.mmr.title")
            },
            hint: __("reply.hasConsentForAlternativeVaccine.mmr.hint"),
            items: [
              {
                label: __("reply.hasConsentForAlternativeVaccine.mmr.yes.label"),
                value: true
              },
              {
                label: __("reply.hasConsentForAlternativeVaccine.mmr.no.label"),
                value: false
              }
            ],
            decorate: "reply.hasConsentForAlternativeVaccine"
          })
        } if hasGelatineChoice
      } if not hasFluChoice,
      {
        label: __('reply.decision.no.label'),
        value: ReplyDecision.Refused
      },
      {
        divider: "or"
      },
      {
        label: __('reply.decision.noResponse.label'),
        value: ReplyDecision.NoResponse
      }
    ],
    decorate: "reply.decision"
  }) }}

  {{ input({
    type: "hidden",
    value: programme.id,
    decorate: "reply.programme_id"
  }) if not isMultiProgrammeSession }}
{% endblock %}
