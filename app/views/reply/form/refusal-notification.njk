{% extends "_layouts/form.njk" %}

{% set title = __("reply.contact.canNotify.title", { contact: reply.contact }) %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        html: heading({
          caption: reply.patient.fullName,
          text: title,
          size: "l"
        })
      }
    },
    items: getBooleanItems(),
    decorate: "reply.contact.canNotify"
  }) }}
{% endblock %}
