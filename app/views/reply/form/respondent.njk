{% extends "_layouts/form.njk" %}

{% set title = __("reply.respondent.title") %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        html: heading({
          caption: reply.patient.fullName,
          text: title,
          size: "l"
        })
      }
    },
    items: respondentItems | push({
      divider: "or"
    }) | push({
      text: __("reply.respondent.new"),
      value: "new"
    }),
    decorate: "respondent"
  }) }}
{% endblock %}
