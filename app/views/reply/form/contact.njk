{% extends "_layouts/form.njk" %}

{% if reply.contactRelationship.fullName %}
  {% set title = __("reply.contactRelationship.title.edit", { contactRelationship: reply.contactRelationship }) %}
{% else %}
  {% set title = __("reply.contactRelationship.title.new") %}
{% endif %}
{% set showContactDetails = true if not patientProgramme.patient.isSensitive else false %}

{% block form %}
  {{ heading({
    caption: reply.patient.fullName,
    text: title,
    size: "l"
  }) }}

  {%- set fosterCarerHtml = radios({
    fieldset: {
      legend: __("contactRelationship.hasParentalResponsibility.delegatedLabel")
    },
    hint: __("contactRelationship.hasParentalResponsibility.hint"),
    items: getBooleanItems(),
    decorate: "reply.contactRelationship.hasParentalResponsibility"
  }) %}

  {%- set guardianHtml = radios({
    fieldset: {
      legend: __("contactRelationship.hasParentalResponsibility.label")
    },
    hint: __("contactRelationship.hasParentalResponsibility.hint"),
    items: getBooleanItems(),
    decorate: "reply.contactRelationship.hasParentalResponsibility"
  }) %}

  {%- set otherHtml = input({
    label: __("contactRelationship.relationshipOther.label"),
    decorate: "reply.contactRelationship.relationshipOther"
  }) + radios({
    fieldset: {
      legend: __("contactRelationship.hasParentalResponsibility.label")
    },
    hint: __("contactRelationship.hasParentalResponsibility.hint"),
    items: getBooleanItems(),
    decorate: "reply.contactRelationship.hasParentalResponsibility"
  }) %}

  {# Add conditional html for ‘Foster carer’ option #}
  {% set items = injectConditionalHtml(parentalRelationshipItems, RelationshipType.Fosterer, fosterCarerHtml) %}

  {# Add conditional html for ‘Guardian’ option #}
  {% set items = injectConditionalHtml(items, RelationshipType.Guardian, guardianHtml) %}

  {# Add conditional html for ‘Other’ option #}
  {% set items = injectConditionalHtml(items, RelationshipType.Other, otherHtml) %}

  {{ input({
    label: __("contactRelationship.fullName.label"),
    decorate: "reply.contactRelationship.fullName"
  }) }}

  {# `pop` removes `Other` and `Unknown` from RelationshipType array #}
  {{ radios({
    fieldset: {
      legend: __("contactRelationship.relationship.label")
    },
    items: items,
    decorate: "reply.contactRelationship.relationship"
  }) }}

  {{ input({
    label: __("contactRelationship.email.label") + " (optional)",
    decorate: "reply.contactRelationship.email"
  }) if showContactDetails }}

  {{ input({
    label: __("contactRelationship.tel.label"),
    type: "tel",
    width: "20",
    decorate: "reply.contactRelationship.tel"
  }) if showContactDetails }}

  {# Only kept if a phone number is given #}
  {{ radios({
    fieldset: {
      legend: __("contactRelationship.canSms.title")
    },
    items: getBooleanItems(),
    decorate: "reply.contactRelationship.canSms"
  }) if showContactDetails }}

  {{ radios({
    fieldset: {
      legend: __("reply.hasCommunicationNeeds.title")
    },
    items: [
      {
        label: __("reply.hasCommunicationNeeds.yes"),
        value: true,
        conditional: {
          html: textarea({
            label: __("reply.communicationNeeds.title"),
            decorate: "reply.communicationNeeds"
          })
        }
      },
      {
        label: __("reply.hasCommunicationNeeds.no"),
        value: false
      }
    ],
    decorate: "reply.hasCommunicationNeeds"
  }) if showContactDetails }}
{% endblock %}
