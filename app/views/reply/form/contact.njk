{% extends "_layouts/form.njk" %}

{% if reply.contact.fullName %}
  {% set title = __("reply.contact.title.edit", { contact: reply.contact }) %}
{% else %}
  {% set title = __("reply.contact.title.new") %}
{% endif %}

{% block form %}
  {{ appHeading({
    caption: reply.patient.fullName,
    title: title
  }) }}

  {%- set fosterCarerHtml = radios({
    fieldset: {
      legend: __("contact.hasParentalResponsibility.delegatedLabel")
    },
    hint: __("contact.hasParentalResponsibility.hint"),
    items: getBooleanItems(),
    decorate: "reply.contact.hasParentalResponsibility"
  }) %}

  {%- set guardianHtml = radios({
    fieldset: {
      legend: __("contact.hasParentalResponsibility.label")
    },
    hint: __("contact.hasParentalResponsibility.hint"),
    items: getBooleanItems(),
    decorate: "reply.contact.hasParentalResponsibility"
  }) %}

  {%- set otherHtml = input({
    label: __("contact.relationshipOther.label"),
    decorate: "reply.contact.relationshipOther"
  }) + radios({
    fieldset: {
      legend: __("contact.hasParentalResponsibility.label")
    },
    hint: __("contact.hasParentalResponsibility.hint"),
    items: getBooleanItems(),
    decorate: "reply.contact.hasParentalResponsibility"
  }) %}

  {# Add conditional html for ‘Foster carer’ option #}
  {% set items = injectConditionalHtml(parentalRelationshipItems, ParentalRelationship.Fosterer, fosterCarerHtml) %}

  {# Add conditional html for ‘Guardian’ option #}
  {% set items = injectConditionalHtml(items, ParentalRelationship.Guardian, guardianHtml) %}

  {# Add conditional html for ‘Other’ option #}
  {% set items = injectConditionalHtml(items, ParentalRelationship.Other, otherHtml) %}

  {{ input({
    label: __("contact.fullName.label"),
    decorate: "reply.contact.fullName"
  }) }}

  {# `pop` removes `Other` and `Unknown` from ParentalRelationship array #}
  {{ radios({
    fieldset: {
      legend: __("contact.relationship.label")
    },
    items: items,
    decorate: "reply.contact.relationship"
  }) }}

  {{ input({
    label: __("contact.email.label"),
    decorate: "reply.contact.email"
  }) }}

  {{ input({
    label: __("contact.tel.label") + " (optional)",
    decorate: "reply.contact.tel"
  }) }}

  {{ radios({
    fieldset: {
      legend: __("contact.hasCommunicationNeeds.title")
    },
    items: [{
      label: __("contact.hasCommunicationNeeds.yes"),
      value: true,
      conditional: {
        html: textarea({
          label: __("contact.communicationNeeds.title"),
          decorate: "reply.contact.communicationNeeds"
        })
      }
    }, {
      label: __("contact.hasCommunicationNeeds.no"),
      value: false
    }],
    decorate: "reply.contact.hasCommunicationNeeds"
  }) }}
{% endblock %}
