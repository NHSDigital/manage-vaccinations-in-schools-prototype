{% extends "_layouts/form.njk" %}

{% set confirmButtonText = __("form.confirm") %}
{% set title = __("reply.new.check-answers.title") %}
{% set refusalReasonHasDetails = reply.refusalReason != RefusalReason.PersonalChoice or reply.refusalReason != RefusalReason.Other %}

{% block form %}
  {{ appHeading({
    caption: patient.fullName,
    title: title
  }) }}

  {{ summaryList({
    card: {
      heading: __("reply.label"),
      headingSize: "m"
    },
    lastRowBorder: false,
    rows: summaryRows(reply, {
      programme: {
        href: reply.uri + "/new/programme" if isMultiProgrammeSession
      },
      method: {
        href: reply.uri + "/new/method"
      },
      decision: {
        href: reply.uri + "/new/decision"
      },
      hasConsentForAlternativeVaccine: {
        href: reply.uri + "/new/decision"
      },
      refusalReason: {
        href: reply.uri + "/new/refusal-reason"
      },
      refusalReasonDetails: {
        href: reply.uri + "/new/refusal-reason-details"
      },
      note: {
        href: reply.uri + "/new/note"
      },
      createdBy: {}
    })
  }) }}

  {{ summaryList({
    card: {
      heading: __("child.label"),
      headingSize: "m"
    },
    lastRowBorder: false,
    rows: summaryRows(reply.child, {
      fullName: {},
      preferredFirstName: {},
      preferredLastName: {},
      dob: {},
      gpSurgery: {},
      schoolName: {}
    })
  }) if reply.child }}

  {{ summaryList({
    card: {
      heading: __("contact.label"),
      headingSize: "m"
    },
    lastRowBorder: false,
    rows: summaryRows(reply.contact, {
      fullName: {
        href: reply.uri + "/new/contact"
      },
      relationship: {
        href: reply.uri + "/new/contact"
      },
      hasParentalResponsibility: {
        href: reply.uri + "/new/contact"
      },
      canNotify: {
        href: reply.uri + "/new/can-notify"
      },
      email: {
        href: reply.uri + "/new/contact"
      },
      tel: {
        href: reply.uri + "/new/contact"
      },
      communicationNeeds: {
        href: reply.uri + "/new/contact"
      }
    })
  }) if reply.contact.relationship or reply.contact.canNotify !== undefined }}

  {{ summaryList({
    classes: "app-summary-list--full-width",
    card: {
      heading: __("reply.healthAnswers.label"),
      headingSize: "m"
    },
    rows: healthAnswerRows(
      reply.healthAnswers,
      reply.uri + "/new/health-answers"
    )
  }) if reply.healthAnswers }}

  {{ summaryList({
    card: {
      heading: __("triage.label", { patient: reply.patient }),
      headingSize: "m"
    },
    lastRowBorder: false,
    rows: summaryRows(triage, {
      status: {
        label: __("triage.status.label"),
        value: triage.status,
        href: reply.uri + "/new/triage"
      },
      note: {
        label: __("triage.note.label"),
        value: triage.note,
        href: reply.uri + "/new/triage"
      }
    })
  }) if triage.status }}
{% endblock %}
