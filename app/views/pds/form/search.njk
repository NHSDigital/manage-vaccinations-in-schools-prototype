{% extends "_layouts/form.njk" %}

{% set title = __("pdsRecord.search.title") %}

{% block form %}
  {{ heading({
    text: title,
    size: "l"
  }) }}

  {{ input({
    label: __("pdsRecord.firstName.label"),
    decorate: "firstName"
  }) }}

  {{ input({
    label: __("pdsRecord.lastName.label"),
    decorate: "lastName"
  }) }}

  {{ dateInput({
    fieldset: {
      legend: __("pdsRecord.dob.label")
    },
    hint: __("pdsRecord.dob.hint"),
    decorate: "dob_"
  }) }}

  {{ input({
    label: __("location.postalCode.label"),
    autocomplete: "postal-code",
    width: 10,
    decorate: "postalCode"
  }) }}
{% endblock %}
