{% extends "_layouts/default.njk" %}

{% set assetsName = "prototype" %}
{% set environment = false %}
{% set title = serviceName + " (Mavis)" %}
{% set headerOptions = {
  service: {
    text: serviceName
  }
} %}

{% block main %}
  {{ hero({
    heading: serviceName + " prototype",
    text: "Manage vaccinations in schools (Mavis) is a digital tool designed to help school age immunisation service (SAIS) teams manage their vaccination programmes end to end."
  }) }}

  <div class="nhsuk-width-container">
    <main class="nhsuk-main-wrapper" id="maincontent" role="main">
      {{ heading({
        text: serviceName,
        level: 2,
        size: "m"
      }) }}

      <p class="nhsuk-body">
        {{ actionLink({
          classes: "nhsuk-u-margin-bottom-0",
          text: "Start page for nurses and administrators",
          href: "/start"
        }) }}
      </p>

      <p class="nhsuk-body">
        {{ actionLink({
          text: "Start page for school administrators",
          href: "/start-schools"
        }) }}
      </p>

      {% set userItems = [] %}
      {% for uid, user in data.users %}
        {% set userItems = userItems | push({
          href: "/account/sign-in?uid=" + uid,
          text: user.role
        }) %}
      {% endfor %}

      {{ "Log in to the service with the following role:" | nhsukMarkdown }}

      {{ contentsList({
        classes: "nhsuk-u-margin-left-1",
        items: userItems
      }) }}

      <hr class="nhsuk-section-break nhsuk-section-break--visible nhsuk-section-break--l">

      {{ heading({
        text: "Give or refuse consent for vaccinations",
        level: 2,
        size: "m"
      }) }}

      {% for preset in SessionPresets %}
        {% if preset.active and not preset.clinicOnly %}
          {{ actionLink({
            classes: "nhsuk-u-margin-bottom-2",
            text: "Start page for parents to give or refuse consent for " + preset.name | replace("Flu", "flu"),
            href: navigation.consentUrl[preset.name] + "/start"
          }) }}

          {{ contentsList({
            classes: "nhsuk-u-margin-left-1",
            items: [
              {
                href: navigation.consentUrl[preset.name] + "/emails",
                text: preset.name + " consent emails"
              },
              {
                href: navigation.consentUrl[preset.name] + "/texts",
                text: preset.name + " consent text messages"
              }
            ]
          }) }}
        {% endif %}
      {% endfor %}

      <hr class="nhsuk-section-break nhsuk-section-break--visible nhsuk-section-break--l">

      {{ heading({
        text: "Book into a clinic",
        level: 2,
        size: "m"
      }) }}

      {% for preset in SessionPresets %}
        {% if preset.active and preset.clinicOnly %}
          {{ actionLink({
            classes: "nhsuk-u-margin-bottom-2",
            text: "Start page for parents to book into a clinic for " + preset.name | replace("Flu", "flu"),
            href: navigation.clinicInviteUrl[preset.name]
          }) }}
        {% endif %}
      {% endfor %}
    </main>
  </div>
{% endblock %}
