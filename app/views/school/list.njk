{% extends "_layouts/form.njk" %}

{% set gridColumns = "full" %}
{% set hideConfirmButton = true %}
{% set title = __("school.list.title") %}

{% block form %}
  {{ super() }}

  {{ appHeading({
    title: title
  }) }}

  <div class="nhsuk-grid-row">
    <app-auto-submit class="app-grid-column-filters">
      {% call card({
        classes: "app-filters",
        feature: true,
        heading: {
          text: __("school.search.label"),
          level: 2
        }
      }) %}
        {{ searchInput({
          label: {
            text: __("search.label"),
            size: "s"
          },
          attributes: {
            formaction: params.formaction,
            formmethod: "post"
          },
          decorate: "q"
        }) }}

        {{ radios({
          fieldset: {
            legend: {
              text: __("school.phase.label"),
              size: "s"
            }
          },
          small: true,
          items: radioFilterItems(SchoolPhase, data.phase),
          decorate: "phase"
        }) }}

        {{ checkboxes({
          fieldset: {
            legend: {
              text: __("school.unplannedProgrammes.label"),
              size: "s"
            }
          },
          hint: __("school.unplannedProgrammes.hint"),
          small: true,
          items: unplannedProgrammeItems,
          decorate: "programme_id"
        }) }}

        {{ checkboxes({
          fieldset: {
            legend: {
              text: __("school.search.showOnly"),
              size: "s"
            }
          },
          small: true,
          items: [
            {
              label: __("school.search.isClosed"),
              value: "isClosed"
            }
          ],
          decorate: "option"
        }) }}

        {{ appButtonGroup({
          buttons: [{
            text: __("search.confirm"),
            small: true,
            variant: "secondary",
            attributes: {
              formaction: params.formaction,
              formmethod: "post",
              role: "search"
            }
          }, {
            text: __("search.clear"),
            href: "/schools",
            small: true,
            variant: "secondary"
          } if data.q or data.phase or data.option]
        }) }}
      {% endcall %}
    </app-auto-submit>

    <div class="app-grid-column-results">
      {% if data.type and data.type != "none" %}
        {% set title = data.type + "s" %}
      {% else %}
        {% set title = "All schools" %}
      {% endif %}

      {{ appHeading({
        title: title,
        level: 2,
        size: "m",
        summary: __mf("school.results", {
          from: results.from,
          to: results.to,
          count: results.count
        }) | safe
      }) }}

      {% for school in results.page %}
        {{ summaryList({
          card: {
            classes: "app-card--compact",
            heading: {
              text: school.name | highlightQuery(data.q) | safe,
              size: "s",
              level: 3
            },
            href: school.uri,
            clickable: true
          },
          lastRowBorder: false,
          rows: summaryRows(school, {
            patients: {},
            id: {},
            status: {},
            phase: {},
            address: {},
            nextSessionDate: {},
            unplannedProgrammes: {}
          })
        }) }}
      {% endfor %}

      {{ pagination(pages) }}
    </div>
  </div>
{% endblock %}
