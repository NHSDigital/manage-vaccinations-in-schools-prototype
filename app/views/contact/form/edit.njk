{% extends "_layouts/form.njk" %}

{% set confirmButtonText = __("contact." + type + ".confirm") %}
{% set title = __("contact." + type + ".title") %}
{% set isSensitive = contact.patient.isSensitive %}

{% block form %}
  {{ heading({
    caption: contact.patient.fullName,
    text: title,
    size: "l"
  }) }}

  {{ input({
    label: __("contact.fullName.label"),
    decorate: "contact.fullName"
  }) }}

  {%- set fosterCarerHtml = radios({
    fieldset: {
      legend: __("contact.hasParentalResponsibility.delegatedLabel")
    },
    hint: __("contact.hasParentalResponsibility.hint"),
    items: getBooleanItems(),
    decorate: "contact.hasParentalResponsibility"
  }) %}

  {%- set guardianHtml = radios({
    fieldset: {
      legend: __("contact.hasParentalResponsibility.label")
    },
    hint: __("contact.hasParentalResponsibility.hint"),
    items: getBooleanItems(),
    decorate: "contact.hasParentalResponsibility"
  }) %}

  {%- set otherHtml = input({
    label: __("contact.relationshipOther.label"),
    decorate: "contact.relationshipOther"
  }) + radios({
    fieldset: {
      legend: __("contact.hasParentalResponsibility.label")
    },
    hint: __("contact.hasParentalResponsibility.hint"),
    items: getBooleanItems(),
    decorate: "contact.hasParentalResponsibility"
  }) %}

  {# Add conditional html for ‘Foster carer’ option #}
  {% set items = injectConditionalHtml(parentalRelationshipItems, RelationshipType.Fosterer, fosterCarerHtml) %}

  {# Add conditional html for ‘Guardian’ option #}
  {% set items = injectConditionalHtml(items, RelationshipType.Guardian, guardianHtml) %}

  {# Add conditional html for ‘Other’ option #}
  {% set items = injectConditionalHtml(items, RelationshipType.Other, otherHtml) %}

  {{ radios({
    fieldset: {
      legend: __("contact.relationship.label")
    },
    items: items,
    decorate: "contact.relationship"
  }) }}

  {# Phone numbers and email addresses are changed on the contacts tab, once
     a contact has been added #}
  {% if type == "new" %}
    {{ input({
      label: __("contact.email.label"),
      type: "email",
      spellcheck: false,
      decorate: "contact.email"
    }) if not isSensitive }}

    {{ input({
      label: __("contact.tel.label"),
      type: "tel",
      classes: "nhsuk-input--width-20",
      decorate: "contact.tel"
    }) if not isSensitive }}
  {% endif %}

  {# Text messages can only be sent if the contact has a phone number #}
  {% set hasPhoneNumber = contact.activeContactPoints | selectattr("isPhone") | length %}
  {{ radios({
    fieldset: {
      legend: __("contact.canSms.title", { contact: contact })
    },
    items: [
      {
        label: __("contact.canSms.true"),
        value: true
      },
      {
        label: __("contact.canSms.false"),
        value: false
      }
    ],
    decorate: "contact.canSms"
  }) if hasPhoneNumber and not isSensitive }}
{% endblock %}
