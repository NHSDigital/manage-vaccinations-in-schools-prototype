{% extends "_layouts/form.njk" %}

{% set confirmButtonText = __("form.confirm") %}
{% set title = __("clinicBooking.edit.title") %}

{% macro editPath(view) -%}
  {# TODO: write this macro to format the href for edit locations and referrer (copied from check-answers in give-or-refuse-consent) #}
  {{- view }}?referrer={{ session.consentUrl }}/{{ consent.uuid}}/new/check-answers
{%- endmacro %}

{% block form %}
  {{ appHeading({
    caption: appointmentCaption,
    title: title
  }) }}

  {{ summaryList({
    card: {
      heading: __("clinicBooking.edit.summary.appointment"),
      headingSize: "m"
    },
    lastRowBorder: false,
    rows: summaryRows(appointment, {
      location: {
        href: appointment.uri.edit + "/clinic-location" if journeyData.journeyType !== ClinicBookingJourneyType.DataMigration
      },
      date: {
        href: appointment.uri.edit + "/clinic-date" if journeyData.journeyType !== ClinicBookingJourneyType.DataMigration
      },
      timeSlot: {
        href: appointment.uri.edit + "/appointment-time-range" if (journeyData.journeyType !== ClinicBookingJourneyType.DataMigration) and (not journeyData.preselectedSlot)
      }
    })
  }) }}
{% endblock %}
