{% extends "_layouts/abandon-booking.njk" %}

{% set title = __("clinicBooking.clinicDate.title", firstName) %}

{# Show parents the clinic dates they've been invited to separately from the others #}
{% set invitedItems = clinicDateItems | selectattr("isInvited") %}
{% set otherItems = clinicDateItems | rejectattr("isInvited") %}

{% block form %}
  {{ heading({
    caption: appointmentCaption,
    text: title,
    size: "l"
  }) }}

  {% include "book-into-a-clinic/form/_session-summary.njk" %}

  {% if isParentFacing and invitedItems.length and otherItems.length %}
    {{ radios({
      fieldset: {
        legend: {
          text: __("clinicBooking.clinicDate.invited.label", firstName),
          size: "m"
        }
      },
      items: invitedItems,
      decorate: "appointment.session_id"
    }) }}

    {{ radios({
      fieldset: {
        legend: {
          text: __("clinicBooking.clinicDate.other.label"),
          size: "m"
        }
      },
      idPrefix: "appointment-session_id-other",
      items: otherItems,
      decorate: "appointment.session_id"
    }) }}
  {% else %}
    {{ radios({
      fieldset: {
        legend: {
          text: __("clinicBooking.clinicDate.date.label"),
          size: "m"
        }
      },
      items: clinicDateItems,
      decorate: "appointment.session_id"
    }) }}
  {% endif %}
{% endblock %}
