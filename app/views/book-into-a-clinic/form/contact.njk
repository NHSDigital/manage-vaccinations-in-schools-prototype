{% extends "_layouts/form.njk" %}

{% if isParentFacing %}
  {% set title = __("clinicBooking.contactRelationship.title.parent") %}
{% else %}
  {% if patient.contactRelationships.length === 0 or booking.contactRelationship.uuid === 'new' %}
    {% set title = __("clinicBooking.contactRelationship.title.team.new") %}
  {% else %}
    {% set title = __("clinicBooking.contactRelationship.title.team.existing") %}
  {% endif %}
{% endif %}
{% set showContactDetails = true if not patient.isSensitive else false %}

{% block form %}
  {% call fieldset({
    legend: {
      caption: appointmentCaption,
      heading: title,
      size: "l"
    }
  }) %}

    {{ input({
      label: __("clinicBooking.contactRelationship.fullName.label"),
      decorate: "booking.contactRelationship.fullName"
    }) }}

    {% include "book-into-a-clinic/form/_parental-relationship.njk" %}

    {{ input({
      label: __("clinicBooking.contactRelationship.email.label") + ("" if isParentFacing else " (optional)"),
      hint: __("clinicBooking.contactRelationship.email.hint") if isParentFacing,
      decorate: "booking.contactRelationship.email"
    }) if showContactDetails }}

    {{ input({
      label: __("clinicBooking.contactRelationship.tel.label") + " (optional)",
      hint: __("clinicBooking.contactRelationship.tel.hint") if isParentFacing,
      decorate: "booking.contactRelationship.tel"
    }) if showContactDetails }}

    {{ checkboxes({
      items: [
        {
          label: __("clinicBooking.contactRelationship.canSms.label", "you" if isParentFacing else "they"),
          value: true
        }
      ],
      decorate: "booking.contactRelationship.canSms"
    }) if showContactDetails }}

  {% endcall %}
{% endblock %}
