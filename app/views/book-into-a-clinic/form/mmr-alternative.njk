{% extends "_layouts/form.njk" %}

{% set title = __("clinicBooking.mmrAlternative.title", firstName) %}
{% set hint = __("clinicBooking.mmrAlternative.hint") %}

{# Replace MMR with MMRV content as necessary #}
{% if data.clinicInvite.invitedForMmrv %}
  {% set title = title | replace('MMR', 'MMRV') %}
  {% set hint = hint | replace('MMR', 'MMRV') %}
{% endif %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        html: appHeading({
          size: "l",
          title: title
        })
      }
    },
    hint: {
      text: hint
    },
    items: [{
      text: __("clinicBooking.mmrAlternative.yes.label", firstName),
      value: true
    }, {
      text: __("clinicBooking.mmrAlternative.no.label", firstName),
      value: false
    }],
    decorate: "appointment.mmrAlternative"
  }) }}
{% endblock %}
