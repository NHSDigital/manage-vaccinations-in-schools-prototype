{% extends "_layouts/form.njk" %}

{% set audience = "parent" if isParentFacing else "team" %}
{% set title = __("clinicBooking.hasCommunicationNeeds.title." + audience) %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        caption: appointmentCaption,
        heading: title,
        size: "l"
      }
    },
    hint: __("clinicBooking.hasCommunicationNeeds.hint." + audience),
    items: [
      {
        label: __("clinicBooking.hasCommunicationNeeds.yes"),
        value: true,
        conditional: {
          html: textarea({
            label: __("clinicBooking.communicationNeeds.title"),
            decorate: "booking.communicationNeeds"
          })
        }
      },
      {
        label: __("clinicBooking.hasCommunicationNeeds.no"),
        value: false
      }
    ],
    decorate: "booking.hasCommunicationNeeds"
  }) }}
{% endblock %}
