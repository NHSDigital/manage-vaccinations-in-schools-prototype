{% extends "_layouts/form.njk" %}

{% set title = __("clinicBooking.contactSelection.title", firstName) %}

{% set contactItems = [] %}
{% for contactRelationship in patient.contactRelationships %}
  {% set contactMethods = [] %}
  {% for emailAddress in contactRelationship.formattedContactValues(ContactType.Email) %}
    {% set contactMethods = contactMethods | push(__("clinicBooking.contactSelection.itemHint.email", emailAddress)) %}
  {% endfor %}
  {% for phoneNumber in contactRelationship.formattedContactValues(ContactType.Phone) %}
    {% set contactMethods = contactMethods | push(__("clinicBooking.contactSelection.itemHint.tel", phoneNumber)) %}
  {% endfor %}
  {% set contactItems = contactItems | push({
    text: contactRelationship.fullNameAndRelationship,
    value: contactRelationship.uuid,
    hint: {
      html: contactMethods | join('<br>') | safe
    }
  }) %}
{% endfor %}
{% set contactItems = contactItems | push({
  divider: 'or'
}) %}
{% set contactItems = contactItems | push({
  text: __("clinicBooking.contactSelection.new"),
  value: "new"
}) %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        caption: appointmentCaption,
        heading: title,
        size: "l"
      }
    },
    hint: __("clinicBooking.contactSelection.hint"),
    items: contactItems,
    decorate: "booking.contactRelationship.uuid"
  }) }}
{% endblock %}
