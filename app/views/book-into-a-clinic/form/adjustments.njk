{% extends "_layouts/form.njk" %}

{% set title = __("clinicBooking.adjustments.title", firstName) %}
{% if childCount > 1 and childNumber < childCount %}
  {% set confirmButtonText = __("clinicBooking.nextChildButtonText") %}
{% endif %}

{% block form %}
  {{ checkboxes({
    fieldset: {
      legend: {
        html: heading({
          caption: appointmentCaption,
          text: title,
          size: "l"
        })
      }
    },
    items: [{
      label: __("consent.child.adjustments.assistanceAnimal.label"),
      value: Adjustment.AssistanceAnimal,
      exclusiveGroup: "adjustments-list"
    },{
      label: __("consent.child.adjustments.distraction.label"),
      value: Adjustment.Distraction,
      exclusiveGroup: "adjustments-list"
    }, {
      label: __("consent.child.adjustments.privacy.label"),
      value: Adjustment.Privacy,
      hint: __("consent.child.adjustments.privacy.hint"),
      exclusiveGroup: "adjustments-list"
    }, {
      label: __("consent.child.adjustments.other.label"),
      value: Adjustment.Other,
      conditional: {
        html: input({
          label: __("consent.child.adjustmentsOther.title"),
          decorate: "appointment.child.adjustmentsOther"
        })
      },
      exclusiveGroup: "adjustments-list"
    },
    {
      divider: 'or'
    },
    {
      label: __("clinicBooking.adjustments.none.label", firstName),
      value: Adjustment.None,
      behaviour: "exclusive",
      behaviourGroup: "adjustments-list"
    }],
    decorate: "appointment.child.adjustments"
  }) }}
{% endblock %}
