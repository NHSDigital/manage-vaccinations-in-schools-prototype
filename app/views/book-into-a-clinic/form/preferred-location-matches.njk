{% extends "_layouts/form.njk" %}

{% set title = __("clinicBooking.preferredLocationMatches.title", journeyData.preferredLocation) %}

{% block form %}
  {{ appHeading({
    title: title,
    caption: appointmentCaption
  }) }}

  {{ radios({
    fieldset: {
      legend: { text: __("clinicBooking.preferredLocationMatches.hits.label") }
    },
    items: [{
      text: journeyData.preferredLocation + ' upon Tyne, NE1',
      value: 'NE1'
    },
    {
      text: journeyData.preferredLocation + '-under-Lyme, ST5',
      value: 'ST5'
    },
    {
      text: journeyData.preferredLocation + ', SY7',
      value: 'SY7'
    },
    {
      divider: 'or'
    },
    {
      text: __('clinicBooking.preferredLocationMatches.tryAgain'),
      value: 'retry'
    }],
    decorate: "appointment.preferredPostcode"
  }) }}
{% endblock %}
