{% extends "_layouts/form.njk" %}

{% set title = __("clinicBooking.preferredLocationMatches.title", journeyData.preferredLocation) %}

{% block form %}
  {{ heading({
    caption: appointmentCaption,
    text: title,
    size: "l"
  }) }}

  {{ radios({
    fieldset: {
      legend: __("clinicBooking.preferredLocationMatches.hits.label")
    },
    items: [{
      label: journeyData.preferredLocation + ' upon Tyne, NE1',
      value: 'NE1'
    },
    {
      label: journeyData.preferredLocation + '-under-Lyme, ST5',
      value: 'ST5'
    },
    {
      label: journeyData.preferredLocation + ', SY7',
      value: 'SY7'
    },
    {
      divider: 'or'
    },
    {
      label: __('clinicBooking.preferredLocationMatches.tryAgain'),
      value: 'retry'
    }],
    decorate: "appointment.preferredPostcode"
  }) }}
{% endblock %}
