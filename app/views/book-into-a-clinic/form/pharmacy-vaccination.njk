{% extends "_layouts/form.njk" %}

{% set title = __("clinicBooking.pharmacy.title") %}
{% set hideConfirmButton = true %}

{% block form %}
  {{ heading({
    text: title,
    size: "l"
  }) }}

  {% if appointment.selected_programme_ids.length > 1 %}
    {{ heading({
      text: __("clinicBooking.pharmacy.flu.heading"),
      level: 2,
      size: "m"
    }) }}
  {% endif %}

  {{ __("clinicBooking.pharmacy.flu.description") | nhsukMarkdown }}

  {{ button({
    text: __("clinicBooking.pharmacy.flu.action"),
    href: "https://www.nhs.uk/nhs-services/vaccination-and-booking-services/book-flu-vaccination/"
  }) }}

  {% if appointment.selected_programme_ids.length > 1 %}
    {{ heading({
      text: __("clinicBooking.pharmacy.others.heading"),
      level: 2,
      size: "m"
    }) }}

    {{ __mf("clinicBooking.pharmacy.others.description", {
      count: appointment.selected_programme_ids.length - 1,
      programmeNames: otherProgrammeNames
    }) | nhsukMarkdown }}

    {{ link("remove-flu", __("clinicBooking.pharmacy.others.action", otherProgrammeNames)) | nhsukMarkdown }}
  {% endif %}

  {{ heading({
    text: __("clinicBooking.pharmacy.feedback.heading"),
    level: 2,
    size: "m"
  }) }}

  {{ __("clinicBooking.pharmacy.feedback.description") | nhsukMarkdown }}

  <p class='nhsuk-body'>
    <a href="not-convenient" target="_blank" rel="noreferrer noopener">{{ __("clinicBooking.pharmacy.feedback.action") }}</a>
  </p>
{% endblock %}
