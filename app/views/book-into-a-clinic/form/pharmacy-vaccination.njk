{% extends "_layouts/form.njk" %}

{% set title = __("clinicBooking.pharmacy.title") %}
{% set hideConfirmButton = true %}

{% block form %}
  {{ heading({
    text: title,
    size: "l"
  }) }}

  {# Offer a redirect to the NBS for booking a pharmacy appointment #}
  {% if appointment.selected_programme_ids.length > 1 %}
    {{ heading({
      text: __("clinicBooking.pharmacy.flu.heading"),
      level: 2,
      size: "m"
    }) }}
  {% endif %}

  {{ __("clinicBooking.pharmacy.flu.description") | nhsukMarkdown }}

  {{ button({
    text: __("clinicBooking.pharmacy.flu.action"),
    href: pharmacyBookingUri
  }) }}

  {# If the parent had selected more than just flu, offering trying without flu #}
  {% if appointment.selected_programme_ids.length > 1 %}
    {{ heading({
      text: __("clinicBooking.pharmacy.others.heading"),
      level: 2,
      size: "m"
    }) }}

    <p class="nhsuk-body">
      {{ __mf("clinicBooking.pharmacy.others.description.intro", {
        count: appointment.selected_programme_ids.length - 1,
        programmeNames: otherProgrammeNames
      }) }}
      <a href="remove-flu" class="nhsuk-link">{{ __("clinicBooking.pharmacy.others.description.link", otherProgrammeNames) }}</a>.
    </p>
  {% endif %}

  {# Keep the possibility of giving us feedback on the clinics; we'll re-offer NBS at the end of that #}
  {{ heading({
    text: __("clinicBooking.pharmacy.feedback.heading"),
    level: 2,
    size: "m"
  }) }}

  <p class="nhsuk-body">
    {{ link({
      text: __("clinicBooking.pharmacy.feedback.description.link"),
      href: "not-convenient"
    }) }}
    {{ __("clinicBooking.pharmacy.feedback.description.outro") | safe }}
  </p>
{% endblock %}
