{% extends "_layouts/abandon-booking.njk" %}

{% set title = __("clinicBooking.clinicLocation.title", firstName) %}

{# Show restricted invitation clinics separately from open ones #}
{% set audience = "parent" if isParentFacing else "team" %}
{% set invitedItems = clinicLocationItems | selectattr("isInvited") %}
{% set otherItems = clinicLocationItems | rejectattr("isInvited") %}

{% block form %}
  {% set hint = __('clinicBooking.clinicLocation.hint', appointment.preferredPostcode) %}

  {% if invitedItems.length and otherItems.length %}
    {# Listing a mix of restricted-invite and open clinics #}
    {{ heading({
      caption: appointmentCaption,
      text: title,
      size: "l"
    }) }}

    <p class="nhsuk-hint">{{ hint }}</p>

    {{ radios({
      fieldset: {
        legend: {
          text: __("clinicBooking.clinicLocation.invited.label." + audience, firstName),
          size: "m"
        }
      },
      items: invitedItems,
      decorate: "journeyData.clinicLocation"
    }) }}

    {{ radios({
      fieldset: {
        legend: {
          text: __("clinicBooking.clinicLocation.other.label." + audience),
          size: "m"
        }
      },
      idPrefix: "journeyData-clinicLocation-other",
      items: otherItems,
      decorate: "journeyData.clinicLocation"
    }) }}
  {% else %}
    {# Listing only one type of clinic, so no need to differentiate them #}
    {{ radios({
      fieldset: {
        legend: {
          caption: appointmentCaption,
          heading: title,
          size: "l"
        }
      },
      hint: hint,
      items: clinicLocationItems,
      decorate: "journeyData.clinicLocation"
    }) }}
  {% endif %}
{% endblock %}
