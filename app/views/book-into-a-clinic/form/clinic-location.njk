{% extends "_layouts/form.njk" %}

{% set title = __("clinicBooking.clinicLocation.title", firstName) %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        html: appHeading({
          title: title,
          caption: __("clinicBooking.appointment.caption", fullName) if childCount > 1
        })
      }
    },
    hint: { text: __('clinicBooking.clinicLocation.hint', data.transaction.preferredPostcode) },
    items: clinicLocationItems,
    decorate: "transaction.clinic_id"
  }) }}

{% endblock %}
