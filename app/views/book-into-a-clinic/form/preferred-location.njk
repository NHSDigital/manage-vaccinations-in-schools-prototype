{% extends "_layouts/form.njk" %}

{% set title = __("clinicBooking.preferredLocation.title.team") if patient
          else __("clinicBooking.preferredLocation.title.parent", firstName) %}

{% block form %}
  {{ appHeading({
    title: title,
    caption: appointmentCaption
  }) }}

  {{ input({
    label: { text: __("clinicBooking.preferredLocation.location.label") },
    hint: { text: __("clinicBooking.preferredLocation.location.hint") },
    decorate: "transaction.preferredLocation"
  }) }}
{% endblock %}
