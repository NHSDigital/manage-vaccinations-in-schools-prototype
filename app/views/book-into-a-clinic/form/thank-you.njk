{% extends "_layouts/default.njk" %}

{% set paths = { back: false } %}
{% set title = __("clinicBooking.thankYou.title") %}

{% block content %}
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
      {{ heading({
        text: title,
        size: "l"
      }) }}

      {{ __("clinicBooking.thankYou.advice", { team: team }) | nhsukMarkdown }}

      {% if isPharmacyVaccinationAvailable %}
          {{ __("clinicBooking.thankYou.pharmacy.description") | nhsukMarkdown }}

          {{ button({
            text: __("clinicBooking.thankYou.pharmacy.action"),
            href: pharmacyBookingUri
          }) }}
      {% endif %}
    </div>
  </div>
{% endblock %}
