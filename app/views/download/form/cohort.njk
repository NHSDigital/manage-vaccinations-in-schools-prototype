{% extends "_layouts/form.njk" %}

{% set type = download.type | lower %}
{% set confirmButtonText = __("download.create.confirm", type) %}
{% set title = __("download.create.title", type) %}

{% block form %}
  {{ heading({
    text: title,
    size: "l"
  }) }}

  {{ __("download.create.description." + download.type, today + " at 1pm") | nhsukMarkdown }}

  {{ radios({
    formGroup: {
      classes: "nhsuk-u-margin-bottom-8"
    },
    fieldset: {
      legend: {
        text: __("download.programmeType.title"),
        size: "m"
      }
    },
    items: programmeTypeItems,
    decorate: "download.programmeType"
  }) }}

  {{ checkboxes({
    formGroup: {
      classes: "nhsuk-u-margin-bottom-8"
    },
    fieldset: {
      legend: {
        text: __("download.variables.title"),
        size: "m"
      }
    },
    items: enumItems(DownloadVariable),
    decorate: "download.variables"
  }) }}
{% endblock %}
