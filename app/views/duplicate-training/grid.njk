{% extends "_layouts/default.njk" %}

{% set pageName = "Duplicate record grid" %}
{% set containerClasses = "nhsuk-width-container-fluid" %}
{% set headerOptions = {
  service: {
    text: serviceName
  }
} %}

{% block content %}
  <!-- Duplicate record grid -->
  <!-- Records 1 to 4: one shared grid; each field is a grid row spanning the label column and all cards -->
  <div style="display: grid; grid-template-columns: 10rem repeat(4, 1fr); column-gap: 24px;">
    <!-- Card boundaries: one bordered underlay per record column (border swapped by the selection script) -->
    <div data-record-box="record-1" style="grid-column: 2; grid-row: 1 / 21; border: 1px solid #d8dde0; background: #ffffff;"></div>
    <div data-record-box="record-2" style="grid-column: 3; grid-row: 1 / 21; border: 1px solid #d8dde0; background: #ffffff;"></div>
    <div data-record-box="record-3" style="grid-column: 4; grid-row: 1 / 21; border: 1px solid #d8dde0; background: #ffffff;"></div>
    <div data-record-box="record-4" style="grid-column: 5; grid-row: 1 / 21; border: 1px solid #d8dde0; background: #ffffff;"></div>

    <!-- Headings -->
    <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5" style="grid-column: 1; grid-row: 1;">Key fields</h2>
    <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 2; grid-row: 1;">Record 1</h2>
    <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 3; grid-row: 1;">Record 2</h2>
    <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 4; grid-row: 1;">Record 3</h2>
    <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 5; grid-row: 1;">Record 4</h2>

    <!-- Selection tags: grey by default; the script swaps the chosen one to blue in place -->
    <div data-record-tag="record-1" class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 2; grid-row: 2;">
      <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2">Duplicate record</strong>
    </div>
    <div data-record-tag="record-2" class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 3; grid-row: 2;">
      <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2">Duplicate record</strong>
