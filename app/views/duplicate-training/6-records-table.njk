       buttons, unchanged by the selection: Skip (white secondary style) and Submit
       (green primary). Submit is the choose-record form's submit button; with no
       record chosen it produces the validation error above the page. Skip is a link
       to the same destination whatever is chosen. Both go to the index as a
       placeholder for advancing the queue (no real queue or saved state yet). -->
  <!-- Clearance for the fixed bar: padding at the very end of the document
       (below the footer) rather than a spacer above it, so scrolling to the
       bottom brings the footer fully above the bar -->
  <style>
    body { padding-bottom: 96px; }
  </style>
  <div data-set-bar style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 20; background: #ffffff; border-top: 1px solid #d8dde0; padding-bottom: env(safe-area-inset-bottom);">
    <div class="nhsuk-width-container-fluid nhsuk-u-padding-top-3 nhsuk-u-padding-bottom-3">
      <div style="max-width: 1720px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; column-gap: 24px;">
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0"><span class="app-set--unselected" data-set-status>Choose your preferred record</span><span class="app-set--selected" data-set-status>Preferred record chosen</span></p>
        <div style="display: flex; align-items: center; column-gap: 24px;">
          <!-- Skip: a link styled as a secondary button, so it works without scripts and
               ignores the radios. In Rails it becomes a second submit button on the form,
               name="action" value="skip", so the server records the skip. -->
          <a class="nhsuk-button nhsuk-button--secondary nhsuk-u-margin-bottom-0" data-module="nhsuk-button" data-set-action="skip" href="/duplicate-training" role="button" draggable="false">Skip to next duplicate</a>
          <button class="nhsuk-button nhsuk-u-margin-bottom-0" data-module="nhsuk-button" type="submit" form="choose-record" data-set-action="submit">Confirm your choice</button>
        </div>
      </div>
    </div>
  </div>
  <!-- /Sticky set navigation -->

  <!-- Research scaffolding, the shared file rather than an inline copy: on this page
       only its first part runs, the simulated server-side validation on Submit. -->
  <script src="/assets/javascripts/duplicate-training.js" type="module"></script>
{% endblock %}
