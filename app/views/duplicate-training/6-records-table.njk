{% block content %}
  <!-- Standard-width band: the Review chrome and the patient tier of the page
       header stay the standard page width (1100px here), matching the site
       header. The duplicate details panel and record grid below share the wider
       card canvas. margin: 0 auto stops the nested width container doubling the
       fluid containers side margins at narrower viewports. -->
  <div class="nhsuk-width-container" style="margin: 0 auto">
    <!-- Error summary, pre-rendered and hidden. In Rails the controller renders it
         when the form is submitted with no record chosen (server-side validation on
         the form); here the scaffolding script shows it and moves focus to it. The
         nhsukErrorSummary module is what focuses it on a real page load. -->
    <div class="nhsuk-error-summary" data-module="nhsuk-error-summary" data-choose-error-summary tabindex="-1" hidden>
      <div role="alert">
        <h2 class="nhsuk-error-summary__title">There is a problem</h2>
        <div class="nhsuk-error-summary__body">
          <ul class="nhsuk-list nhsuk-error-summary__list">
            <li><a href="#record-1">Choose a record to continue</a></li>
          </ul>
        </div>
      </div>
    </div>
    <!-- Review section chrome: page heading and section navigation as on /notices,
         plus a Duplicates tab shown as current and linking to the start page. The other
         tabs are presentation only, and these pages do not actually live under /notices yet. -->
    <div class="nhsuk-grid-row">
      <div class="nhsuk-grid-column-full">
        <h1 class="nhsuk-heading-l">Review</h1>
        <nav class="app-section-navigation" data-module="app-section-navigation" aria-label="Section navigation">
          <ul class="app-section-navigation__list">
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="/notices">Important notices<span class="app-section-navigation__suffix"><strong class="app-badge">4</strong></span></a>
            </li>
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="/consents">Consent responses<span class="app-section-navigation__suffix"><strong class="app-badge">0</strong></span></a>
            </li>
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="/unmatched-appointments">Clinic appointments<span class="app-section-navigation__suffix"><strong class="app-badge">23</strong></span></a>
            </li>
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="/moves">School moves<span class="app-section-navigation__suffix"><strong class="app-badge">90</strong></span></a>
            </li>
            <li class="app-section-navigation__item app-section-navigation__item--current">
              <a class="app-section-navigation__link" href="/duplicate-training/start" aria-current="page"><strong class="app-section-navigation__current">Duplicate records<span class="app-section-navigation__suffix"><strong class="app-badge" data-duplicates-badge>6</strong></span></strong></a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
    <!-- /Review section chrome -->
  <!-- Live count on the Duplicate records tab: the six user testing sets minus those
       moved past in this browser session. The test pages record an advance when the
       action button goes on to the next set, and the comment pages record one on
       Submit; nothing else changes the number, so demo pages only display it. -->
  <script>
    (() => {
      const render = () => {
        let progressed = []
        try { progressed = JSON.parse(sessionStorage.getItem("duplicate-training:progressed") || "[]") } catch (error) {}
        for (const badge of document.querySelectorAll("[data-duplicates-badge]")) badge.textContent = String(Math.max(0, 6 - progressed.length))
      }
      render()
      window.addEventListener("pageshow", render)
    })()
  </script>

    <div class="nhsuk-grid-row">
      <div class="nhsuk-grid-column-full">

        <!-- Duplicate page header -->

        <!-- Patient name -->
        <h1 class="nhsuk-heading-l nhsuk-u-display-inline-block nhsuk-u-margin-bottom-3">
          Freya Sutherland
        </h1>
        <a class="nhsuk-link nhsuk-u-margin-left-3" href="#">View full child record</a>

        <!-- Patient details -->
        <div class="nhsuk-grid-row nhsuk-u-margin-bottom-4">
          <div class="nhsuk-grid-column-one-third">
            <p class="nhsuk-body nhsuk-u-margin-bottom-0">
              <span class="nhsuk-u-font-weight-bold">NHS Number</span><br>
              999 555 6677
            </p>
          </div>
          <div class="nhsuk-grid-column-one-third">
            <p class="nhsuk-body nhsuk-u-margin-bottom-0">
              <span class="nhsuk-u-font-weight-bold">Date of birth</span><br>
              29 November 2010 (aged 15)
            </p>
          </div>
          <div class="nhsuk-grid-column-one-third">
            <p class="nhsuk-body nhsuk-u-margin-bottom-0">
              <span class="nhsuk-u-font-weight-bold">Address</span><br>
              3 Meadow Rise, Alderton, GL54 8QP
            </p>
          </div>
        </div>

        <!-- /Duplicate page header -->

      </div>
    </div>
  </div>

  <!-- Card canvas: duplicate details panel and record comparison grid, centred and
       capped at 1720px. The NHS design system has no wide-container token
       (standard page width is 1100px in this prototype), so the cap is set
       directly. Below 1280px viewports each grid stops compressing (min-width
       1216px = 1280px minus the 2 x 32px page margins) and the page gains a
       horizontal scrollbar instead: there is no overflow-x wrapper, because an
       overflow container would become the sticky scrollport and stop the
       table heads sticking to the viewport. -->
  <div style="max-width: 1720px; margin: 0 auto;">
    <!-- Duplicate summary: reuses the Mavis listing-page sidebar treatment
         (app-filters card: translucent grey-4 background, card
         border, no feature heading tab) -->
    <div class="nhsuk-card app-filters nhsuk-u-margin-bottom-0 nhsuk-u-padding-left-0 nhsuk-u-padding-right-0 nhsuk-u-padding-bottom-0">
      <div class="nhsuk-card__content">
        <!-- Highlight differences toggle: small checkbox, on by default, sits on
             the right of the panel. No script: the style block below keys off the
             checkbox's own checked state with :has(), so unticking neutralises
             every app-highlight mark without touching the markup -->
        <div style="display: flex; align-items: flex-start; justify-content: space-between; column-gap: 24px;">
          <div>
            <h2 class="nhsuk-heading-m nhsuk-u-margin-bottom-2">6 duplicate MMR records</h2>
            <p class="nhsuk-body nhsuk-u-secondary-text-colour nhsuk-u-margin-bottom-0">We have 6 records for the same vaccination dated 3 February 2026. Help us learn how to manage duplicates by choosing the record you trust most.</p>
          </div>
          <div class="nhsuk-form-group nhsuk-u-margin-bottom-0" style="flex-shrink: 0;">
            <div class="nhsuk-checkboxes nhsuk-checkboxes--small" data-module="nhsuk-checkboxes">
              <div class="nhsuk-checkboxes__item">
                <input class="nhsuk-checkboxes__input" id="highlight-differences" name="highlight-differences" type="checkbox" value="yes" checked>
                <label class="nhsuk-label nhsuk-checkboxes__label nhsuk-u-font-size-16" for="highlight-differences">
                  Highlight differences
                </label>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <style>
      body:has(#highlight-differences:not(:checked)) .app-highlight {
        border-bottom-color: transparent;
        background-color: transparent;
      }
      body:has(#highlight-differences:not(:checked)) .app-highlight::before,
      body:has(#highlight-differences:not(:checked)) .app-highlight::after {
        content: none;
      }
    </style>

    <!-- Table version of the record comparison. Each table is a real table: the
         first column holds the field names as row headers, the first head row
         holds the record headings as column headers, so every cell is associated
         with its field and its record. The second head row holds the status tag
         for each record. The Choose this record radios are the table foot, which
         is position: sticky with a bottom offset clearing the fixed set bar: the
         foot floats above the bar while the table is taller than the viewport and
         settles at the card bottom when the end scrolls into view, as the card
         footers did, with no sentinels or observers. Two details the card
         footers left to observers are handled in CSS here. The head cells are
         layered above the foot, so when a table's top is near the bottom of the
         viewport and the foot clamps against it, the foot sits behind the heading
         and tag rather than over them, and slides out from under them as the
         table scrolls up. And the fixed set bar is given a fixed 96px height, the
         same figure as the foot's sticky offset, so the pinned foot sits flush on
         the bar with no strip for the field rows to show through.

         Card look, by column: every cell in a record column carries the white
         background and the card's left and right border, the first head row adds
         the top edge and the foot the bottom edge, and border-spacing
         opens the 24px gap between columns. The field column has no card styling
         and sits on the grey canvas. The base nhsuk cell padding and rules are
         reset first, so the only lines are the ones set here. A 1px transparent inset on the outer edges
         becomes part of the border when a record is chosen, so the 2px blue
         outline never moves the content. The field rows keep the inset bottom
         rule of the card layouts, painted on the cell as a 1px background line
         24px in from each edge rather than on the inner paragraph: the cell
         always fills the row, so the rules of one row sit on one line however
         tall its tallest value, as the grid cards do. The field names sit in a
         block span inside their header cell, since the nhsuk-body-s class would
         otherwise turn the cell itself into a block and shrink it to its text.

         Live selection is CSS, keyed on the checked radio: the table is the anchor
         (:has() on it reaches every cell of the chosen column), each status cell
         carries both tags and shows one, and the set bar carries both status
         strings. The bar's buttons do not change with the selection. -->
    <style>
      .app-comparison {
        width: calc(100% + 48px);
        margin: 0 -24px;
        border-collapse: separate;
        border-spacing: 24px 0;
        table-layout: fixed;
      }
      .app-comparison th,
      .app-comparison td { padding: 0; border: 0; text-align: left; vertical-align: top; }
      .app-comparison tfoot { position: sticky; bottom: 96px; z-index: 10; }
      .app-comparison thead [data-record] { position: relative; z-index: 11; }
      .app-comparison__choose { padding-bottom: 12px; }
      [data-set-bar] { height: 96px; box-sizing: border-box; display: flex; align-items: center; }
      [data-set-bar] > .nhsuk-width-container-fluid { flex: 1; }
      .app-comparison [data-record] {
        background: #ffffff;
        border-left: 1px solid #d8dde0;
        border-right: 1px solid #d8dde0;
        padding-left: 1px;
        padding-right: 1px;
      }
      .app-comparison thead tr:first-child [data-record] { border-top: 1px solid #d8dde0; padding-top: 1px; }
      .app-comparison tfoot [data-record] { border-bottom: 1px solid #d8dde0; padding-bottom: 1px; }
      .app-comparison tbody th > span { display: block; }
      .app-comparison tbody tr:not(:last-child) th { border-bottom: 1px solid #d8dde0; }
      .app-comparison tbody tr:not(:last-child) td {
        background: linear-gradient(#d8dde0, #d8dde0) no-repeat 24px 100% / calc(100% - 48px) 1px border-box, #ffffff;
      }
      .app-record-card__tag--selected,
      .app-set--selected { display: none; }
      /* Prototype only: the pre-rendered errors stay hidden until the scaffolding shows
         them; nhsuk-error-message sets display: block, which beats the hidden attribute */
      .nhsuk-error-message[hidden],
      .nhsuk-error-summary[hidden] { display: none; }
      {% for n in range(1, recordCount + 1) %}
      .app-comparison:has(#record-{{ n }}:checked) [data-record="{{ n }}"] { border-left: 2px solid #005eb8; border-right: 2px solid #005eb8; padding-left: 0; padding-right: 0; }
      .app-comparison:has(#record-{{ n }}:checked) thead tr:first-child [data-record="{{ n }}"] { border-top: 2px solid #005eb8; padding-top: 0; }
      .app-comparison:has(#record-{{ n }}:checked) tfoot [data-record="{{ n }}"] { border-bottom: 2px solid #005eb8; padding-bottom: 0; }
      .app-comparison:has(#record-{{ n }}:checked) [data-record="{{ n }}"] .app-record-card__tag--unselected { display: none; }
      .app-comparison:has(#record-{{ n }}:checked) [data-record="{{ n }}"] .app-record-card__tag--selected { display: inline-block; }
      {% endfor %}
      body:has(input[name="preferred-record"]:checked) .app-set--unselected { display: none; }
      body:has(input[name="preferred-record"]:checked) .app-set--selected { display: inline; }
    </style>

    <!-- Duplicate record tables -->
    <div class="nhsuk-u-padding-5" style="background: #f0f4f5; box-shadow: inset 0 1px 7px rgba(0,0,0,0.1); border: 1px solid #d8dde0; border-top: 0;">
    <!-- The choice is a form: the radios below hold the state and Submit in the set
         bar is this form's submit button (form attribute), so choosing and submitting
         work with HTML alone. The inline error is pre-rendered and hidden: in Rails
         the controller renders it, the error class on the form group and the
         aria-describedby on the fieldset when no record is chosen (server-side
         validation on the form); here the scaffolding script does the same. -->
    <form id="choose-record" method="post" action="/duplicate-training" data-choose-form>
    <div class="nhsuk-form-group nhsuk-u-margin-bottom-0" data-choose-group>
    <!-- One radio group across both tables: the fieldset names the choice, the
         radios share a name, and each takes its accessible name from its own label
         followed by its record heading, so the visible words are in the name and the
         record is too -->
    <fieldset class="nhsuk-fieldset">
    <legend class="nhsuk-u-visually-hidden">Choose the record to keep</legend>
    <span class="nhsuk-error-message" id="preferred-record-error" data-choose-error hidden><span class="nhsuk-u-visually-hidden">Error:</span> Choose a record to continue</span>
    <!-- Records 1 to 4 -->
    <table class="app-comparison">
      <caption class="nhsuk-u-visually-hidden">Records 1 to 4</caption>
      <colgroup><col style="width: 10rem;"><col><col><col><col></colgroup>
      <thead>
        <tr>
          <th scope="col"><span class="nhsuk-u-visually-hidden">Field</span></th>
          <th scope="col" id="record-1-heading" data-record="1"><h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5">Record 1</h2></th>
          <th scope="col" id="record-2-heading" data-record="2"><h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5">Record 2</h2></th>
          <th scope="col" id="record-3-heading" data-record="3"><h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5">Record 3</h2></th>
          <th scope="col" id="record-4-heading" data-record="4"><h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5">Record 4</h2></th>
        </tr>
        <tr>
          <th scope="row"><span class="nhsuk-u-visually-hidden">Status</span></th>
          <td data-record="1"><div class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5">
            <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2 app-record-card__tag--unselected">Duplicate record</strong>
            <strong class="nhsuk-tag nhsuk-tag--blue nhsuk-u-margin-bottom-2 app-record-card__tag--selected">Your preferred record</strong>
          </div></td>
          <td data-record="2"><div class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5">
            <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2 app-record-card__tag--unselected">Duplicate record</strong>
            <strong class="nhsuk-tag nhsuk-tag--blue nhsuk-u-margin-bottom-2 app-record-card__tag--selected">Your preferred record</strong>
          </div></td>
          <td data-record="3"><div class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5">
            <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2 app-record-card__tag--unselected">Duplicate record</strong>
            <strong class="nhsuk-tag nhsuk-tag--blue nhsuk-u-margin-bottom-2 app-record-card__tag--selected">Your preferred record</strong>
          </div></td>
          <td data-record="4"><div class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5">
            <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2 app-record-card__tag--unselected">Duplicate record</strong>
            <strong class="nhsuk-tag nhsuk-tag--blue nhsuk-u-margin-bottom-2 app-record-card__tag--selected">Your preferred record</strong>
          </div></td>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row"><span class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold">Date</span></th>
          <td data-record="1"><p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5">3 February 2026</p></td>
          <td data-record="2"><p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5">3 February 2026</p></td>
          <td data-record="3"><p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5">3 February 2026</p></td>
          <td data-record="4"><p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5">3 February 2026</p></td>
        </tr>
        <tr>
          <th scope="row"><span class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold">Time</span></th>
          <td data-record="1"><p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5">12:00 am</p></td>
          <td data-record="2"><p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5">12:00 am</p></td>
          <td data-record="3"><p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5">12:00 am</p></td>
          <td data-record="4"><p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5">12:00 am</p></td>
