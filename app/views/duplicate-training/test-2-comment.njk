{% block content %}
  <!-- Optional comment step for user testing set 2, for a choice or a skip. Reached
       from the sticky bar when Tell us about this decision is ticked: the button reads
       Add comment with a record chosen, or Skip to next duplicate with none. The
       comparison page leaves the decision (a record id, or skip) in sessionStorage under
       duplicate-training:decision:test-2; this page uses it to ask the matching question.
       Submit stores decision and text together under duplicate-training:comment:test-2
       and logs them to the console, then moves on to the next set exactly as the bar
       would have; nothing is sent anywhere.
       Cancel goes back in history so the comparison page comes back with its choice
       and checkbox as they were. -->
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
      <span class="nhsuk-caption-l">Maya Chen, 3 duplicate MMR records</span>
      <h1 class="nhsuk-heading-l">Tell us about this decision</h1>
      <form action="/duplicate-training/test-3" method="get" data-comment-form>
        <div class="nhsuk-form-group">
          <label class="nhsuk-label nhsuk-label--m" for="comment" data-comment-question>Tell us why</label>
          <div class="nhsuk-hint" id="comment-hint">Optional. This is for the Mavis team and does not change the child’s vaccination history.</div>
          <textarea class="nhsuk-textarea" id="comment" name="comment" rows="5" aria-describedby="comment-hint"></textarea>
        </div>
        <div class="nhsuk-button-group">
          <button class="nhsuk-button" data-module="nhsuk-button" type="submit">Submit</button>
          <a class="nhsuk-link" href="/duplicate-training/test-2" data-comment-cancel>Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Record this set as moved past, for the Duplicate records tab count; a set is
    // only ever recorded once, so revisiting and advancing again changes nothing
    const markProgressed = () => {
      let progressed = []
      try { progressed = JSON.parse(sessionStorage.getItem("duplicate-training:progressed") || "[]") } catch (error) {}
      if (!progressed.includes("test-2")) progressed.push("test-2")
      try { sessionStorage.setItem("duplicate-training:progressed", JSON.stringify(progressed)) } catch (error) {}
    }

    let decision = "unknown"
    try { decision = sessionStorage.getItem("duplicate-training:decision:test-2") || "unknown" } catch (error) {}
    const question = document.querySelector("[data-comment-question]")
    if (decision === "skip") question.textContent = "Why did you skip this set?"
    else if (decision.startsWith("record")) question.textContent = "Why did you choose this record?"

    document.querySelector("[data-comment-form]").addEventListener("submit", (event) => {
      event.preventDefault()
      const comment = document.getElementById("comment").value
      const entry = { decision, comment }
      try { sessionStorage.setItem("duplicate-training:comment:test-2", JSON.stringify(entry)) } catch (error) {}
      console.log("[duplicate-training] test-2:", JSON.stringify(entry))
      markProgressed()
      window.location.assign(event.target.action)
    })

    document.querySelector("[data-comment-cancel]").addEventListener("click", (event) => {
      if (window.history.length > 1) {
        event.preventDefault()
        window.history.back()
      }
    })
  </script>
{% endblock %}
