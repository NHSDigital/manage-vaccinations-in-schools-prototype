{% extends "_layouts/default.njk" %}

{% set pageName = "Exploration - preferred record chosen, card view" %}
{% set containerClasses = "nhsuk-width-container-fluid" %}
{% block header %}
  <!-- Mavis site chrome: environment banner and site header exactly as rendered
       on a child record, with the Children item current. Static copy for
       presentation only; these demo pages do not live under /patients. -->
  <div class="app-environment nhsuk-tag--grey">
    <div class="nhsuk-width-container">
      <strong class="nhsuk-tag nhsuk-tag--grey">Prototype</strong>
      This is a prototype used for research.
    </div>
  </div>
  <header class="nhsuk-header" data-module="nhsuk-header" role="banner">
    <div class="nhsuk-header__container nhsuk-width-container">
      <div class="nhsuk-header__service">
        <a class="nhsuk-header__service-logo" href="/home" aria-label="NHS Manage vaccinations in schools homepage">
          <svg class="nhsuk-header__logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 80" height="40" width="100" focusable="false" role="img" aria-label="NHS">
            <title>NHS</title>
            <path fill="currentcolor" d="M200 0v80H0V0h200Zm-27.5 5.5c-14.5 0-29 5-29 22 0 10.2 7.7 13.5 14.7 16.3l.7.3c5.4 2 10.1 3.9 10.1 8.4 0 6.5-8.5 7.5-14 7.5s-12.5-1.5-16-3.5L135 70c5.5 2 13.5 3.5 20 3.5 15.5 0 32-4.5 32-22.5 0-19.5-25.5-16.5-25.5-25.5 0-5.5 5.5-6.5 12.5-6.5a35 35 0 0 1 14.5 3l4-13.5c-4.5-2-12-3-20-3Zm-131 2h-22l-14 65H22l9-45h.5l13.5 45h21.5l14-65H64l-9 45h-.5l-13-45Zm63 0h-18l-13 65h17l6-28H117l-5.5 28H129l13.5-65H125L119.5 32h-20l5-24.5Z"/>
          </svg>
          <span class="nhsuk-header__service-name">Manage vaccinations in schools</span>
        </a>
      </div>
      <nav class="nhsuk-header__account" aria-label="Account">
        <ul class="nhsuk-header__account-list">
          <li class="nhsuk-header__account-item">
            <svg class="nhsuk-icon nhsuk-icon--user" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true">
              <path d="M12 1a11 11 0 1 1 0 22 11 11 0 0 1 0-22Zm0 2a9 9 0 0 0-5 16.5V18a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v1.5A9 9 0 0 0 12 3Zm0 3a3.5 3.5 0 1 1-3.5 3.5A3.4 3.4 0 0 1 12 6Z"/>
            </svg>
            JOY, Jane (Nurse)
          </li>
          <li class="nhsuk-header__account-item">
            <a class="nhsuk-header__account-link" href="/account/change-role">Change role</a>
          </li>
          <li class="nhsuk-header__account-item">
            <a class="nhsuk-header__account-link" href="/account/sign-out">Log out</a>
          </li>
        </ul>
      </nav>
    </div>
    <nav class="nhsuk-header__navigation" aria-label="Menu">
      <div class="nhsuk-header__navigation-container nhsuk-width-container">
        <ul class="nhsuk-header__navigation-list">
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/schools">Schools</a>
          </li>
          <li class="nhsuk-header__navigation-item nhsuk-header__navigation-item--current">
            <a class="nhsuk-header__navigation-link" href="/patients" aria-current="true"><strong class="nhsuk-header__navigation-item-current-fallback">Children</strong></a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/sessions">Sessions</a>
          </li>
          <li class="nhsuk-header__navigation-item app-header__navigation-item--with-badge">
            <a class="nhsuk-header__navigation-link" href="/reviews">Review<strong class="app-badge">124</strong></a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/reports">Reports</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/uploads">Uploads</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/downloads">Downloads</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/vaccines">Vaccines</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/teams/001">Your team</a>
          </li>
          <li class="nhsuk-header__menu" hidden>
            <button class="nhsuk-header__menu-toggle nhsuk-header__navigation-link" id="toggle-menu" aria-expanded="false">
              <span class="nhsuk-u-visually-hidden">Browse </span>More
            </button>
          </li>
        </ul>
      </div>
    </nav>
  </header>
{% endblock %}

{% block content %}
  <!-- DESIGN EXPLORATION, not part of the user testing flow or the demo scenarios.
       Lives at /duplicate-training/gareth-preferred-cards alongside the other Gareth
       pages and the first exploration (gareth-main-record). Linked from the scenario
       index under From a child record and from the 3 duplicates links on
       gareth-record; nothing in the testing flow links here and nothing here links
       back into it.

       The same end state as the first exploration (Gareth Greene's MMR set with
       record 1 chosen), but shown on duplicate-training's own comparison grid in a
       read-only state: the label column, the three record cards, every field row
       exactly as on gareth-duplicates but with no difference highlighting, and with the radios,
       Choose this record footers, sticky bar, highlight toggle and all scripts
       removed. Record 1 carries the blue Preferred record tag and border that
       the live page applies on selection; the others keep the grey Duplicate record
       tag. Below the grid: a placeholder Change preferred record button (conceptually
       it would open the live choosing view) and the same activity log entry as the
       first exploration. -->
  <!-- Breadcrumb: Home > Children > child > programme, as on the vaccination
       duplicates view of the vaccination-record-valid-ignored-doses branch -->
  <div class="nhsuk-width-container" style="margin: 0 auto">
    <nav class="nhsuk-breadcrumb" aria-label="Breadcrumb">
      <ol class="nhsuk-breadcrumb__list">
        <li class="nhsuk-breadcrumb__list-item"><a class="nhsuk-breadcrumb__link" href="/home">Home</a></li>
        <li class="nhsuk-breadcrumb__list-item"><a class="nhsuk-breadcrumb__link" href="/patients">Children</a></li>
        <li class="nhsuk-breadcrumb__list-item"><a class="nhsuk-breadcrumb__link" href="/duplicate-training/gareth-record">Gareth Greene</a></li>
        <li class="nhsuk-breadcrumb__list-item"><a class="nhsuk-breadcrumb__link" href="/duplicate-training/gareth-record">MMR</a></li>
      </ol>
    </nav>
  </div>
  <!-- Entry from a child record: no Review heading, section navigation or
       queue framing here. The nurse arrived via the +2 duplicates link on
       Gareth Greene's MMR vaccination record, so the page keeps the child
       record's breadcrumb and title conventions instead. -->
  <!-- Standard-width band: the patient tier of the page header stays the
       standard page width (1100px here), matching the site header. The duplicate details panel and record grid below share the wider
       card canvas. margin: 0 auto stops the nested width container doubling the
       fluid containers side margins at narrower viewports. -->
  <div class="nhsuk-width-container" style="margin: 0 auto">

    <div class="nhsuk-grid-row">
      <div class="nhsuk-grid-column-full">

        <!-- Child record header: the same name, date of birth caption and
             section navigation as on Gareth's record page (patient/_navigation.njk
             on the vaccination-record-valid-ignored-doses branch), with MMR
             current, in place of the queue-mode patient tier -->
        <h1 class="nhsuk-heading-l nhsuk-u-margin-bottom-2">Gareth Greene</h1>
        <p class="nhsuk-caption-l nhsuk-u-margin-bottom-4">
          <strong>Date of birth:</strong> 12 May 2011 (aged 15)
        </p>

        <nav class="app-section-navigation" data-module="app-section-navigation" aria-label="Section navigation">
          <ul class="app-section-navigation__list">
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="#">Child record</a>
            </li>
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="#">Contacts</a>
            </li>
            <li class="app-section-navigation__item app-section-navigation__item--current">
              <a class="app-section-navigation__link" href="/duplicate-training/gareth-record" aria-current="page"><strong class="app-section-navigation__current">MMR</strong></a>
            </li>
          </ul>
        </nav>
        <!-- /Child record header -->

      </div>
    </div>
  </div>

  <!-- Card canvas: duplicate details panel and record comparison grid, centred and
       capped at 1720px, the only part of the page wider than the standard width. The NHS design system has no wide-container token
       (standard page width is 1100px in this prototype), so the cap is set
       directly. Below 1280px viewports each grid stops compressing (min-width
       1216px = 1280px minus the 2 x 32px page margins) and the page gains a
       horizontal scrollbar instead: there is no overflow-x wrapper, because an
       overflow container would become the sticky scrollport and stop the
       Choose this record blocks sticking to the viewport. -->
  <div style="max-width: 1720px; margin: 0 auto;">
    <!-- Duplicate summary: reuses the Mavis listing-page sidebar treatment
         (app-filters card: translucent grey-4 background, card
         border, no feature heading tab) -->
    <div class="nhsuk-card app-filters nhsuk-u-margin-bottom-0 nhsuk-u-padding-left-0 nhsuk-u-padding-right-0 nhsuk-u-padding-bottom-0">
      <div class="nhsuk-card__content">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; column-gap: 24px;">
          <div>
            <h2 class="nhsuk-heading-m nhsuk-u-margin-bottom-2">3 duplicate MMR records</h2>
            <p class="nhsuk-body nhsuk-u-secondary-text-colour nhsuk-u-margin-bottom-0">A preferred record has been chosen for this vaccination, dated 26 May 2012.</p>
            <!-- Set identity as a summary list - the component Mavis uses on the
                 vaccination record itself - so this echoes the record rather than
                 the table row. Only values every record in the set shares (that is
                 what makes them duplicates); dose number, age and source can
                 differ, so they stay in the grid. Date is plain text: no main
                 record yet to link to. -->
          </div>

        </div>
      </div>
    </div>

    <!-- Duplicate record grid -->
    <div class="nhsuk-u-padding-5" style="background: #f0f4f5; box-shadow: inset 0 1px 7px rgba(0,0,0,0.1); border: 1px solid #d8dde0; border-top: 0;">
    <!-- Records 1 to 3: one shared grid; each field is a grid row spanning the label column and all cards -->
    <div data-record-grid style="display: grid; grid-template-columns: 10rem repeat(4, 1fr); grid-template-rows: repeat(21, auto); column-gap: 24px; min-width: 1216px;">
        <!-- Card boundaries: one bordered underlay per record column; record 1 carries the chosen-record border -->
        <div data-record-box="record-1" style="grid-column: 2; grid-row: 1 / 22; border: 2px solid #005eb8; background: #ffffff;"></div>
        <div data-record-box="record-2" style="grid-column: 3; grid-row: 1 / 22; border: 1px solid #d8dde0; background: #ffffff;"></div>
        <div data-record-box="record-3" style="grid-column: 4; grid-row: 1 / 22; border: 1px solid #d8dde0; background: #ffffff;"></div>

        <!-- Headings -->
        <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 2; grid-row: 1;">Record 1</h2>
        <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 3; grid-row: 1;">Record 2</h2>
        <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 4; grid-row: 1;">Record 3</h2>

        <!-- Selection tags: record 1 shown as the chosen record, the others as duplicates; static -->
        <div data-record-tag="record-1" class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 2; grid-row: 2;">
          <strong class="nhsuk-tag nhsuk-tag--blue nhsuk-u-margin-bottom-2">Preferred record</strong>
        </div>
        <div data-record-tag="record-2" class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 3; grid-row: 2;">
          <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2">Duplicate record</strong>
        </div>
        <div data-record-tag="record-3" class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 4; grid-row: 2;">
          <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2">Duplicate record</strong>
        </div>

        <!-- Date row. As on the Mavis record view, date and time are separate rows;
             the Time row shows Unknown when the source record carries no time -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 3; border-bottom: 1px solid #d8dde0;">Date</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 3; border-bottom: 1px solid #d8dde0;">26 May 2012</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 3; border-bottom: 1px solid #d8dde0;">26 May 2012</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 3; border-bottom: 1px solid #d8dde0;">26 May 2012</p>

        <!-- Time row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 4; border-bottom: 1px solid #d8dde0;">Time</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 4; border-bottom: 1px solid #d8dde0;">12:00 am</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 4; border-bottom: 1px solid #d8dde0;">12:00 am</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 4; border-bottom: 1px solid #d8dde0;">12:00 am</p>

        <!-- Vaccine row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 5; border-bottom: 1px solid #d8dde0;">Vaccine</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 5; border-bottom: 1px solid #d8dde0;">Priorix</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 5; border-bottom: 1px solid #d8dde0;">Priorix</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 5; border-bottom: 1px solid #d8dde0;">Priorix</p>

        <!-- Source row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 6; border-bottom: 1px solid #d8dde0;">Source</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 6; border-bottom: 1px solid #d8dde0;">External source such as GP or SAIS outside Mavis</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 6; border-bottom: 1px solid #d8dde0;">External source such as GP or SAIS outside Mavis</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 6; border-bottom: 1px solid #d8dde0;">External source such as GP or SAIS outside Mavis</p>

        <!-- Location row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 7; border-bottom: 1px solid #d8dde0;">Location</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 7; border-bottom: 1px solid #d8dde0;">M84008 (Woodside Medical Practice)</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 7; border-bottom: 1px solid #d8dde0;">Unknown</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 7; border-bottom: 1px solid #d8dde0;">M84008 (Woodside Medical Practice)</p>

        <!-- Vaccinated by row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 8; border-bottom: 1px solid #d8dde0;">Vaccinated by</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 8; border-bottom: 1px solid #d8dde0;">Unknown</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 8; border-bottom: 1px solid #d8dde0;">Unknown</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 8; border-bottom: 1px solid #d8dde0;">Unknown</p>

        <!-- Batch number row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 10; border-bottom: 1px solid #d8dde0;">Batch number</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 10; border-bottom: 1px solid #d8dde0;"><span class="nhsuk-u-font-code">EF9012</span><br><span class="nhsuk-u-secondary-text-colour">Expires 30 September 2027</span></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 10; border-bottom: 1px solid #d8dde0;"><span class="nhsuk-u-font-code">EF9012</span><br><span class="nhsuk-u-secondary-text-colour">Expires 30 September 2027</span></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 10; border-bottom: 1px solid #d8dde0;">Not provided</p>

        <!-- Dose sequence row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 9; border-bottom: 1px solid #d8dde0;">Dose sequence</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 9; border-bottom: 1px solid #d8dde0;">1st</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 9; border-bottom: 1px solid #d8dde0;">Unknown</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 9; border-bottom: 1px solid #d8dde0;">Unknown</p>

        <!-- Reported by row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 11; border-bottom: 1px solid #d8dde0;">Reported by</p>
