{% block content %}
  <!-- Static copy of the vaccination record view (vaccination/show.njk structure:
       heading, then a card holding the summary list) for Record 2 of the 3-records
       duplicate set. Every row and value is exactly what that record's comparison
       card shows, in the same order, with nothing added: this page exists to show a
       participant that there is nothing more behind View this record. Generated from
       3-records.njk by a script; regenerate rather than edit by hand. -->
  <div class="nhsuk-u-width-three-quarters">
    <span class="nhsuk-caption-l">Record 2 of 3</span>
    <h1 class="nhsuk-heading-l">Grace Adeyemi</h1>

    <div class="nhsuk-card">
      <div class="nhsuk-card__content">
        <h2 class="nhsuk-card__heading nhsuk-heading-m">Vaccination record</h2>
        <dl class="nhsuk-summary-list">
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Date</dt>
            <dd class="nhsuk-summary-list__value">14 May 2026</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Time</dt>
            <dd class="nhsuk-summary-list__value">12:00 am</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Vaccine</dt>
            <dd class="nhsuk-summary-list__value">Priorix</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Source</dt>
            <dd class="nhsuk-summary-list__value">External source such as GP or SAIS outside Mavis</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Location</dt>
            <dd class="nhsuk-summary-list__value">Unknown</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Vaccinated by</dt>
            <dd class="nhsuk-summary-list__value">Unknown</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Dose sequence</dt>
            <dd class="nhsuk-summary-list__value">Unknown</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Batch number</dt>
            <dd class="nhsuk-summary-list__value"><span class="nhsuk-u-font-code">EF9012</span><br><span class="nhsuk-u-secondary-text-colour">Expires 30 September 2027</span></dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Reported by</dt>
            <dd class="nhsuk-summary-list__value">&nbsp;</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Reported on</dt>
            <dd class="nhsuk-summary-list__value">16 May 2026 at 2:48 pm</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Child identified by</dt>
            <dd class="nhsuk-summary-list__value">&nbsp;</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">SNOMED procedure</dt>
            <dd class="nhsuk-summary-list__value">33879002 – Administration of vaccine to produce active immunity</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Notes</dt>
            <dd class="nhsuk-summary-list__value">&nbsp;</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Method</dt>
            <dd class="nhsuk-summary-list__value">Intramuscular (IM) injection</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Site</dt>
            <dd class="nhsuk-summary-list__value">Not provided</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Dose volume</dt>
            <dd class="nhsuk-summary-list__value">&nbsp;</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Supplier</dt>
            <dd class="nhsuk-summary-list__value">&nbsp;</dd>
          </div>
          <div class="nhsuk-summary-list__row">
            <dt class="nhsuk-summary-list__key">Protocol</dt>
            <dd class="nhsuk-summary-list__value">&nbsp;</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
{% endblock %}
