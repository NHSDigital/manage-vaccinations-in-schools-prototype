{% extends "_layouts/default.njk" %}

{% set pageName = "Review duplicate vaccination records (2 records)" %}
{% set containerClasses = "nhsuk-width-container-fluid" %}
{% block header %}
  <!-- Mavis site chrome: environment banner and site header exactly as rendered
       on /notices, with the Review item current. Static copy for presentation
       only; these demo pages do not actually live under /notices yet. -->
  <div class="app-environment nhsuk-tag--grey">
    <div class="nhsuk-width-container">
      <strong class="nhsuk-tag nhsuk-tag--grey">Prototype</strong>
      This is a prototype used for research.
    </div>
  </div>
  <header class="nhsuk-header" data-module="nhsuk-header" role="banner">
    <div class="nhsuk-header__container nhsuk-width-container">
      <div class="nhsuk-header__service">
        <a class="nhsuk-header__service-logo" href="/home" aria-label="NHS Manage vaccinations in schools homepage">
          <svg class="nhsuk-header__logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 80" height="40" width="100" focusable="false" role="img" aria-label="NHS">
            <title>NHS</title>
            <path fill="currentcolor" d="M200 0v80H0V0h200Zm-27.5 5.5c-14.5 0-29 5-29 22 0 10.2 7.7 13.5 14.7 16.3l.7.3c5.4 2 10.1 3.9 10.1 8.4 0 6.5-8.5 7.5-14 7.5s-12.5-1.5-16-3.5L135 70c5.5 2 13.5 3.5 20 3.5 15.5 0 32-4.5 32-22.5 0-19.5-25.5-16.5-25.5-25.5 0-5.5 5.5-6.5 12.5-6.5a35 35 0 0 1 14.5 3l4-13.5c-4.5-2-12-3-20-3Zm-131 2h-22l-14 65H22l9-45h.5l13.5 45h21.5l14-65H64l-9 45h-.5l-13-45Zm63 0h-18l-13 65h17l6-28H117l-5.5 28H129l13.5-65H125L119.5 32h-20l5-24.5Z"/>
          </svg>
          <span class="nhsuk-header__service-name">Manage vaccinations in schools</span>
        </a>
      </div>
      <nav class="nhsuk-header__account" aria-label="Account">
        <ul class="nhsuk-header__account-list">
          <li class="nhsuk-header__account-item">
            <svg class="nhsuk-icon nhsuk-icon--user" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true">
              <path d="M12 1a11 11 0 1 1 0 22 11 11 0 0 1 0-22Zm0 2a9 9 0 0 0-5 16.5V18a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v1.5A9 9 0 0 0 12 3Zm0 3a3.5 3.5 0 1 1-3.5 3.5A3.4 3.4 0 0 1 12 6Z"/>
            </svg>
            JOY, Jane (Nurse)
          </li>
          <li class="nhsuk-header__account-item">
            <a class="nhsuk-header__account-link" href="/account/change-role">Change role</a>
          </li>
          <li class="nhsuk-header__account-item">
            <a class="nhsuk-header__account-link" href="/account/sign-out">Log out</a>
          </li>
        </ul>
      </nav>
    </div>
    <nav class="nhsuk-header__navigation" aria-label="Menu">
      <div class="nhsuk-header__navigation-container nhsuk-width-container">
        <ul class="nhsuk-header__navigation-list">
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/schools">Schools</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/patients">Children</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/sessions">Sessions</a>
          </li>
          <li class="nhsuk-header__navigation-item nhsuk-header__navigation-item--current app-header__navigation-item--with-badge">
            <a class="nhsuk-header__navigation-link" href="/reviews" aria-current="true"><strong class="nhsuk-header__navigation-item-current-fallback">Review<strong class="app-badge">124</strong></strong></a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/reports">Reports</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/uploads">Uploads</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/downloads">Downloads</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/vaccines">Vaccines</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/teams/001">Your team</a>
          </li>
          <li class="nhsuk-header__menu" hidden>
            <button class="nhsuk-header__menu-toggle nhsuk-header__navigation-link" id="toggle-menu" aria-expanded="false">
              <span class="nhsuk-u-visually-hidden">Browse </span>More
            </button>
          </li>
        </ul>
      </div>
    </nav>
  </header>
{% endblock %}

{% block content %}
  <!-- Standard-width band: the Review chrome and the patient tier of the page
       header stay the standard page width (1100px here), matching the site
       header. The duplicate details panel and record grid below share the wider
       card canvas. margin: 0 auto stops the nested width container doubling the
       fluid containers side margins at narrower viewports. -->
  <div class="nhsuk-width-container" style="margin: 0 auto">
    <!-- Review section chrome: page heading and section navigation as on /notices,
         plus a Duplicates tab shown as current. Presentation only: the tab href is
         a placeholder and these pages do not actually live under /notices yet. -->
    <div class="nhsuk-grid-row">
      <div class="nhsuk-grid-column-full">
        <h1 class="nhsuk-heading-l">Review</h1>
        <nav class="app-section-navigation" data-module="app-section-navigation" aria-label="Section navigation">
          <ul class="app-section-navigation__list">
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="/notices">Important notices<span class="app-section-navigation__suffix"><strong class="app-badge">4</strong></span></a>
            </li>
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="/consents">Consent responses<span class="app-section-navigation__suffix"><strong class="app-badge">0</strong></span></a>
            </li>
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="/unmatched-appointments">Clinic appointments<span class="app-section-navigation__suffix"><strong class="app-badge">23</strong></span></a>
            </li>
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="/moves">School moves<span class="app-section-navigation__suffix"><strong class="app-badge">90</strong></span></a>
            </li>
            <li class="app-section-navigation__item app-section-navigation__item--current">
              <a class="app-section-navigation__link" href="#" aria-current="page"><strong class="app-section-navigation__current">Duplicate records<span class="app-section-navigation__suffix"><strong class="app-badge">7</strong></span></strong></a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
    <!-- /Review section chrome -->

    <div class="nhsuk-grid-row">
      <div class="nhsuk-grid-column-full">

        <!-- Duplicate page header -->

        <!-- Patient name -->
        <h1 class="nhsuk-heading-l nhsuk-u-display-inline-block nhsuk-u-margin-bottom-3">
          Oliver Mistry
        </h1>
        <a class="nhsuk-link nhsuk-u-margin-left-3" href="#">View full child record</a>

        <!-- Patient details -->
        <div class="nhsuk-grid-row nhsuk-u-margin-bottom-4">
          <div class="nhsuk-grid-column-one-third">
            <p class="nhsuk-body nhsuk-u-margin-bottom-0">
              <span class="nhsuk-u-font-weight-bold">NHS Number</span><br>
              999 222 3344
            </p>
          </div>
          <div class="nhsuk-grid-column-one-third">
            <p class="nhsuk-body nhsuk-u-margin-bottom-0">
              <span class="nhsuk-u-font-weight-bold">Date of birth</span><br>
              14 March 2012
            </p>
          </div>
          <div class="nhsuk-grid-column-one-third">
            <p class="nhsuk-body nhsuk-u-margin-bottom-0">
              <span class="nhsuk-u-font-weight-bold">Address</span><br>
              12 Larkspur Road, Millbrook, ME4 5TT
            </p>
          </div>
        </div>

        <!-- /Duplicate page header -->

      </div>
    </div>
  </div>

  <!-- Card canvas: duplicate details panel and record comparison grid, centred and
       capped at 1720px. The NHS design system has no wide-container token
       (standard page width is 1100px in this prototype), so the cap is set
       directly. Below 1280px viewports each grid stops compressing (min-width
       1216px = 1280px minus the 2 x 32px page margins) and gains a horizontal
       scrollbar instead. -->
  <div style="max-width: 1720px; margin: 0 auto;">
    <!-- Duplicate summary: reuses the Mavis listing-page sidebar treatment
         (app-filters card: translucent grey-4 background, card
         border, no feature heading tab) -->
    <div class="nhsuk-card app-filters nhsuk-u-margin-bottom-0 nhsuk-u-padding-left-0 nhsuk-u-padding-right-0 nhsuk-u-padding-bottom-0">
      <div class="nhsuk-card__content">
        <h2 class="nhsuk-heading-m nhsuk-u-margin-bottom-2">2 duplicate records</h2>
        <p class="nhsuk-body nhsuk-u-margin-bottom-2">We have 2 records about the same vaccination.</p>
        <p class="nhsuk-body nhsuk-u-margin-bottom-0">
          <span class="nhsuk-u-font-weight-bold">Date:</span> 12 August 2026
          <span class="nhsuk-u-font-weight-bold nhsuk-u-margin-left-4">Programme:</span> MMR
          <span class="nhsuk-u-font-weight-bold nhsuk-u-margin-left-4">Outcome:</span> Vaccinated
        </p>
      </div>
    </div>

    <!-- Duplicate record grid -->
    <!-- Record plane: a padded recess hanging off the summary card's bottom
         edge. The fill stays page grey-5; the depth comes from a grey-4 border
         (no top edge - the card supplies it) and a soft inset shadow. Note the
         inset shadow is outside the NHS service manual vocabulary - a prototype
         choice to be argued for or dropped after testing -->
    <div class="nhsuk-u-padding-5" style="background: #f0f4f5; box-shadow: inset 0 1px 7px rgba(0,0,0,0.1); border: 1px solid #d8dde0; border-top: 0;">
    <!-- Records 1 to 2: one shared grid; each field is a grid row spanning the label column and all cards -->
    <div style="overflow-x: auto;">
      <div style="display: grid; grid-template-columns: 10rem repeat(4, 1fr); column-gap: 24px; min-width: 1216px;">
        <!-- Card boundaries: one bordered underlay per record column (border swapped by the selection script) -->
        <div data-record-box="record-1" style="grid-column: 2; grid-row: 1 / 21; border: 1px solid #d8dde0; background: #ffffff;"></div>
        <div data-record-box="record-2" style="grid-column: 3; grid-row: 1 / 21; border: 1px solid #d8dde0; background: #ffffff;"></div>

        <!-- Headings -->
        <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5" style="grid-column: 1; grid-row: 1;">Top rows</h2>
        <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 2; grid-row: 1;">Record 1</h2>
        <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 3; grid-row: 1;">Record 2</h2>

        <!-- Selection tags: grey by default; the script swaps the chosen one to blue in place -->
        <div data-record-tag="record-1" class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 2; grid-row: 2;">
          <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2">Duplicate record</strong>
        </div>
        <div data-record-tag="record-2" class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 3; grid-row: 2;">
          <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2">Duplicate record</strong>
        </div>

        <!-- Vaccine row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 3; border-bottom: 1px solid #d8dde0;">Vaccine</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 3; border-bottom: 1px solid #d8dde0;">Priorix</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 3; border-bottom: 1px solid #d8dde0;">Priorix</p>

        <!-- Source row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 4; border-bottom: 1px solid #d8dde0;">Source</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 4; border-bottom: 1px solid #d8dde0;">External source such as GP practice</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 4; border-bottom: 1px solid #d8dde0;">External source such as GP practice</p>

        <!-- Location row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 5; border-bottom: 1px solid #d8dde0;">Location</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 5; border-bottom: 1px solid #d8dde0;">Unknown</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 5; border-bottom: 1px solid #d8dde0;">Unknown</p>

        <!-- Date row: API records carry date-only precision (occurrenceDateTime), so no times -->

        <!-- Time row: Mavis-recorded vaccinations carry a real time; external
             sources (GP APIs, historical uploads) send date-only precision, which
             surfaces as 00:00 - a provenance clue -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 6; border-bottom: 1px solid #d8dde0;">Time</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 6; border-bottom: 1px solid #d8dde0;">00:00</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 6; border-bottom: 1px solid #d8dde0;">00:00</p>

        <!-- Vaccinator row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 7; border-bottom: 1px solid #d8dde0;">Vaccinator</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 7; border-bottom: 1px solid #d8dde0;">&nbsp;</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 7; border-bottom: 1px solid #d8dde0;">&nbsp;</p>

        <!-- Batch row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" data-border-when-expanded style="grid-column: 1; grid-row: 8;">Batch</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" data-border-when-expanded style="grid-column: 2; grid-row: 8;"><span class="nhsuk-u-font-code">CD5678</span><br><span class="nhsuk-u-secondary-text-colour">Expires 14 April 2027</span></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" data-border-when-expanded style="grid-column: 3; grid-row: 8;"><span class="nhsuk-u-font-code">CD5678</span><br><span class="nhsuk-u-secondary-text-colour">Expires 14 April 2027</span></p>

        <!-- Dose number row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 9; border-bottom: 1px solid #d8dde0;">Dose number</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 9; border-bottom: 1px solid #d8dde0;">1</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 3; grid-row: 9; border-bottom: 1px solid #d8dde0;">&nbsp;</p>

        <!-- Reported by row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 10; border-bottom: 1px solid #d8dde0;">Reported by</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 10; border-bottom: 1px solid #d8dde0;">&nbsp;</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 3; grid-row: 10; border-bottom: 1px solid #d8dde0;">&nbsp;</p>

        <!-- Reported on row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 11; border-bottom: 1px solid #d8dde0;">Reported on</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 11; border-bottom: 1px solid #d8dde0;">13 August 2026</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 3; grid-row: 11; border-bottom: 1px solid #d8dde0;">14 August 2026</p>

        <!-- Child identified by row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 12; border-bottom: 1px solid #d8dde0;">Child identified by</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 12; border-bottom: 1px solid #d8dde0;">&nbsp;</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 3; grid-row: 12; border-bottom: 1px solid #d8dde0;">&nbsp;</p>

        <!-- SNOMED procedure row: code joined with its term. GP-sourced records deliberately disagree (dose-specific, generic MMR, catch-all administration code, even a product code) to simulate GP shotgun coding; uploads mostly carry none -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 13; border-bottom: 1px solid #d8dde0;">SNOMED procedure</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 13; border-bottom: 1px solid #d8dde0;">170433008 (Measles mumps and rubella vaccination - first dose)</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 3; grid-row: 13; border-bottom: 1px solid #d8dde0;">33879002 (Administration of vaccine to produce active immunity)</p>

