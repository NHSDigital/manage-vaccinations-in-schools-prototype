          <div class="nhsuk-radios nhsuk-radios--small" data-module="nhsuk-radios">
            <div class="nhsuk-radios__item">
              <input class="nhsuk-radios__input" id="record-2" name="preferred-record" type="radio" value="record-2">
              <label class="nhsuk-label nhsuk-radios__label nhsuk-u-font-size-16" for="record-2">
                Choose this record
              </label>
            </div>
          </div>
          <div data-roll-panel aria-hidden="true" style="position: absolute; top: calc(100% + 1px); left: -2px; right: -2px; height: 96px; background: #f0f4f5; pointer-events: none;"></div>
        </div>
        <div class="nhsuk-form-group nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" data-record-footer="record-3" style="grid-column: 4; grid-row: 3 / 22; align-self: end; position: sticky; bottom: 96px; z-index: 10; background: #ffffff; border: 1px solid #d8dde0; border-top: 0;">
          <div class="nhsuk-radios nhsuk-radios--small" data-module="nhsuk-radios">
            <div class="nhsuk-radios__item">
              <input class="nhsuk-radios__input" id="record-3" name="preferred-record" type="radio" value="record-3">
              <label class="nhsuk-label nhsuk-radios__label nhsuk-u-font-size-16" for="record-3">
                Choose this record
              </label>
            </div>
          </div>
          <div data-roll-panel aria-hidden="true" style="position: absolute; top: calc(100% + 1px); left: -2px; right: -2px; height: 96px; background: #f0f4f5; pointer-events: none;"></div>
        </div>
        <div class="nhsuk-form-group nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" data-record-footer="record-4" style="grid-column: 5; grid-row: 3 / 22; align-self: end; position: sticky; bottom: 96px; z-index: 10; background: #ffffff; border: 1px solid #d8dde0; border-top: 0;">
          <div class="nhsuk-radios nhsuk-radios--small" data-module="nhsuk-radios">
            <div class="nhsuk-radios__item">
              <input class="nhsuk-radios__input" id="record-4" name="preferred-record" type="radio" value="record-4">
              <label class="nhsuk-label nhsuk-radios__label nhsuk-u-font-size-16" for="record-4">
                Choose this record
              </label>
            </div>
          </div>
          <div data-roll-panel aria-hidden="true" style="position: absolute; top: calc(100% + 1px); left: -2px; right: -2px; height: 96px; background: #f0f4f5; pointer-events: none;"></div>
        </div>
