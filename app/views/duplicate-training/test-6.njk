{% extends "_layouts/default.njk" %}

{% set pageName = "Review duplicate vaccination records (user testing set 6)" %}
{% set containerClasses = "nhsuk-width-container-fluid" %}
{% block header %}
  <!-- Mavis site chrome: environment banner and site header exactly as rendered
       on /notices, with the Review item current. Static copy for presentation
       only; these demo pages do not actually live under /notices yet. -->
  <div class="app-environment nhsuk-tag--grey">
    <div class="nhsuk-width-container">
      <strong class="nhsuk-tag nhsuk-tag--grey">Prototype</strong>
      This is a prototype used for research.
    </div>
  </div>
  <header class="nhsuk-header" data-module="nhsuk-header" role="banner">
    <div class="nhsuk-header__container nhsuk-width-container">
      <div class="nhsuk-header__service">
        <a class="nhsuk-header__service-logo" href="/home" aria-label="NHS Manage vaccinations in schools homepage">
          <svg class="nhsuk-header__logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 80" height="40" width="100" focusable="false" role="img" aria-label="NHS">
            <title>NHS</title>
            <path fill="currentcolor" d="M200 0v80H0V0h200Zm-27.5 5.5c-14.5 0-29 5-29 22 0 10.2 7.7 13.5 14.7 16.3l.7.3c5.4 2 10.1 3.9 10.1 8.4 0 6.5-8.5 7.5-14 7.5s-12.5-1.5-16-3.5L135 70c5.5 2 13.5 3.5 20 3.5 15.5 0 32-4.5 32-22.5 0-19.5-25.5-16.5-25.5-25.5 0-5.5 5.5-6.5 12.5-6.5a35 35 0 0 1 14.5 3l4-13.5c-4.5-2-12-3-20-3Zm-131 2h-22l-14 65H22l9-45h.5l13.5 45h21.5l14-65H64l-9 45h-.5l-13-45Zm63 0h-18l-13 65h17l6-28H117l-5.5 28H129l13.5-65H125L119.5 32h-20l5-24.5Z"/>
          </svg>
          <span class="nhsuk-header__service-name">Manage vaccinations in schools</span>
        </a>
      </div>
      <nav class="nhsuk-header__account" aria-label="Account">
        <ul class="nhsuk-header__account-list">
          <li class="nhsuk-header__account-item">
            <svg class="nhsuk-icon nhsuk-icon--user" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true">
              <path d="M12 1a11 11 0 1 1 0 22 11 11 0 0 1 0-22Zm0 2a9 9 0 0 0-5 16.5V18a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v1.5A9 9 0 0 0 12 3Zm0 3a3.5 3.5 0 1 1-3.5 3.5A3.4 3.4 0 0 1 12 6Z"/>
            </svg>
            JOY, Jane (Nurse)
          </li>
          <li class="nhsuk-header__account-item">
            <a class="nhsuk-header__account-link" href="/account/change-role">Change role</a>
          </li>
          <li class="nhsuk-header__account-item">
            <a class="nhsuk-header__account-link" href="/account/sign-out">Log out</a>
          </li>
        </ul>
      </nav>
    </div>
    <nav class="nhsuk-header__navigation" aria-label="Menu">
      <div class="nhsuk-header__navigation-container nhsuk-width-container">
        <ul class="nhsuk-header__navigation-list">
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/schools">Schools</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/patients">Children</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/sessions">Sessions</a>
          </li>
          <li class="nhsuk-header__navigation-item nhsuk-header__navigation-item--current app-header__navigation-item--with-badge">
            <a class="nhsuk-header__navigation-link" href="/reviews" aria-current="true"><strong class="nhsuk-header__navigation-item-current-fallback">Review<strong class="app-badge">124</strong></strong></a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/reports">Reports</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/uploads">Uploads</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/downloads">Downloads</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/vaccines">Vaccines</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/teams/001">Your team</a>
          </li>
          <li class="nhsuk-header__menu" hidden>
            <button class="nhsuk-header__menu-toggle nhsuk-header__navigation-link" id="toggle-menu" aria-expanded="false">
              <span class="nhsuk-u-visually-hidden">Browse </span>More
            </button>
          </li>
        </ul>
      </div>
    </nav>
  </header>
{% endblock %}

{% block content %}
  <!-- Standard-width band: the Review chrome and the patient tier of the page
       header stay the standard page width (1100px here), matching the site
       header. The duplicate details panel and record grid below share the wider
       card canvas. margin: 0 auto stops the nested width container doubling the
       fluid containers side margins at narrower viewports. -->
  <div class="nhsuk-width-container" style="margin: 0 auto">
    <!-- Review section chrome: page heading and section navigation as on /notices,
         plus a Duplicates tab shown as current. Presentation only: the tab href is
         a placeholder and these pages do not actually live under /notices yet. -->
    <div class="nhsuk-grid-row">
      <div class="nhsuk-grid-column-full">
        <h1 class="nhsuk-heading-l">Review</h1>
        <nav class="app-section-navigation" data-module="app-section-navigation" aria-label="Section navigation">
          <ul class="app-section-navigation__list">
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="/notices">Important notices<span class="app-section-navigation__suffix"><strong class="app-badge">4</strong></span></a>
            </li>
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="/consents">Consent responses<span class="app-section-navigation__suffix"><strong class="app-badge">0</strong></span></a>
            </li>
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="/unmatched-appointments">Clinic appointments<span class="app-section-navigation__suffix"><strong class="app-badge">23</strong></span></a>
            </li>
            <li class="app-section-navigation__item">
              <a class="app-section-navigation__link" href="/moves">School moves<span class="app-section-navigation__suffix"><strong class="app-badge">90</strong></span></a>
            </li>
            <li class="app-section-navigation__item app-section-navigation__item--current">
              <a class="app-section-navigation__link" href="#" aria-current="page"><strong class="app-section-navigation__current">Duplicate records<span class="app-section-navigation__suffix"><strong class="app-badge">7</strong></span></strong></a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
    <!-- /Review section chrome -->

    <div class="nhsuk-grid-row">
      <div class="nhsuk-grid-column-full">

        <!-- Duplicate page header -->

        <!-- Patient name -->
        <h1 class="nhsuk-heading-l nhsuk-u-display-inline-block nhsuk-u-margin-bottom-3">
          Amara Okonkwo
        </h1>
        <a class="nhsuk-link nhsuk-u-margin-left-3" href="#">View full child record</a>

        <!-- Patient details -->
        <div class="nhsuk-grid-row nhsuk-u-margin-bottom-4">
          <div class="nhsuk-grid-column-one-third">
            <p class="nhsuk-body nhsuk-u-margin-bottom-0">
              <span class="nhsuk-u-font-weight-bold">NHS Number</span><br>
              999 512 3406
            </p>
          </div>
          <div class="nhsuk-grid-column-one-third">
            <p class="nhsuk-body nhsuk-u-margin-bottom-0">
              <span class="nhsuk-u-font-weight-bold">Date of birth</span><br>
              30 November 2012 (aged 13)
            </p>
          </div>
          <div class="nhsuk-grid-column-one-third">
            <p class="nhsuk-body nhsuk-u-margin-bottom-0">
              <span class="nhsuk-u-font-weight-bold">Address</span><br>
              12 Milton Avenue, Manor Park, London, E12 6UX
            </p>
          </div>
        </div>

        <!-- /Duplicate page header -->

      </div>
    </div>
  </div>

  <!-- Card canvas: duplicate details panel and record comparison grid, centred and
       capped at 1720px. The NHS design system has no wide-container token
       (standard page width is 1100px in this prototype), so the cap is set
       directly. Below 1280px viewports each grid stops compressing (min-width
       1216px = 1280px minus the 2 x 32px page margins) and the page gains a
       horizontal scrollbar instead: there is no overflow-x wrapper, because an
       overflow container would become the sticky scrollport and stop the
       Choose this record blocks sticking to the viewport. -->
  <div style="max-width: 1720px; margin: 0 auto;">
    <!-- Duplicate summary: reuses the Mavis listing-page sidebar treatment
         (app-filters card: translucent grey-4 background, card
         border, no feature heading tab) -->
    <div class="nhsuk-card app-filters nhsuk-u-margin-bottom-0 nhsuk-u-padding-left-0 nhsuk-u-padding-right-0 nhsuk-u-padding-bottom-0">
      <div class="nhsuk-card__content">
        <!-- Highlight differences toggle: small checkbox, on by default, sits on
             the right of the panel. Unticking flips data-highlights-off on the
             grid wrapper; the style block below then neutralises every
             app-highlight mark without touching the markup -->
        <div style="display: flex; align-items: flex-start; justify-content: space-between; column-gap: 24px;">
          <div>
            <h2 class="nhsuk-heading-m nhsuk-u-margin-bottom-2">4 duplicate MMR records</h2>
            <p class="nhsuk-body nhsuk-u-secondary-text-colour nhsuk-u-margin-bottom-0">We have 4 records for the same vaccination dated 26 May 2016. Help us learn how to manage duplicates by choosing the record you trust most.</p>
          </div>
          <div class="nhsuk-form-group nhsuk-u-margin-bottom-0" style="flex-shrink: 0;">
            <div class="nhsuk-checkboxes nhsuk-checkboxes--small" data-module="nhsuk-checkboxes">
              <div class="nhsuk-checkboxes__item">
                <input class="nhsuk-checkboxes__input" id="highlight-differences" name="highlight-differences" type="checkbox" value="yes" checked data-highlight-toggle>
                <label class="nhsuk-label nhsuk-checkboxes__label nhsuk-u-font-size-16" for="highlight-differences">
                  Highlight differences
                </label>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <style>
      [data-highlights-off] .app-highlight {
        border-bottom-color: transparent;
        background-color: transparent;
      }
      [data-highlights-off] .app-highlight::before,
      [data-highlights-off] .app-highlight::after {
        content: none;
      }
    </style>

    <!-- Duplicate record grid -->
    <div class="nhsuk-u-padding-5" style="background: #f0f4f5; box-shadow: inset 0 1px 7px rgba(0,0,0,0.1); border: 1px solid #d8dde0; border-top: 0;">
    <!-- Records 1 to 4: one shared grid; each field is a grid row spanning the label column and all cards -->
    <div data-record-grid style="display: grid; grid-template-columns: 10rem repeat(4, 1fr); grid-template-rows: repeat(20, auto) 88px; column-gap: 24px; min-width: 1216px;">
        <!-- Card boundaries: one bordered underlay per record column (border swapped by the selection script) -->
        <div data-record-box="record-1" style="grid-column: 2; grid-row: 1 / 22; border: 1px solid #d8dde0; background: #ffffff;"></div>
        <div data-record-box="record-2" style="grid-column: 3; grid-row: 1 / 22; border: 1px solid #d8dde0; background: #ffffff;"></div>
        <div data-record-box="record-3" style="grid-column: 4; grid-row: 1 / 22; border: 1px solid #d8dde0; background: #ffffff;"></div>
        <div data-record-box="record-4" style="grid-column: 5; grid-row: 1 / 22; border: 1px solid #d8dde0; background: #ffffff;"></div>

        <!-- Headings -->
        <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 2; grid-row: 1;">Record 1</h2>
        <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 3; grid-row: 1;">Record 2</h2>
        <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 4; grid-row: 1;">Record 3</h2>
        <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 5; grid-row: 1;">Record 4</h2>

        <!-- Selection tags: grey by default; the script swaps the chosen one to blue in place -->
        <div data-record-tag="record-1" class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 2; grid-row: 2;">
          <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2">Duplicate record</strong>
        </div>
        <div data-record-tag="record-2" class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 3; grid-row: 2;">
          <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2">Duplicate record</strong>
        </div>
        <div data-record-tag="record-3" class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 4; grid-row: 2;">
          <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2">Duplicate record</strong>
        </div>
        <div data-record-tag="record-4" class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 5; grid-row: 2;">
          <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2">Duplicate record</strong>
        </div>

        <!-- Fit sentinel: 1px marker on the top line of the field rows. The
             observer below hides the sticky choose blocks whenever their pinned
             position would reach this line - i.e. while the viewport is so close
             to the card header that a pinned block would clamp against the top
             of its travel range and sit over the title, tag and first rows.
             They reappear, pinned at the viewport bottom, as soon as there is
             room below the header. -->
        <div data-fit-sentinel style="grid-column: 1; grid-row: 3; align-self: start; height: 1px;"></div>

        <!-- Vaccination date row: date and time combined as on the Mavis
             record view. External sources send date-only precision, which
             surfaces as a midnight timestamp (12:00 am) - a provenance clue;
             records with no time value at all show the date alone -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 3; border-bottom: 1px solid #d8dde0;">Vaccination date</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 3; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">26 May 2016</mark></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 3; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">26 May 2016 at 12:42 pm</mark></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 3; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">26 May 2016 at 12:42 pm</mark></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 5; grid-row: 3; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">26 May 2016 at 12:42 pm</mark></p>

        <!-- Product row: values verbatim from duplicate-sets/set data -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 4; border-bottom: 1px solid #d8dde0;">Product</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 4; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">Not provided</mark></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 4; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">Priorix</mark></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 4; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">Not provided</mark></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 5; grid-row: 4; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">Not provided</mark></p>

        <!-- Source row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 5; border-bottom: 1px solid #d8dde0;">Source</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 5; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">Uploaded as a historical vaccination</mark></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 5; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">External source such as GP or SAIS outside Mavis</mark></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 5; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">External source such as GP or SAIS outside Mavis</mark></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 5; grid-row: 5; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">External source such as GP or SAIS outside Mavis</mark></p>

        <!-- Location row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 6; border-bottom: 1px solid #d8dde0;">Location</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 6; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">Unknown</mark></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 6; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">Unknown</mark></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 6; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">Unknown</mark></p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 5; grid-row: 6; border-bottom: 1px solid #d8dde0;"><mark class="app-highlight">E12 HEALTH</mark></p>

        <!-- Vaccinated by row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 7; border-bottom: 1px solid #d8dde0;">Vaccinated by</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 7; border-bottom: 1px solid #d8dde0;">Unknown</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 3; grid-row: 7; border-bottom: 1px solid #d8dde0;">Unknown</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 4; grid-row: 7; border-bottom: 1px solid #d8dde0;">Unknown</p>
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 5; grid-row: 7; border-bottom: 1px solid #d8dde0;">Unknown</p>

        <!-- Dose sequence row -->
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 8; border-bottom: 1px solid #d8dde0;">Dose sequence</p>
