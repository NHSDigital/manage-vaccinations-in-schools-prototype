{% extends "_layouts/default.njk" %}

{% set pageName = "Duplicate record card" %}
{% set containerClasses = "nhsuk-width-container-fluid" %}
{% set headerOptions = {
  service: {
    text: serviceName
  }
} %}

{% block content %}
  <!-- Duplicate record card -->
  <!-- Records 2 to 2: one shared grid; each field is a grid row spanning the label column and all cards -->
  <div style="display: grid; grid-template-columns: 10rem repeat(4, 1fr); column-gap: 24px;">
    <!-- Card boundaries: one bordered underlay per record column (border swapped by the selection script) -->
    <div data-record-box="record-2" style="grid-column: 2; grid-row: 1 / 21; border: 1px solid #d8dde0; background: #ffffff;"></div>

    <!-- Headings -->
    <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5" style="grid-column: 1; grid-row: 1;">Top rows</h2>
    <h2 class="nhsuk-heading-s nhsuk-u-padding-top-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 2; grid-row: 1;">Record 2</h2>

    <!-- Selection tags: grey by default; the script swaps the chosen one to blue in place -->
    <div data-record-tag="record-2" class="nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 2; grid-row: 2;">
      <strong class="nhsuk-tag nhsuk-tag--grey nhsuk-u-margin-bottom-2">Duplicate record</strong>
    </div>

    <!-- Vaccine row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 3; border-bottom: 1px solid #d8dde0;">Vaccine</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 3; border-bottom: 1px solid #d8dde0;">Priorix</p>

    <!-- Source row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 4; border-bottom: 1px solid #d8dde0;">Source</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 4; border-bottom: 1px solid #d8dde0;">Recorded in Mavis</p>

    <!-- Location row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 5; border-bottom: 1px solid #d8dde0;">Location</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 5; border-bottom: 1px solid #d8dde0;">Oakfield Primary School</p>

    <!-- Time row: Mavis-recorded vaccinations carry a real time; external
         sources (GP APIs, historical uploads) send date-only precision, which
         surfaces as 00:00 - a provenance clue -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 6; border-bottom: 1px solid #d8dde0;">Time</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 6; border-bottom: 1px solid #d8dde0;">10:32am</p>

    <!-- Vaccinator row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" style="grid-column: 1; grid-row: 7; border-bottom: 1px solid #d8dde0;">Vaccinator</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" style="grid-column: 2; grid-row: 7; border-bottom: 1px solid #d8dde0;">Jane Smith</p>

    <!-- Batch row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold" data-border-when-expanded style="grid-column: 1; grid-row: 8;">Batch</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5" data-border-when-expanded style="grid-column: 2; grid-row: 8;"><span class="nhsuk-u-font-code">AB1234</span><br><span class="nhsuk-u-secondary-text-colour">Expires 1 March 2027</span></p>

    <!-- Dose number row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 9; border-bottom: 1px solid #d8dde0;">Dose number</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 9; border-bottom: 1px solid #d8dde0;">1</p>

    <!-- Reported by row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 10; border-bottom: 1px solid #d8dde0;">Reported by</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 10; border-bottom: 1px solid #d8dde0;">Tom Baker</p>

    <!-- Reported on row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 11; border-bottom: 1px solid #d8dde0;">Reported on</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 11; border-bottom: 1px solid #d8dde0;">12 August 2026</p>

    <!-- Child identified by row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 12; border-bottom: 1px solid #d8dde0;">Child identified by</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 12; border-bottom: 1px solid #d8dde0;">The child</p>

    <!-- SNOMED procedure row: code joined with its term. GP-sourced records deliberately disagree (dose-specific, generic MMR, catch-all administration code, even a product code) to simulate GP shotgun coding; uploads mostly carry none -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 13; border-bottom: 1px solid #d8dde0;">SNOMED procedure</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 13; border-bottom: 1px solid #d8dde0;">170433008 (Measles mumps and rubella vaccination - first dose)</p>

    <!-- Notes row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 14; border-bottom: 1px solid #d8dde0;">Notes</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 14; border-bottom: 1px solid #d8dde0;">&nbsp;</p>

    <!-- Method row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 15; border-bottom: 1px solid #d8dde0;">Method</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 15; border-bottom: 1px solid #d8dde0;">Intramuscular</p>

    <!-- Site row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 16; border-bottom: 1px solid #d8dde0;">Site</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 16; border-bottom: 1px solid #d8dde0;">Left upper arm</p>

    <!-- Dose volume row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 17; border-bottom: 1px solid #d8dde0;">Dose volume</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 17; border-bottom: 1px solid #d8dde0;">&nbsp;</p>

    <!-- Supplier row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 18; border-bottom: 1px solid #d8dde0;">Supplier</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 18; border-bottom: 1px solid #d8dde0;">&nbsp;</p>

    <!-- Protocol row -->
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-font-weight-bold nhsuk-u-display-none" data-all-fields style="grid-column: 1; grid-row: 19;">Protocol</p>
    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-2 nhsuk-u-margin-left-5 nhsuk-u-margin-right-5 nhsuk-u-display-none" data-all-fields style="grid-column: 2; grid-row: 19;">PGD</p>

    <!-- View all rows control: one per row, all synced to a single logical state by the script -->
    <details class="nhsuk-details nhsuk-u-font-size-16 nhsuk-u-margin-top-4" data-view-all-toggle style="grid-column: 1; grid-row: 20;">
      <summary class="nhsuk-details__summary">
        <span class="nhsuk-details__summary-text">View all rows</span>
      </summary>
    </details>
    <!-- Choose this record -->
    <div class="nhsuk-form-group nhsuk-u-margin-bottom-0 nhsuk-u-padding-top-2 nhsuk-u-padding-bottom-5 nhsuk-u-padding-left-5 nhsuk-u-padding-right-5" style="grid-column: 2; grid-row: 20;">
      <p class="nhsuk-body-s nhsuk-u-margin-bottom-2 nhsuk-u-display-none" data-all-fields><a class="nhsuk-link" href="#">View this record</a></p>
      <div class="nhsuk-radios nhsuk-radios--small" data-module="nhsuk-radios">
        <div class="nhsuk-radios__item">
          <input class="nhsuk-radios__input" id="record-2" name="preferred-record" type="radio" value="record-2">
          <label class="nhsuk-label nhsuk-radios__label nhsuk-u-font-size-16" for="record-2">
            Choose this record
          </label>
        </div>
      </div>
    </div>
  </div>
  <hr class="nhsuk-section-break nhsuk-section-break--m nhsuk-section-break--visible">
  <!-- /Duplicate record card -->

  <!-- Live selection: every card carries a grey Duplicate record tag from load; choosing
       a record swaps its tag to blue Your preferred record IN PLACE (class + text only,
       no element inserted or removed, so card height never changes) and gives its underlay
       the heavier blue border. Re-selecting moves everything; no state persists.
       One logical View all rows state exposed at every row's toggle. Toggling any
       instance drives all instances to the same open state (setting .open to its current
       value fires no toggle event, so the sync converges without loops), then shows or
       hides the additional field rows. The last visible row must not have a bottom border:
       Batch rows (data-border-when-expanded) gain one while expanded, Protocol rows never
       have one. -->
  <script>
    for (const radio of document.querySelectorAll('input[name="preferred-record"]')) {
      radio.addEventListener("change", () => {
        for (const cell of document.querySelectorAll("[data-record-tag]")) {
          const tag = cell.querySelector(".nhsuk-tag")
          const chosen = cell.dataset.recordTag === radio.value
          tag.classList.toggle("nhsuk-tag--blue", chosen)
          tag.classList.toggle("nhsuk-tag--grey", !chosen)
          tag.textContent = chosen ? "Your preferred record" : "Duplicate record"
        }
        for (const box of document.querySelectorAll("[data-record-box]")) {
          box.style.border = box.dataset.recordBox === radio.value ? "2px solid #005eb8" : "1px solid #d8dde0"
        }
      })
    }

    const viewAllToggles = document.querySelectorAll("[data-view-all-toggle]")
    for (const toggle of viewAllToggles) {
      toggle.addEventListener("toggle", (event) => {
        const open = event.target.open
        for (const other of viewAllToggles) other.open = open
        for (const row of document.querySelectorAll("[data-all-fields]")) {
          row.classList.toggle("nhsuk-u-display-none", !open)
        }
        for (const row of document.querySelectorAll("[data-border-when-expanded]")) {
          row.style.borderBottom = open ? "1px solid #d8dde0" : ""
        }
      })
    }
  </script>
{% endblock %}
