          <p class="nhsuk-body-s nhsuk-u-margin-bottom-2 nhsuk-u-display-none" data-all-fields><a class="nhsuk-link" href="#">View this record</a></p>
          <div class="nhsuk-radios nhsuk-radios--small" data-module="nhsuk-radios">
            <div class="nhsuk-radios__item">
              <input class="nhsuk-radios__input" id="record-20" name="preferred-record" type="radio" value="record-20">
              <label class="nhsuk-label nhsuk-radios__label nhsuk-u-font-size-16" for="record-20">
                Choose this record
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>
    </div>
    <!-- /Duplicate record grid -->
  </div>
  <!-- Sticky set navigation: game-mode queue bar. Both status strings are
       placeholder wording. One action button tracks the selection radios: it
       reads Skip to next duplicate (white secondary style) until a record is chosen, then Review next duplicate
       (green primary). Same link either way, to the next demo scenario as a
       placeholder for advancing the queue (no real queue or saved state yet);
       the last set returns to the index. Clear choice sits next to the status
       text, hidden until a record is chosen; it unselects the radios and
       returns everything, button included, to the initial state. The spacer
       below keeps the fixed bar from covering the last grid row when scrolled
       to the bottom. -->
  <!-- Clearance for the fixed bar: padding at the very end of the document
       (below the footer) rather than a spacer above it, so scrolling to the
       bottom brings the footer fully above the bar -->
  <style>
    body { padding-bottom: 96px; }
  </style>
  <div style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 20; background: #ffffff; border-top: 1px solid #d8dde0; padding-bottom: env(safe-area-inset-bottom);">
    <div class="nhsuk-width-container-fluid nhsuk-u-padding-top-3 nhsuk-u-padding-bottom-3">
      <div style="max-width: 1720px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; column-gap: 24px;">
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-0"><span data-set-status>Choose your preferred record</span> <a class="nhsuk-link nhsuk-u-margin-left-2 nhsuk-u-display-none" href="#" data-clear-choice>Clear choice</a></p>
        <a class="nhsuk-button nhsuk-button--secondary nhsuk-u-margin-bottom-0" data-module="nhsuk-button" data-set-action href="/duplicate-training" role="button" draggable="false">Skip to next duplicate</a>
      </div>
    </div>
  </div>
  <!-- /Sticky set navigation -->

  <!-- Live selection: every card carries a grey Duplicate record tag from load; choosing
       a record swaps its tag to blue Your preferred record IN PLACE (class + text only,
       no element inserted or removed, so card height never changes) and gives its underlay
       the heavier blue border. Re-selecting moves everything; no state persists.
       One logical View all rows state exposed at every row's toggle. Toggling any
       instance drives all instances to the same open state (setting .open to its current
       value fires no toggle event, so the sync converges without loops), then shows or
       hides the additional field rows. The last visible row must not have a bottom border:
       Batch rows (data-border-when-expanded) gain one while expanded. Protocol rows
       keep a static border so the View this record link below does not read as
       part of the row. A single renderer owns the whole selection state (tags, borders, status
       text, Clear choice visibility, the Skip to next duplicate/Review next duplicate action button), with null meaning no
       choice; the radio change handler and the Clear choice link both go through it, so
       the pieces can never disagree. -->
  <script>
    const renderChoice = (value) => {
      for (const cell of document.querySelectorAll("[data-record-tag]")) {
        const tag = cell.querySelector(".nhsuk-tag")
        const chosen = cell.dataset.recordTag === value
        tag.classList.toggle("nhsuk-tag--blue", chosen)
        tag.classList.toggle("nhsuk-tag--grey", !chosen)
        tag.textContent = chosen ? "Your preferred record" : "Duplicate record"
      }
      for (const box of document.querySelectorAll("[data-record-box]")) {
        box.style.border = box.dataset.recordBox === value ? "2px solid #005eb8" : "1px solid #d8dde0"
      }
      document.querySelector("[data-set-status]").textContent = value ? "Preferred record chosen" : "Choose your preferred record"
      document.querySelector("[data-clear-choice]").classList.toggle("nhsuk-u-display-none", !value)
      const action = document.querySelector("[data-set-action]")
      action.textContent = value ? "Review next duplicate" : "Skip to next duplicate"
      action.classList.toggle("nhsuk-button--secondary", !value)
    }

    for (const radio of document.querySelectorAll('input[name="preferred-record"]')) {
      radio.addEventListener("change", () => renderChoice(radio.value))
    }

    document.querySelector("[data-clear-choice]").addEventListener("click", (event) => {
      event.preventDefault()
      for (const radio of document.querySelectorAll('input[name="preferred-record"]')) radio.checked = false
      renderChoice(null)
    })

    const viewAllToggles = document.querySelectorAll("[data-view-all-toggle]")
    for (const toggle of viewAllToggles) {
      toggle.addEventListener("toggle", (event) => {
        const open = event.target.open
        for (const other of viewAllToggles) other.open = open
        for (const row of document.querySelectorAll("[data-all-fields]")) {
          row.classList.toggle("nhsuk-u-display-none", !open)
        }
        for (const row of document.querySelectorAll("[data-border-when-expanded]")) {
          row.style.borderBottom = open ? "1px solid #d8dde0" : ""
        }
      })
    }
  </script>
{% endblock %}
