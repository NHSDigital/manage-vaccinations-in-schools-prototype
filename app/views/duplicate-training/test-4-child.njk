{% extends "_layouts/default.njk" %}

{% set pageName = "Poppy Slater - child record" %}
{% block header %}
  <!-- Mavis site chrome: environment banner and site header exactly as rendered
       on a child record, with the Children item current. Static copy for
       presentation only; these demo pages do not live under /patients. -->
  <div class="app-environment nhsuk-tag--grey">
    <div class="nhsuk-width-container">
      <strong class="nhsuk-tag nhsuk-tag--grey">Prototype</strong>
      This is a prototype used for research.
    </div>
  </div>
  <header class="nhsuk-header" data-module="nhsuk-header" role="banner">
    <div class="nhsuk-header__container nhsuk-width-container">
      <div class="nhsuk-header__service">
        <a class="nhsuk-header__service-logo" href="/home" aria-label="NHS Manage vaccinations in schools homepage">
          <svg class="nhsuk-header__logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 80" height="40" width="100" focusable="false" role="img" aria-label="NHS">
            <title>NHS</title>
            <path fill="currentcolor" d="M200 0v80H0V0h200Zm-27.5 5.5c-14.5 0-29 5-29 22 0 10.2 7.7 13.5 14.7 16.3l.7.3c5.4 2 10.1 3.9 10.1 8.4 0 6.5-8.5 7.5-14 7.5s-12.5-1.5-16-3.5L135 70c5.5 2 13.5 3.5 20 3.5 15.5 0 32-4.5 32-22.5 0-19.5-25.5-16.5-25.5-25.5 0-5.5 5.5-6.5 12.5-6.5a35 35 0 0 1 14.5 3l4-13.5c-4.5-2-12-3-20-3Zm-131 2h-22l-14 65H22l9-45h.5l13.5 45h21.5l14-65H64l-9 45h-.5l-13-45Zm63 0h-18l-13 65h17l6-28H117l-5.5 28H129l13.5-65H125L119.5 32h-20l5-24.5Z"/>
          </svg>
          <span class="nhsuk-header__service-name">Manage vaccinations in schools</span>
        </a>
      </div>
      <nav class="nhsuk-header__account" aria-label="Account">
        <ul class="nhsuk-header__account-list">
          <li class="nhsuk-header__account-item">
            <svg class="nhsuk-icon nhsuk-icon--user" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true">
              <path d="M12 1a11 11 0 1 1 0 22 11 11 0 0 1 0-22Zm0 2a9 9 0 0 0-5 16.5V18a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v1.5A9 9 0 0 0 12 3Zm0 3a3.5 3.5 0 1 1-3.5 3.5A3.4 3.4 0 0 1 12 6Z"/>
            </svg>
            JOY, Jane (Nurse)
          </li>
          <li class="nhsuk-header__account-item">
            <a class="nhsuk-header__account-link" href="/account/change-role">Change role</a>
          </li>
          <li class="nhsuk-header__account-item">
            <a class="nhsuk-header__account-link" href="/account/sign-out">Log out</a>
          </li>
        </ul>
      </nav>
    </div>
    <nav class="nhsuk-header__navigation" aria-label="Menu">
      <div class="nhsuk-header__navigation-container nhsuk-width-container">
        <ul class="nhsuk-header__navigation-list">
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/schools">Schools</a>
          </li>
          <li class="nhsuk-header__navigation-item nhsuk-header__navigation-item--current">
            <a class="nhsuk-header__navigation-link" href="/patients" aria-current="true"><strong class="nhsuk-header__navigation-item-current-fallback">Children</strong></a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/sessions">Sessions</a>
          </li>
          <li class="nhsuk-header__navigation-item app-header__navigation-item--with-badge">
            <a class="nhsuk-header__navigation-link" href="/reviews">Review<strong class="app-badge">124</strong></a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/reports">Reports</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/uploads">Uploads</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/downloads">Downloads</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/vaccines">Vaccines</a>
          </li>
          <li class="nhsuk-header__navigation-item">
            <a class="nhsuk-header__navigation-link" href="/teams/001">Your team</a>
          </li>
          <li class="nhsuk-header__menu" hidden>
            <button class="nhsuk-header__menu-toggle nhsuk-header__navigation-link" id="toggle-menu" aria-expanded="false">
              <span class="nhsuk-u-visually-hidden">Browse </span>More
            </button>
          </li>
        </ul>
      </div>
    </nav>
  </header>
{% endblock %}

{% block beforeContent %}
  <a class="nhsuk-back-link" href="/duplicate-training/test-4">Back to duplicate records</a>
{% endblock %}

{% block content %}
  <!-- Static child record for Poppy Slater, the child in user testing set 4, so
       View full child record on that page goes somewhere real. It is what Mavis shows a
       standard SAIS user on a child record (app/views/patients/show.html.erb): heading,
       section navigation, the Child record card with the rows of AppChildSummaryComponent,
       and the Vaccination programmes table of AppPatientProgrammesTableComponent
       (Programme, Status, Notes; a fully vaccinated programme shows a white Vaccinated
       tag and the note Vaccinated on <date>). Nothing else is added; vaccination history
       lives behind the programme tabs in Mavis, and those tabs are placeholders here.

       Identity details are the ones already shown on the comparison page. The MMR date is the set's real date. At Year 4 the secondary-school programmes are not yet eligible; their eligible-from dates are derived from the year group.
       No vaccination event pages exist for invented rows. -->
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-full">
      <h1 class="nhsuk-heading-l">Poppy Slater</h1>

      <nav class="app-section-navigation" data-module="app-section-navigation" aria-label="Section navigation">
        <ul class="app-section-navigation__list">
          <li class="app-section-navigation__item app-section-navigation__item--current">
            <a class="app-section-navigation__link" href="/duplicate-training/test-4-child" aria-current="page"><strong class="app-section-navigation__current">Child record</strong></a>
          </li>
          <li class="app-section-navigation__item">
            <a class="app-section-navigation__link" href="#">Contacts</a>
          </li>
          <li class="app-section-navigation__item">
            <a class="app-section-navigation__link" href="#">MMR</a>
          </li>
          <li class="app-section-navigation__item">
            <a class="app-section-navigation__link" href="#">HPV</a>
          </li>
          <li class="app-section-navigation__item">
            <a class="app-section-navigation__link" href="#">MenACWY</a>
          </li>
          <li class="app-section-navigation__item">
            <a class="app-section-navigation__link" href="#">Td/IPV</a>
          </li>
        </ul>
      </nav>
      <h2 class="nhsuk-heading-m nhsuk-u-visually-hidden">Child record</h2>

      <!-- Child record card -->
      <div class="nhsuk-card">
        <div class="nhsuk-card__content">
          <h3 class="nhsuk-card__heading nhsuk-heading-m">Child record</h3>
          <dl class="nhsuk-summary-list">
            <div class="nhsuk-summary-list__row">
              <dt class="nhsuk-summary-list__key">NHS number</dt>
              <dd class="nhsuk-summary-list__value">999 512 3404</dd>
            </div>
            <div class="nhsuk-summary-list__row">
              <dt class="nhsuk-summary-list__key">Full name</dt>
              <dd class="nhsuk-summary-list__value">Poppy Slater</dd>
            </div>
            <div class="nhsuk-summary-list__row">
              <dt class="nhsuk-summary-list__key">Date of birth</dt>
              <dd class="nhsuk-summary-list__value">9 July 2018 (aged 8)</dd>
            </div>
            <div class="nhsuk-summary-list__row">
              <dt class="nhsuk-summary-list__key">Address</dt>
              <dd class="nhsuk-summary-list__value">3 Millgate Lane<br>Hyde<br>SK14 4PL</dd>
            </div>
            <div class="nhsuk-summary-list__row">
              <dt class="nhsuk-summary-list__key">School</dt>
              <dd class="nhsuk-summary-list__value">Unknown school</dd>
            </div>
            <div class="nhsuk-summary-list__row">
              <dt class="nhsuk-summary-list__key">Year group</dt>
              <dd class="nhsuk-summary-list__value">Year 4</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Vaccination programmes card -->
      <div class="nhsuk-card">
        <div class="nhsuk-card__content">
          <h3 class="nhsuk-card__heading nhsuk-heading-m">Vaccination programmes</h3>
          <table class="nhsuk-table-responsive" id="programmes">
            <thead class="nhsuk-table__head">
              <tr>
                <th class="nhsuk-table__header" scope="col">Programme</th>
                <th class="nhsuk-table__header" scope="col">Status</th>
                <th class="nhsuk-table__header" scope="col">Notes</th>
              </tr>
            </thead>
            <tbody class="nhsuk-table__body">
              <tr class="nhsuk-table__row">
                <td class="nhsuk-table__cell"><span class="nhsuk-table-responsive__heading">Programme </span><a class="nhsuk-link" href="#">MMR</a></td>
                <td class="nhsuk-table__cell"><span class="nhsuk-table-responsive__heading">Status </span><strong class="nhsuk-tag nhsuk-tag--white">Vaccinated</strong></td>
                <td class="nhsuk-table__cell"><span class="nhsuk-table-responsive__heading">Notes </span>Vaccinated on 23 March 2022</td>
              </tr>
              <tr class="nhsuk-table__row">
                <td class="nhsuk-table__cell"><span class="nhsuk-table-responsive__heading">Programme </span><a class="nhsuk-link" href="#">HPV</a></td>
                <td class="nhsuk-table__cell"><span class="nhsuk-table-responsive__heading">Status </span><strong class="nhsuk-tag nhsuk-tag--grey">Not eligible</strong></td>
                <td class="nhsuk-table__cell"><span class="nhsuk-table-responsive__heading">Notes </span>Eligible from 1 September 2030</td>
              </tr>
              <tr class="nhsuk-table__row">
                <td class="nhsuk-table__cell"><span class="nhsuk-table-responsive__heading">Programme </span><a class="nhsuk-link" href="#">MenACWY</a></td>
                <td class="nhsuk-table__cell"><span class="nhsuk-table-responsive__heading">Status </span><strong class="nhsuk-tag nhsuk-tag--grey">Not eligible</strong></td>
                <td class="nhsuk-table__cell"><span class="nhsuk-table-responsive__heading">Notes </span>Eligible from 1 September 2031</td>
              </tr>
              <tr class="nhsuk-table__row">
                <td class="nhsuk-table__cell"><span class="nhsuk-table-responsive__heading">Programme </span><a class="nhsuk-link" href="#">Td/IPV</a></td>
                <td class="nhsuk-table__cell"><span class="nhsuk-table-responsive__heading">Status </span><strong class="nhsuk-tag nhsuk-tag--grey">Not eligible</strong></td>
                <td class="nhsuk-table__cell"><span class="nhsuk-table-responsive__heading">Notes </span>Eligible from 1 September 2031</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
{% endblock %}
