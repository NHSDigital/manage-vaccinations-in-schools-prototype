{% from "upload/_patient-records.njk" import patientRecords with context %}

{% extends "_layouts/form.njk" %}

{% set gridColumns = "full" %}
{% set hideConfirmButton = true %}
{% set status = upload.teamStatus %}
{% set needsReview = status == UploadStatus.Review %}
{% if needsReview %}
  {% set title = __("upload.show.approve.title", upload.formatted.createdAt) %}
{% else %}
  {% set title = __("upload.show.title", upload.formatted.createdAt) %}
{% endif %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [
      {
        text: __("home.show.title"),
        href: "/"
      },
      {
        text: __("upload.list.title"),
        href: "/uploads"
      }
    ]
  }) }}
{% endblock %}

{% block form %}
  {{ super() }}

  {{ heading({
    text: title,
    size: "l"
  }) }}

  {% if needsReview %}
  <div class="nhsuk-u-reading-width">
    {{ __("upload.show.approve.description") | nhsukMarkdown }}
  </div>
  {% endif %}

  {{ summaryList({
    card: {
      heading: {
        text: __("upload.show.summary"),
        size: "m"
      },
      actions: [
        {
          text: __("upload.removeRelationships.label"),
          href: upload.uri + "/bulk-remove-relationships"
        }
      ] if status == UploadStatus.Approved and upload.type != UploadType.Report
    },
    lastRowBorder: false,
    rows: summaryRows(upload, {
      requested: {},
      assignees: {},
      uploaded: {} if not upload.isPrivateToSchool else none,
      fileName: {
        changeText: __("actions.download"),
        changeLabel: upload.fileName,
        href: "#"
      } if not upload.isPrivateToSchool else none,
      type: {},
      format: {} if not upload.isPrivateToSchool else none,
      school: {},
      yearGroups: {},
      patients: {} if not upload.isPrivateToSchool else none,
      teamStatus: {},
      submitted: {},
      approved: {},
      rejected: {},
      rejectionReason: {}
    })
  }) }}

  {% if status in [UploadStatus.Review, UploadStatus.Rejected] %}
    {{ patientRecords({
      key: "new",
      patients: upload.patients | selectattr("isNewUpload")
    }) }}

    {{ patientRecords({
      key: "matched",
      patients: upload.patients | selectattr("hasMatchingUpload")
    }) }}

    {% set pendingRecords = upload.patients | selectattr("hasPendingChanges") %}
    {% if pendingRecords.length %}
      {% include "upload/_pending-records.njk" %}
    {% endif %}

    {% if upload.type != UploadType.Report and upload.moves.length %}
      {% include "upload/_school-moves.njk" %}
    {% endif %}
  {% elif status == UploadStatus.Approved %}
    {% set pendingRecords = upload.patients | selectattr("hasPendingChanges") %}
    {% if pendingRecords.length %}
      {% include "upload/_pending-records.njk" %}
    {% endif %}

    {% if upload.type != UploadType.Report and upload.moves.length %}
      {% include "upload/_school-moves.njk" %}
    {% endif %}

    {{ patientRecords({
      key: "imported",
      patients: upload.patients
    }) }}
  {% endif %}

  {% if status == UploadStatus.Invalid %}
    {% call card({
      feature: true,
      heading: {
        text: __("upload.invalid.title"),
        classes: "app-card__heading--red",
        level: 2,
        size: "m"
      }
    }) %}
      <div class="nhsuk-u-reading-width">
        {{ actionLink({
          text: __("upload.edit.label"),
          href: upload.uri + "/edit/file"
        }) }}
      </div>

      {% for row, validations in upload.validations %}
        {{ heading({
          text: "Row " + row,
          level: 3,
          size: "s"
        }) }}
        <ul>
        {% for key, message in validations %}
          <li><code>{{ key }}</code> {{ message }}</li>
        {% endfor %}
        </ul>
      {% endfor %}
    {% endcall %}
  {% elif status == UploadStatus.Failed %}
    {% call card({
      classes: "nhsuk-u-margin-bottom-6",
      feature: true,
      heading: {
        text: __("upload.failed.title"),
        classes: "app-card__heading--red",
        level: 2,
        size: "m"
      }
    }) %}
      <div class="nhsuk-u-reading-width">
        {{ __("upload.failed.description") | nhsukMarkdown }}
      </div>

      {{ actionLink({
        text: __("upload.edit.label", upload.type | lower),
        href: upload.uri + "/edit/file"
      }) }}
    {% endcall %}

    {% include "upload/_failed-records.njk" %}
  {% endif %}

  {% if upload.patients.length > 0 and needsReview %}
    <hr class="nhsuk-section-break nhsuk-section-break--visible nhsuk-section-break--l">

    {{ appButtonGroup({
      buttons: [
        {
          text: __("upload.approve.confirm"),
          attributes: {
            formaction: upload.uri + "/approve"
          }
        },
        {
          text: __("upload.reject.confirm"),
          href: upload.uri + "/reject",
          variant: "warning"
        },
        {
          text: __("upload.delete.confirm"),
          variant: "secondary",
          attributes: {
            formaction: upload.uri + "/delete"
          }
        }
      ]
    }) }}
  {% elif upload.canDelete %}
    <hr class="nhsuk-section-break nhsuk-section-break--visible nhsuk-section-break--l">

    {{ appButtonGroup({
      buttons: [
        {
          text: __("upload.delete.label"),
          variant: "secondary",
          attributes: {
            formaction: upload.uri + "/delete"
          }
        }
      ]
    }) }}
  {% endif %}
{% endblock %}
