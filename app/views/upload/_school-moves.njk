{% set needsReview = upload.status == UploadStatus.Review %}
{% set moveRows = [] %}
{% for move in upload.moves %}
  {% set moveRadios = radios({
    formGroup: {
      classes: "nhsuk-u-margin-bottom-2"
    },
    fieldset: {
      legend: {
        classes: "nhsuk-u-visually-hidden",
        text: __("upload.show.moves.decision.title", { patient: move.patient })
      }
    },
    small: true,
    items: [
      {
        label: __("upload.show.moves.decision.accept.label"),
        value: "restore"
      },
      {
        label: __("upload.show.moves.decision.ignore.label"),
        value: "ignore"
      }
    ],
    decorate: "school-move-" + loop.index0
  }) %}
  {% set moveDecision = __("upload.show.moves.decision.accept.label") %}

  {% set moveRows = moveRows | push([
    {
      html: move.patient.formatted.fullNameAndNhsn
    },
    {
      html: move.movementForImport
    },
    {
      html: moveRadios if needsReview else moveDecision
    }
  ]) %}
{% endfor %}

{{ heading({
  caption: {
    text: __("upload.show.moves.summary") if needsReview,
    placement: "after"
  },
  text: __("upload.show.moves.title") if needsReview else __("upload.show.moves.label"),
  level: 2,
  size: "m"
}) }}

{{ table({
  classes: "app-table--review",
  responsive: true,
  card: {
    heading: {
      text: __mf("upload.show.moves.count", { count: moveRows.length }),
      level: 3,
      size: "s"
    }
  },
  head: [
    { text: __("patient.fullNameAndNhsn.label") },
    { text: __("move.label") },
    { html: __("upload.show.moves.decision.label") }
  ],
  rows: moveRows
}) }}
