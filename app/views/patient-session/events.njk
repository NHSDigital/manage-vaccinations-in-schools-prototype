{% extends "_layouts/session.njk" %}

{% set title = patient.initials + " – " + session.shortName + " – " + __("patient.events.title") %}
{% set heading = patientSession.patient.fullName %}
{% set stickyBanner = true %}
{% set view = "events" %}

{% block beforeContent %}
  {{ breadcrumb({
    classes: "nhsuk-breadcrumb--reverse",
    items: [{
      text: session.name,
      href: session.uri
    }, {
      text: __("session.report.title"),
      href: session.uri + "/report"
    }]
  }) }}
{% endblock %}

{% block content %}
  {{ super() }}

  {% include "patient-session/_note.njk" %}

  {{ appTimeline({
    items: timelineItems(patientSession.auditEventLog)
  }) }}
{% endblock %}
