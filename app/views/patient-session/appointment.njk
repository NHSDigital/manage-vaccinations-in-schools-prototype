{% extends "_layouts/session.njk" %}

{% set title = patient.initials + " – " + session.shortName + " – " + __("patientSession.appointment.title") %}
{% set heading = patientSession.patient.fullName %}
{% set stickyBanner = true %}
{% set view = "appointment" %}

{% block beforeContent %}
  {{ breadcrumb({
    classes: "nhsuk-breadcrumb--reverse",
    items: [{
      text: session.name,
      href: session.uri
    }, {
      text: __("session.report.title"),
      href: session.uri + "/report"
    }]
  }) }}
{% endblock %}

{% block content %}
  {{ super() }}

  {# Details of the appointment as it stands #}
  {% include "patient-session/_appointment.njk" %}

  {# Registration #}
  {% if options.canRegister %}
    {% include "patient-session/_register.njk" %}
  {% endif %}
  
  {# Details of additional programmes that could be offered #}
  {% include "patient-session/_catch-up.njk" %}
{% endblock %}
