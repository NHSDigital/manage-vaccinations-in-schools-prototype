{% from "../_macros/contact-email.njk" import appContactEmail with context %}
{% from "../_macros/contact-sms.njk" import appContactSms with context %}

{% call card({
  heading: {
    text: __("patientSession.consent.title", programme.nameSentenceCase),
    size: "m"
  }
}) %}
  {# Description #}
  {% if not patientProgramme.isVaccinated %}
    {{ patientProgramme.consentDescription | nhsukMarkdown }}

    {% if patientProgramme.patient.lastReminderDate %}
      {{ patientProgramme.patient.formatted.lastReminderDate | nhsukMarkdown }}
    {% endif %}
  {% endif %}

  {# Actions #}
  {% if not patientProgramme.isVaccinated and not patientProgramme.patient.isPost16 %}
    {{ actionLink({
      text: __("reply.new.title"),
      href: patientProgramme.uri + "/replies/new?session_id=" + session.id + "&referrer=" + referrer
    }) if not patientProgramme.isVaccinated }}

    {{ appButtonGroup({
      buttons: [{
        text: __("remind.new.title"),
        variant: "secondary",
        attributes: {
          formaction: patientSession.uri + "/new/remind",
          formmethod: "post"
        }
      } if options.canRemind, {
        text: __("patientSession.invite.label"),
        variant: "secondary",
        attributes: {
          formaction: patientSession.uri + "/new/invite",
          formmethod: "post"
        }
      }]
    }) }}
  {% endif %}

  {% if patientProgramme.replies | length %}
    {# Requests with responses or requests that couldn’t be delivered #}
    {{ appHeading({
      title: __("patientSession.replies.label") if patientProgramme.replies.length > 0 else __("patientSession.consentRequests.label"),
      level: 3,
      size: "s"
    }) }}

    {% for reply in patientProgramme.replies %}
      {{ summaryList({
        card: {
          classes: "app-card--compact app-card--offset",
          heading: {
            text: reply.fullNameAndRelationship,
            level: 4
          },
          href: reply.uri if reply.isDelivered,
          actions: {
            items: [
              {
                text: __("reply.withdraw.label"),
                href: reply.uri + "/edit/withdraw"
              } if reply.hasGivenConsent,
              {
                text: __("reply.follow-up.label"),
                href: reply.uri + "/edit/follow-up"
              } if not reply.hasConfirmedRefusal and not reply.hasGivenConsent,
              {
                text: __("reply.invalidate.label"),
                href: reply.uri + "/edit/invalidate"
              }
            ]
          } if reply.isValid
        },
        lastRowBorder: false,
        rows: summaryRows(reply, {
          email: {
            value: appContactEmail(reply.contact, reply.hasGivenConsent)
          } if reply.contact.email,
          tel: {
            value: appContactSms(reply.contact, reply.hasGivenConsent)
          } if reply.contact.tel,
          communicationNeeds: {
            label: __("contact.communicationNeeds.label"),
            value: reply.contact.communicationNeeds
          } if reply.contact.communicationNeeds,
          createdAt: {},
          decisionStatus: {},
          vaccineCriteria: {}
        })
      }) }}
    {% endfor %}
  {% elif patientProgramme.patient.hasContactDetails and not patientProgramme.patient.isPost16 %}
    {# Requests that have been sent but with no response yet #}
    {# We don’t create replies so use contact details instead #}

    {{ appHeading({
      title: __("patientSession.consentRequests.label"),
      level: 3,
      size: "s"
    }) }}

    {% for contact in patientProgramme.patient.contacts %}
      {{ summaryList({
        card: {
          classes: "app-card--compact app-card--offset",
          heading: {
            text: contact.fullNameAndRelationship,
            level: 4
          }
        },
        lastRowBorder: false,
        rows: summaryRows(contact, {
          email: {},
          tel: {},
          decisionStatus: {
            label: __("reply.decisionStatus.label"),
            value: tag({
              classes: "nhsuk-tag--grey",
              text: PatientConsentStatus.Scheduled if session.consentWindow == ConsentWindow.Opening else PatientConsentStatus.NoResponse
            })
          }
        })
      }) if contact.email or contact.tel }}
    {% endfor %}
  {% endif %}
{% endcall %}
