{% macro consentResponseCard(reply) %}
  {% call card({
    classes: "app-card--compact app-card--offset",
    heading: {
      text: reply.fullNameAndRelationship,
      caption: {
        text:
          ("Phone: " + reply.contact.tel) if reply.contact.tel else ("Email: " + reply.contact.email),
        placement: "end"
      },
      level: 4
    },
    href: ((reply.clinicAppointment.uri.matched + "?referrer=" + referrer) if reply.clinicAppointment else (reply.uri + "?referrer=" + referrer)) if reply.isDelivered and (not reply.clinicAppointment or reply.clinicAppointment.status === ClinicAppointmentStatus.Booked),
    actions: {
      items: [
        {
          text: __("patientSession.clinicAppointment.edit.label"),
          href: reply.clinicAppointment.uri.edit + "?referrer=" + referrer
        } if reply.clinicAppointment.status === ClinicAppointmentStatus.Booked,
        {
          text: __("patientSession.clinicAppointment.cancel.label"),
          href: clinicAppointment.uri.cancel + "?referrer=" + referrer
        } if reply.clinicAppointment.status === ClinicAppointmentStatus.Booked
      ] if reply.clinicAppointment else [
        {
          text: __("reply.withdraw.label"),
          href: reply.uri + "/edit/withdraw?referrer=" + referrer
        } if reply.hasGivenConsent,
        {
          text: __("reply.follow-up.label"),
          href: reply.uri + "/edit/follow-up?referrer=" + referrer
        } if not reply.hasConfirmedRefusal and not reply.hasGivenConsent,
        {
          text: __("reply.invalidate.label"),
          href: reply.uri + "/edit/invalidate?referrer=" + referrer
        }
      ]
    } if reply.isValid
  }) %}
    {# Details of the response #}
    {{ summaryList({
      lastRowBorder: false,
      rows: summaryRows(reply, {
        communicationNeeds: {
          label: __("contact.communicationNeeds.label"),
          value: reply.contact.communicationNeeds
        } if reply.contact.communicationNeeds,
        createdAt: {},
        expiresAt: {} if not reply.isInvalidated else none,
        decisionStatus: {},
        responseType: {},
        vaccineCriteria: {}
      })
    }) }}
  {% endcall %}
{% endmacro %}

{% call card({
  heading: {
    text: __("patientSession.consent.title", programme.nameSentenceCase),
    size: "m"
  }
}) %}
  {# Description #}
  {% if not patientProgramme.isVaccinated %}
    {{ patientProgramme.consentDescription | nhsukMarkdown }}
  {% endif %}

  {# Record a new consent response #}
  {% if not patientProgramme.isVaccinated and not patientProgramme.patient.isPost16 %}
    <div class="app-action-link-with-description">
      {{ actionLink({
        text: __("reply.new.title"),
        href: patientProgramme.uri + "/replies/new?session_id=" + session.id + "&referrer=" + referrer
      }) }}
      {{ __("reply.new.description") | nhsukMarkdown }}
    </div>
  {% endif %}

  {# Responses that count towards consent #}
  {{ heading({
    text: __("patientSession.replies.label"),
    level: 3,
    size: "s",
    classes: "nhsuk-u-margin-bottom-2" if patientProgramme.replies.length === 0
  }) }}

  {% if patientProgramme.replies.length > 0 %}
    {% for reply in patientProgramme.replies %}
      {{ consentResponseCard(reply) }}
    {% endfor %}
  {% else %}
    {{ __("patientSession.replies.none") | nhsukMarkdown }}
  {% endif %}

  {# Responses that no longer count towards consent #}
  {% if patientProgramme.previousReplies | length %}
    {% call details({
      summaryText: __("patientSession.previousReplies.label"),
      classes: "nhsuk-u-margin-top-4"
    }) %}
      {% for reply in patientProgramme.previousReplies %}
        {{ consentResponseCard(reply) }}
      {% endfor %}
    {% endcall %}
  {% endif %}

  {# For school sessions, tell us whether consent requests and reminders are going out #}
  {% set consentRequest = patientProgramme.getConsentRequestForSession(session) %}
  {% if consentRequest %}
    {{ heading({
      text: "Consent requests for this session",
      level: 3,
      size: "s",
      classes: "nhsuk-u-margin-top-4 nhsuk-u-margin-bottom-2"
    }) }}

    {% if not consentRequest.shouldRequest %}
      {% set hasOrHad = "had" if session.areConsentRequestsSent else "has" %}
      {% set isOrWas = "was" if session.areConsentRequestsSent else "is" %}
      {% set reasonText %}
        {%- if consentRequest.reason === ConsentRequestReason.ConsentLastsUntilSession -%}
          the child already {{ hasOrHad }} consent lasting until the session
        {%- elif consentRequest.reason === ConsentRequestReason.Refused -%}
          the child {{ hasOrHad }} a refusal, and this session only requests consent for children without one
        {%- elif consentRequest.reason === ConsentRequestReason.AlreadyVaccinated -%}
          the child {{ isOrWas }} already vaccinated
        {%- elif consentRequest.reason === ConsentRequestReason.SelfConsent -%}
          the child can give consent themselves
        {%- endif -%}
      {% endset %}
      <p class="nhsuk-body">
        Consent requests {{ "were not" if session.areConsentRequestsSent else "will not be" }} sent, as {{ reasonText }}.
      </p>
    {% else %}
      {# Work out who'll get the consent requests and reminders #}
      {% set contactsToContact = [] %}
      {% for contact in patientProgramme.patient.contacts %}
        {% if contact.hasContactDetails %}
          {% set contactsToContact = contactsToContact | push(contact.fullNameAndRelationship) %}
        {% endif %}
      {% endfor %}

      {% if contactsToContact | length %}
        {% if consentRequest.reason === ConsentRequestReason.SessionContactsRefusals %}
          <p class="nhsuk-body nhsuk-u-margin-bottom-2">
            The child {{ "had" if session.areConsentRequestsSent else "has" }} a refusal, but this session requests consent for all children, including those with a refusal.
          </p>
        {% endif %}

        <p class="nhsuk-body nhsuk-u-margin-bottom-2">
          Consent {{ "was" if session.areConsentRequestsSent else "will be" }} requested on {{ session.formatted.consentOpenAt }} from:
        </p>

        <ul class="nhsuk-list nhsuk-list--bullet">
          {% for contactDetails in contactsToContact %}
            <li>
              {{contactDetails}}
            </li>
          {% endfor %}
        </ul>

        {# Parents who respond to the request aren’t reminded #}
        {% if session.areConsentRequestsSent %}
          {% if patientProgramme.hasReplyBetween(session.consentOpenAt, session.nextReminderDate) %}
            <p class="nhsuk-body">
              A reminder {{ "was not" if session.areConsentRemindersSent else "will not be" }} sent, as a response was received.
            </p>
          {% else %}
            <p class="nhsuk-body">
              A reminder {{ "was" if session.areConsentRemindersSent else "will be" }} sent on {{ session.formatted.nextReminderDate -}}.
            </p>
          {% endif %}
        {% endif %}
      {% else %}
        <p class="nhsuk-body">
          Consent requests cannot be sent as the child has no contacts with contact details.
        </p>
      {% endif %}
    {% endif %}
  {% endif %}

  {# Actions #}
  {% if not patientProgramme.isVaccinated and not patientProgramme.patient.isPost16 %}
    {{ appButtonGroup({
      buttons: [
        {
          text: __("patientSession.request.label"),
          variant: "secondary",
          attributes: {
            formaction: patientSession.uri + "/new/request",
            formmethod: "post"
          }
        } if options.canRequest,
        {
          text: __("remind.new.title", ((consentRemindersSent + 1) | ordinal) if consentRemindersSent else "a"),
          variant: "secondary",
          attributes: {
            formaction: patientSession.uri + "/new/remind",
            formmethod: "post"
          }
        } if options.canRemind
      ],
      description: lastConsentReminderDate
    }) }}
  {% endif %}

{% endcall %}
