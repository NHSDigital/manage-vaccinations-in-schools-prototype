{% from "../_macros/consent-request.njk" import appConsentRequest with context %}
{% from "../_macros/reply.njk" import appReply with context %}

{% call card({
  heading: {
    text: __("reply.list.title", programme.nameSentenceCase),
    size: "m"
  }
}) %}
  {# Description #}
  {% if not patientProgramme.isVaccinated %}
    {{ patientProgramme.consentDescription | nhsukMarkdown }}
  {% endif %}

  {# Actions #}
  {% if not patientProgramme.isVaccinated and not patientProgramme.patient.isPost16 %}
    {% if not patientProgramme.isVaccinated %}
      <div class="app-action-link-with-description">
        {{ actionLink({
          text: __("reply.new.title"),
          href: patientProgramme.uri + "/replies/new?session_id=" + session.id + "&referrer=" + referrer
        }) }}
        {{ __("reply.new.description") | nhsukMarkdown }}
      </div>
    {% endif %}

    {{ appButtonGroup({
      buttons: [
        {
          text: __("patientSession.invite.label"),
          variant: "secondary",
          attributes: {
            formaction: patientSession.uri + "/new/invite",
            formmethod: "post"
          }
        } if options.canInvite,
        {
          text: __("remind.new.title", ((consentRemindersSent + 1) | ordinal) if consentRemindersSent else "a"),
          variant: "secondary",
          attributes: {
            formaction: patientSession.uri + "/new/remind",
            formmethod: "post"
          }
        } if options.canRemind
      ],
      description: lastConsentReminderDate
    }) }}
  {% endif %}

  {% if patientProgramme.replies | length %}
    {{ heading({
      text: __("patientProgramme.replies.label"),
      level: 3,
      size: "s"
    }) }}

    {% for reply in patientProgramme.replies %}
      {{ appReply({
        classes: "app-card--offset",
        reply: reply
      }) }}
    {% endfor %}
  {% else %}
    {{ heading({
      text: __("patientProgramme.consentRequests.label"),
      level: 3,
      size: "s"
    }) }}

    {% for consentRequest in patientProgramme.consentRequests %}
      {{ appConsentRequest({
        classes: "app-card--offset",
        consentRequest: consentRequest
      }) }}
    {% endfor %}
  {% endif %}
{% endcall %}
