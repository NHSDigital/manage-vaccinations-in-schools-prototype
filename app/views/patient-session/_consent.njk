{% from "../_macros/contact-email.njk" import appContactEmail with context %}
{% from "../_macros/contact-sms.njk" import appContactSms with context %}

{% call card({
  heading: {
    text: __("patientSession.consent.title", programme.nameSentenceCase),
    size: "m"
  }
}) %}
  {# Description #}
  {% if not patientProgramme.isVaccinated %}
    {{ patientProgramme.consentDescription | nhsukMarkdown }}

    {% if patientProgramme.patient.lastReminderDate %}
      {{ patientProgramme.patient.formatted.lastReminderDate | nhsukMarkdown }}
    {% endif %}
  {% endif %}

  {# Actions #}
  {% if not patientProgramme.isVaccinated and not patientProgramme.patient.isPost16 %}
    {{ actionLink({
      text: __("reply.new.title"),
      href: patientProgramme.uri + "/replies/new?session_id=" + session.id + "&referrer=" + referrer
    }) if not patientProgramme.isVaccinated }}

    {{ appButtonGroup({
      buttons: [
        {
          text: __("remind.new.title"),
          variant: "secondary",
          attributes: {
            formaction: patientSession.uri + "/new/remind",
            formmethod: "post"
          }
        } if options.canRemind,
        {
          text: __("patientSession.invite.label"),
          variant: "secondary",
          attributes: {
            formaction: patientSession.uri + "/new/invite",
            formmethod: "post"
          }
        }
      ]
    }) }}
  {% endif %}

  {% if patientProgramme.replies | length %}
    {# Responses to consent requests #}
    {{ heading({
      text: __("patientSession.replies.label"),
      level: 3,
      size: "s"
    }) }}

    {% for reply in patientProgramme.replies %}
      {{ summaryList({
        card: {
          classes: "app-card--compact app-card--offset",
          heading: {
            text: reply.fullNameAndRelationship,
            level: 4
          },
          href: reply.uri,
          actions: {
            items: [
              {
                text: __("reply.withdraw.label"),
                href: reply.uri + "/edit/withdraw"
              } if reply.hasGivenConsent,
              {
                text: __("reply.follow-up.label"),
                href: reply.uri + "/edit/follow-up"
              } if not reply.hasConfirmedRefusal and not reply.hasGivenConsent,
              {
                text: __("reply.invalidate.label"),
                href: reply.uri + "/edit/invalidate"
              }
            ]
          } if reply.isValid
        },
        lastRowBorder: false,
        rows: summaryRows(reply, {
          email: {},
          tel: {},
          communicationNeeds: {
            label: __("contact.communicationNeeds.label"),
            value: reply.contact.communicationNeeds
          } if reply.contact.communicationNeeds,
          createdAt: {},
          decisionStatus: {},
          vaccineCriteria: {}
        })
      }) if reply.programme_id == patientProgramme.programme_id }}
    {% endfor %}
  {% else %}
    {# Requests that have been sent but with no response yet #}
    {{ heading({
      text: __("patientSession.consentRequests.label"),
      level: 3,
      size: "s"
    }) }}

    {% for consentRequest in patientProgramme.consentRequests %}
      {# Consent request #}
      {{ summaryList({
        card: {
          classes: "app-card--compact app-card--offset",
          heading: {
            text: consentRequest.contact.fullNameAndRelationship,
            level: 4
          }
        },
        lastRowBorder: false,
        rows: summaryRows(consentRequest, {
          createdAt: {},
          email: {
            value: appContactEmail(consentRequest.contact)
          } if consentRequest.contact.email,
          tel: {
            value: appContactSms(consentRequest.contact)
          } if consentRequest.contact.tel,
          status: {}
        })
      }) }}
    {% endfor %}
  {% endif %}
{% endcall %}
