{% from "../_macros/contact-email.njk" import appContactEmail with context %}
{% from "../_macros/contact-sms.njk" import appContactSms with context %}
{% set isVaccinated = patientSession.report == PatientStatus.Vaccinated %}

{% call card({
  heading: __("patientSession.consent.title", programme.nameSentenceCase),
  headingSize: "m"
}) %}
  {# Description #}
  {% if not isVaccinated %}
    {{ patientSession.consentDescription | nhsukMarkdown }}

    {% if patientSession.patient.lastReminderDate %}
      {{ patientSession.patient.formatted.lastReminderDate | nhsukMarkdown }}
    {% endif %}
  {% endif %}

  {# Actions #}
  {% if not isVaccinated and not patientSession.patient.isPost16 %}
    {{ actionLink({
      text: __("reply.new.title"),
      href: patientSession.uri + "/replies/new?referrer=" + referrer
    }) if not isVaccinated }}

    {{ appButtonGroup({
      buttons: [{
        text: __("remind.new.title"),
        variant: "secondary",
        attributes: {
          formaction: patientSession.uri + "/new/remind",
          formmethod: "post"
        }
      } if options.canRemind, {
        text: __("patientSession.invite.label"),
        variant: "secondary",
        attributes: {
          formaction: patientSession.uri + "/new/invite",
          formmethod: "post"
        }
      }]
    }) }}
  {% endif %}

  {% if patientSession.replies | length %}
    {# Requests with responses or requests that couldn’t be delivered #}
    {{ appHeading({
      level: 3,
      size: "s",
      title: __("patientSession.replies.responses") if patientSession.responses.length > 0 else __("patientSession.replies.requests")
    }) }}

    {% for reply in patientSession.replies %}
      {{ summaryList({
        card: {
          classes: "app-card--compact app-card--offset",
          heading: reply.fullNameAndRelationship,
          headingLevel: 4,
          href: reply.uri if reply.delivered,
          actions: {
            items: [
              {
                text: __("reply.withdraw.label"),
                href: reply.uri + "/edit/withdraw"
              } if not reply.invalid and reply.given,
              {
                text: __("reply.follow-up.label"),
                href: reply.uri + "/edit/follow-up"
              } if not reply.invalid and not reply.confirmed and not reply.given,
              {
                text: __("reply.invalidate.label"),
                href: reply.uri + "/edit/invalidate"
              } if not reply.invalid
            ]
          }
        },
        lastRowBorder: false,
        rows: summaryRows(reply, {
          email: {
            value: appContactEmail(reply.contact, reply.given)
          } if reply.contact.email,
          tel: {
            value: appContactSms(reply.contact, reply.given)
          } if reply.contact.tel,
          communicationNeeds: {
            label: __("contact.communicationNeeds.label"),
            value: reply.contact.communicationNeeds
          } if reply.contact.communicationNeeds,
          createdAt: {},
          decisionStatus: {},
          vaccineCriteria: {}
        })
      }) }}
    {% endfor %}
  {% elif not patientSession.patient.hasNoContactDetails and not patientSession.patient.isPost16 %}
    {# Requests that have been sent but with no response yet #}
    {# We don’t create replies so use contact details instead #}

    {{ appHeading({
      level: 3,
      size: "s",
      title: __("patientSession.replies.pending")
    }) }}

    {% for contact in patientSession.patient.contacts %}
      {{ summaryList({
        card: {
          classes: "app-card--compact app-card--offset",
          heading: contact.fullNameAndRelationship,
          headingLevel: 4
        },
        lastRowBorder: false,
        rows: summaryRows(contact, {
          email: {},
          tel: {},
          communicationNeeds: {},
          decisionStatus: {
            label: __("reply.decisionStatus.label"),
            value: tag({
              classes: "nhsuk-tag--grey",
              text: PatientConsentStatus.Scheduled if session.consentWindow == ConsentWindow.Opening else PatientConsentStatus.NoResponse
            })
          }
        })
      }) if contact.email or contact.tel }}
    {% endfor %}
  {% endif %}
{% endcall %}

{# Health answers #}
{{ summaryList({
  card: {
    classes: "nhsuk-card--warning" if patientSession.answersNeedingTriageCount,
    heading: __mf("healthAnswers.count", {
      count: patientSession.answersNeedingTriageCount
    }),
    headingSize: "m"
  },
  classes: "app-summary-list--full-width",
  rows: healthAnswerRows(patientSession.consentHealthAnswers)
}) if patientSession.consentHealthAnswers }}
