{% call card({
  heading: __("patientSession.clinicAppointment.title") if patientSession.clinicAppointment else __("patientSession.walkIn.title"),
  headingSize: "m",
  actions: {
    items: [
      {
        text: __("patientSession.clinicAppointment.edit.label"),
        href: patientSession.clinicAppointment.uri.edit
      },
      {
        text: __("patientSession.clinicAppointment.cancel.label"),
        href: patientSession.clinicAppointment.uri.cancel
      }
    ]
  } if not session.isCancelled and patientSession.clinicAppointment
}) %}

  {% if patientSession.clinicAppointment %}
    {# Pre-booked appointment #}
    {{ summaryList({
      lastRowBorder: false,
      rows: summaryRows(patientSession.clinicAppointment, {
        child: {
          value: patient.link.fullName
        },
        date: {},
        timeSlot: {},
        programmeTags: {},
        impairments: {
          value: patientSession.clinicAppointment.child.formatted.impairments
        },
        adjustments: {
          value: patientSession.clinicAppointment.child.formatted.adjustments
        },
        contactDetails: {}
      })
    }) }}
  {% else %}
    {# Walk-in #}
    {% set programmeTagsHtml = '' %}
    {% for siblingPatientSession in patientSession.siblingPatientSessions %}
      {% set programmeTagsHtml = programmeTagsHtml + siblingPatientSession.programme.nameTag + " " %}
    {% endfor %}

    {{ summaryList({
      lastRowBorder: false,
      rows: summaryRows(patient, {
        child: {
          label: __("clinicAppointment.child.label"),
          value: patient.link.fullName
        },
        date: {
          label: __("clinicAppointment.date.label"),
          value: session.formatted.date
        },
        createdAt: {
          label: __("clinicAppointment.arrivalTime.label"),
          value: patientSession.formatted.creationTime
        },
        programmeTags: {
          label: __("clinicAppointment.programmeTags.label"),
          value: programmeTagsHtml
        },
        impairments: {},
        adjustments: {}
      })
    }) }}
  {% endif %}
{% endcall %}
