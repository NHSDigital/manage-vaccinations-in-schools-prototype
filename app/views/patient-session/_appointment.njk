{% call card({
  heading: __("patientSession.clinicAppointment.title"),
  headingSize: "m",
  actions: {
    items: [
      {
        text: __("patientSession.clinicAppointment.edit.label"),
        href: clinicAppointment.uri.edit
      },
      {
        text: __("patientSession.clinicAppointment.cancel.label"),
        href: clinicAppointment.uri.cancel
      }
    ]
  } if clinicAppointment and (session.isPlanned or session.isActive)
}) %}

  {% if patientSession.clinicAttendanceType === ClinicAttendanceType.Appointment %}
    {# Pre-booked appointment #}
    {{ summaryList({
      lastRowBorder: false,
      rows: summaryRows(clinicAppointment, {
        child: {
          value: patient.link.fullName
        },
        attendanceType: {
          label: __("patientSession.clinicAttendanceType.label"),
          value: patientSession.clinicAttendanceType
        },
        bookingReference: {
          value: clinicAppointment.booking.formatted.bookingReference
        },
        date: {},
        timeSlot: {},
        programmeTags: {},
        impairmentsUnlessNone: {
          label: __("patient.impairments.label")
        },
        adjustmentsUnlessNone: {
          label: __("patient.adjustments.label")
        },
        contactDetails: {}
      })
    }) }}
  {% else %}
    {# Drop-in #}
    {% set programmeTagsHtml = '' %}
    {% for siblingPatientSession in patientSession.siblingPatientSessions %}
      {% set programmeTagsHtml = programmeTagsHtml + siblingPatientSession.programme.nameTag + " " %}
    {% endfor %}

    {{ summaryList({
      lastRowBorder: false,
      rows: summaryRows(patient, {
        child: {
          label: __("clinicAppointment.child.label"),
          value: patient.link.fullName
        },
        attendanceType: {
          label: __("patientSession.clinicAttendanceType.label"),
          value: patientSession.clinicAttendanceType
        },
        date: {
          label: __("clinicAppointment.date.label"),
          value: session.formatted.date
        },
        createdAt: {
          label: __("clinicAppointment.arrivalTime.label"),
          value: patientSession.formatted.creationTime
        },
        programmeTags: {
          label: __("clinicAppointment.programmeTags.label"),
          value: programmeTagsHtml
        },
        impairments: {},
        adjustments: {}
      })
    }) }}
  {% endif %}
{% endcall %}
