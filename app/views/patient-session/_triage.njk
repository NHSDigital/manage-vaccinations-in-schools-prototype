{%- from "_macros/triage-form.njk" import appTriageForm with context %}
{%- from "_macros/triage-notes.njk" import appTriageNotes with context %}

{# Health answers #}
{{ summaryList({
  card: {
    heading: {
      text: __mf("healthAnswers.count", {
        count: patientProgramme.answersNeedingTriageCount
      }),
      size: "m"
    },
    variant: "warning" if patientProgramme.answersNeedingTriageCount
  },
  classes: "app-summary-list--full-width",
  rows: healthAnswerRows(patientProgramme.consentHealthAnswers)
}) if patientProgramme.consentHealthAnswers }}

{# Triage #}
{% call card({
  heading: {
    text: __("patientSession.screen.title", patientProgramme.programme.nameSentenceCase),
    size: "m"
  }
}) %}
  {# Description #}
  {{ patientProgramme.screenDescription | nhsukMarkdown }}

  {% if patientProgramme.needsTriage and not patientProgramme.consentHealthAnswers %}
    {{ heading({
      text: __("vaccine.healthQuestions.label"),
      level: 3,
      size: "s"
    }) }}

    {{ patientProgramme.vaccine.formatted.healthQuestions | nhsukMarkdown }}
  {% endif %}

  {# Actions #}
  {{ actionLink({
    text: __("triage.new.title"),
    href: patientProgramme.uri + "/new/triage?referrer=" + referrer
  }) if options.canTriage and not patientProgramme.needsTriage and not patientProgramme.isVaccinated }}

  {# Decision table #}
  {{ appTriageNotes({
    triageNotes: patientProgramme.triageNotes
  }) }}

  {% if options.canTriage and patientProgramme.needsTriage %}
    {{ appTriageForm({
      context: patientProgramme,
      size: "s"
    }) }}

    {{ button({
      text: __("triage.confirm"),
      attributes: {
        formaction: patientProgramme.uri + "/new/triage?referrer=" + referrer
      }
    }) }}
  {% endif %}
{% endcall %}
