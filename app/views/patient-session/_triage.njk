{# Health answers #}
{{ summaryList({
  card: {
    classes: "nhsuk-card--warning" if patientProgramme.answersNeedingTriageCount,
    heading: __mf("healthAnswers.count", {
      count: patientProgramme.answersNeedingTriageCount
    }),
    headingSize: "m"
  },
  classes: "app-summary-list--full-width",
  rows: healthAnswerRows(patientProgramme.consentHealthAnswers)
}) if patientProgramme.consentHealthAnswers }}

{# Triage #}
{% call card({
  heading: __("patientSession.screen.title", programme.nameSentenceCase),
  headingSize: "m"
}) %}
  {# Description #}
  {{ patientProgramme.screenDescription | nhsukMarkdown }}

  {% if options.needsTriage and not patientProgramme.consentHealthAnswers %}
    {{ appHeading({
      classes: "nhsuk-u-margin-bottom-2",
      title: __("vaccine.healthQuestions.label"),
      level: 3,
      size: "s"
    }) }}

    {{ patientProgramme.vaccine.formatted.healthQuestions | nhsukMarkdown }}
  {% endif %}

  {# Actions #}
  {{ actionLink({
    text: __("triage.new.title"),
    href: patientProgramme.uri + "/new/triage?referrer=" + referrer
  }) if options.canTriage and not options.needsTriage and not patientProgramme.isVaccinated }}

  {# Decision table #}
  {% set triageNoteRows = [] %}
  {% for triageNote in patientProgramme.triageNotes | reverse %}
    {% set triageNoteRows = triageNoteRows | push([
      {
        header: __("event.createdAt.label"),
        html: triageNote.summary.createdAtAndBy
      },
      {
        header: __("event.note.label"),
        html: triageNote.note or "—" | nhsukMarkdown
      },
      {
        header: __("event.status.label"),
        html: triageNote.formatted.status
      }
    ]) %}
  {% endfor %}

  {% if options.hasTriage %}
    {{ table({
      id: "triage-notes",
      caption: __("triage.note.label"),
      responsive: true,
      head: [
        {
          text: __("event.createdAt.label"),
          attributes: {
            width: "25%"
          }
        },
        { text: __("event.note.label") },
        {
          text: __("event.status.label"),
          attributes: {
            width: "25%"
          }
        }
      ],
      rows: triageNoteRows
    }) }}
  {% endif %}

  {% if options.needsTriage and not triageNoteRows.length %}
    <hr class="nhsuk-section-break nhsuk-section-break--visible nhsuk-section-break--l">
  {% endif %}

  {% if options.canTriage and options.needsTriage %}
    {% set psdRadiosHtml = radios({
      fieldset: { legend: { text: __("triage.psd.label") } },
      inline: true,
      items: getBooleanItems(),
      decorate: "triage.psd"
    }) if account.canPrescribe %}

    {% set delayVaccinationHtml = dateInput({
      fieldset: {
        legend: {
          text: __("triage.statusInvalidAt.title", { patient: patient }),
          size: "s"
        }
      },
      hint: { text: __("triage.statusInvalidAt.hint", { date: DelayDate }) },
      decorate: "triage.statusInvalidAt_"
    }) %}

    {% set statusItems = injectConditionalHtml(triageStatusItems(patientProgramme.screenStatusesForConsentMethod), ScreenStatus.VaccinateIntranasalOnly, psdRadiosHtml) if patientProgramme.programme.alternativeVaccine else triageStatusItems(patientProgramme.screenStatusesForConsentMethod) %}

    {{ radios({
      fieldset: {
        legend: {
          classes: "nhsuk-fieldset__legend--m nhsuk-u-font-size-22",
          text: __("triage.label", { patient: patient })
        }
      },
      hint: {
        text: patientProgramme.screenVaccineCriteria
      } if patientProgramme.screenVaccineCriteria,
      items: injectConditionalHtml(statusItems, ScreenStatus.DelayVaccination, delayVaccinationHtml),
      decorate: "triage.status"
    }) }}

    {{ textarea({
      label: {
        text: __("triage.note.label") + " (optional)"
      },
      rows: 5,
      decorate: "triage.note"
    }) }}

    {{ button({
      text: __("triage.confirm"),
      attributes: {
        formaction: patientProgramme.uri + "/new/triage?referrer=" + referrer
      }
    }) }}
  {% endif %}
{% endcall %}
