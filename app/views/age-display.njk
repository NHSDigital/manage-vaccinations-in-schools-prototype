      </tr>
      <tr class="nhsuk-table__row" role="row">
        <th scope="row" class="nhsuk-table__header" role="rowheader">4 April 2026</th>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">Exact age </span><span>1 year 0 months 20 days</span></td>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">Shown </span><span>1 year</span></td>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">What the label means </span><span>Truncated, 20 days dropped</span></td>
      </tr>
      <tr class="nhsuk-table__row" role="row">
        <th scope="row" class="nhsuk-table__header" role="rowheader">24 May 2026</th>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">Exact age </span><span>1 year 2 months 9 days</span></td>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">Shown </span><span>1 year and 2 months</span></td>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">What the label means </span><span>Truncated, 9 days dropped</span></td>
