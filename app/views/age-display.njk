        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">Shown truncated </span><span>11 months</span></td>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">Valid dose 1? </span><span>No, 10 days before the first birthday</span></td>
      </tr>
      <tr class="nhsuk-table__row" role="row">
        <th scope="row" class="nhsuk-table__header" role="rowheader">25 February 2026</th>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">Exact age </span><span>0 years 11 months 10 days</span></td>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">Shown truncated </span><span>11 months</span></td>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">Valid dose 1? </span><span>No, 18 days before the first birthday</span></td>
      </tr>
      <tr class="nhsuk-table__row" role="row">
        <th scope="row" class="nhsuk-table__header" role="rowheader">20 April 2026</th>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">Exact age </span><span>1 year 1 month 5 days</span></td>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">Shown truncated </span><span>1 year 1 month</span></td>
        <td class="nhsuk-table__cell" role="cell"><span class="nhsuk-table-responsive__heading" aria-hidden="true">Valid dose 1? </span><span>Yes, 36 days after the first birthday</span></td>
