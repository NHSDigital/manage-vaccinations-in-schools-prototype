{% extends "_layouts/form.njk" %}

{% if vaccination.outcome != VaccinationOutcome.AlreadyVaccinated %}
  {% set title = __("vaccination.isVariant.title", { patient: vaccination.patient }) %}
  {% set items = getBooleanItems() %}
{% else %}
  {% set title = __("vaccination.programme.title", { patient: vaccination.patient }) %}
  {% set items = [{
    label: "MMRV",
    value: true
  }, {
    label: "MMR",
    value: false
  }] %}
{% endif %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        html: heading({
          caption: vaccination.patient.fullName,
          text: title,
          size: "l"
        })
      }
    },
    hint: __("vaccination.isVariant.hint", {
      patient: vaccination.patient
    }) if vaccination.outcome != VaccinationOutcome.AlreadyVaccinated,
    items: items,
    decorate: "vaccination.isVariant"
  }) }}
{% endblock %}
