{% extends "_layouts/form.njk" %}

{% set confirmButtonText = __("batch.new.confirm") %}
{% set title = __("batch.new.title") %}

{% block form %}
  {{ appHeading({
    caption: vaccine.brand,
    title: title
  }) }}

  {{ input({
    label: { text: __("batch.id.label") },
    code: true,
    width: 10,
    decorate: "batch.id"
  }) }}

  {{ dateInput({
    fieldset: {
      legend: { text: __("batch.expiry.label") }
    },
    hint: { text: __("batch.expiry.hint") },
    decorate: "batch.expiry_"
  }) }}
{% endblock %}
