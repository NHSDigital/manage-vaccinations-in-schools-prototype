{%- from "nhsuk/macros/attributes.njk" import nhsukAttributes -%}
{%- from "_macros/badge.njk" import appBadge -%}

{% macro appSectionNavigation(params) %}
{#- Set classes for this component #}
{%- set classNames = "app-section-navigation" -%}

{%- if params.vertical and (not params.classes or not "app-section-navigation--vertical" in params.classes) %}
  {%- set classNames = classNames ~ " app-section-navigation--vertical" -%}
{%- endif -%}

{%- if params.small and (not params.classes or not "app-section-navigation--small" in params.classes) %}
  {%- set classNames = classNames ~ " app-section-navigation--small" -%}
{%- endif -%}

{%- if params.classes %}
  {%- set classNames = classNames ~ " " ~ params.classes -%}
{%- endif -%}

<nav class="{{ classNames }}" {%- if params.id %} id="{{ params.id }}"{% endif %}
  data-module="app-section-navigation"
  {%- if params.labelledBy %} aria-labelledby="{{ params.labelledBy }}"
  {%- else %} aria-label="{{ params.label | default("Section navigation") }}"
  {%- endif %}
  {{- nhsukAttributes(params.attributes) }}>
  <ul class="app-section-navigation__list">
  {% for item in params.items -%}
    {%- if item -%}
    {%- set itemInnerAttributesHtml %}
      {{- nhsukAttributes({
        href: {
          value: item.href,
          optional: true
        },
        "aria-current": {
          value: "page" if item.current else false,
          optional: true
        }
      }) -}}
    {%- endset -%}

    {%- set itemBadgeHtml -%}
      {%- if item.badge is defined -%}
        <span class="app-section-navigation__suffix">{{ appBadge(item.badge) }}</span>
      {%- endif -%}
    {%- endset -%}

    {%- set itemInnerContent %}
      {% if item.current -%}
        {#- Wrap active item in strong element so users who override colours
          or styles still have some indicator of the current nav item. -#}
        <strong class="app-section-navigation__current">
          {{- item.html | safe if item.html else item.text -}}
          {{- itemBadgeHtml | safe -}}
        </strong>
      {%- else -%}
        {{- item.html | safe if item.html else item.text -}}
        {{- itemBadgeHtml | safe -}}
      {%- endif -%}
    {%- endset %}

    <li class="app-section-navigation__item{%- if item.current %} app-section-navigation__item--current{%- endif -%}{%- if item.classes %} {{ item.classes }}{%- endif -%}"
      {{- nhsukAttributes(item.attributes) }}>
      {% if item.href %}
      <a class="app-section-navigation__link" {{- itemInnerAttributesHtml | safe }}>
        {{- itemInnerContent | safe -}}
      </a>
      {% else %}
      <span class="app-section-navigation__text" {{- itemInnerAttributesHtml | safe }}>
        {{- itemInnerContent | safe -}}
      </span>
      {% endif %}
    </li>
    {% endif %}
  {%- endfor %}
  </ul>
</nav>
{% endmacro %}
