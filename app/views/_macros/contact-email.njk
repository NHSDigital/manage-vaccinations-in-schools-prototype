{%- from "_macros/status.njk" import appStatus -%}
{% macro appContactEmail(contact) -%}
  <p class="nhsuk-body nhsuk-u-margin-0">{{ contact.email }}</p>
  {{ appStatus({
    classes: "app-status--small nhsuk-u-margin-top-1",
    text: contact.emailStatus,
    icon: "warning",
    colour: "blue"
  }) if contact.emailStatus != NotifyEmailStatus.Delivered }}
{% endmacro %}
