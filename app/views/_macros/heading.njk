{%- from "nhsuk/macros/attributes.njk" import nhsukAttributes -%}
{% macro appHeading(params) -%}
{%- set level = params.level or 1 -%}
{%- set size = params.size or "l" -%}
<h{{level}} class="nhsuk-heading-{{ size }}{%- if params.classes %} {{ params.classes }}{% endif %}"
  {{- nhsukAttributes(params.attributes) }}>
  {%- if params.caption -%}
  <span class="nhsuk-caption-{{ size }}">{{ params.caption }}</span>
  {%- endif -%}
  {{ params.title | safe }}
</h{{level}}>
{%- if params.summary -%}
<p class="nhsuk-caption-{{ size }} nhsuk-u-margin-bottom-4">
  {{ params.summary }}
</p>
{%- endif -%}
{%- endmacro %}
