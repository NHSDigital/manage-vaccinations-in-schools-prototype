{%- from "x-nhsuk/decorated/date-input/macro.njk" import dateInput with context %}
{%- from "x-nhsuk/decorated/radios/macro.njk" import radios with context %}
{%- from "x-nhsuk/decorated/textarea/macro.njk" import textarea with context %}

{#
  params:
    - context
      - patient
      - programme
      - screenStatusesForConsentMethod
    - session (the session the child is being triaged for, if any)
    - size
#}
{% macro appTriageForm(params) %}
  {% set delayVaccinationHtml = dateInput({
    fieldset: {
      legend: __("triage.statusInvalidAt.title", {
        patient: params.context.patient
      })
    },
    hint: __("triage.statusInvalidAt.hint", { date: DelayDate }),
    decorate: "triage.statusInvalidAt_"
  }) %}

  {% set statusItems = triageStatusItems(params.context.screenStatusesForConsentMethod) %}

  {# Ask about a PSD for each outcome the session can use one for. Each outcome has its
     own answer, so only the answer for the chosen outcome is used #}
  {% if account.canPrescribe %}
    {% set psdScreenStatuses = params.context.getPsdScreenStatusesForSession(params.session) %}
    {% for screenStatusKey, screenStatus in ScreenStatus %}
      {% if screenStatus in psdScreenStatuses %}
        {% set psdRadiosHtml = radios({
          fieldset: {
            legend: __("triage.psd.label")
          },
          inline: true,
          items: getBooleanItems(),
          decorate: "triage.psd." + screenStatusKey
        }) %}
        {% set statusItems = injectConditionalHtml(statusItems, screenStatus, psdRadiosHtml) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {{ radios({
    fieldset: {
      legend: {
        classes: "nhsuk-u-font-size-22" if params.size == "s",
        text: __("triage.status.label", {
          patient: params.context.patient
        }),
        size: params.size or "m"
      }
    },
    hint: params.context.screenVaccineCriteria,
    items: injectConditionalHtml(statusItems, ScreenStatus.DelayVaccination, delayVaccinationHtml),
    decorate: "triage.status"
  }) }}

  {{ textarea({
    label: {
      classes: "nhsuk-u-font-size-22" if params.size == "s",
      text: __("triage.note.label") + " (optional)",
      size: params.size or "m"
    },
    rows: 5,
    decorate: "triage.note"
  }) }}
{% endmacro %}
