{%- from "x-nhsuk/decorated/date-input/macro.njk" import dateInput with context %}
{%- from "x-nhsuk/decorated/radios/macro.njk" import radios with context %}
{%- from "x-nhsuk/decorated/textarea/macro.njk" import textarea with context %}

{% macro appTriageForm(params) %}
  {% set psdRadiosHtml = radios({
    fieldset: {
      legend: {
        text: __("triage.psd.label")
      }
    },
    inline: true,
    items: getBooleanItems(),
    decorate: "triage.psd"
  }) if account.canPrescribe %}

  {% set delayVaccinationHtml = dateInput({
    fieldset: {
      legend: {
        text: __("triage.statusInvalidAt.title", {
          patient: params.context.patient
        })
      }
    },
    hint: {
      text: __("triage.statusInvalidAt.hint", { date: DelayDate })
    },
    decorate: "triage.statusInvalidAt_"
  }) %}

  {% set statusItems = injectConditionalHtml(triageStatusItems(params.context.screenStatusesForConsentMethod), ScreenStatus.VaccinateIntranasalOnly, psdRadiosHtml) if params.context.programme.alternativeVaccine else triageStatusItems(params.context.screenStatusesForConsentMethod) %}

  {{ radios({
    fieldset: {
      legend: {
        classes: "nhsuk-u-font-size-22" if params.size == "s",
        text: __("triage.status.label", {
          patient: params.context.patient
        }),
        size: params.size or "m"
      }
    },
    hint: {
      text: params.context.screenVaccineCriteria
    } if params.context.screenVaccineCriteria,
    items: injectConditionalHtml(statusItems, ScreenStatus.DelayVaccination, delayVaccinationHtml),
    decorate: "triage.status"
  }) }}

  {{ textarea({
    label: {
      classes: "nhsuk-u-font-size-22" if params.size == "s",
      text: __("triage.note.label") + " (optional)",
      size: params.size or "m"
    },
    rows: 5,
    decorate: "triage.note"
  }) }}
{% endmacro %}
