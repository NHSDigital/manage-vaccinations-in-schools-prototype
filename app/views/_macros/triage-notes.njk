{%- from "nhsuk/components/tables/macro.njk" import table with context -%}

{% macro appTriageNotes(params) %}
  {% set triageNoteRows = [] %}
  {% for triageNote in params.triageNotes | reverse %}
    {% set validityDescription = params.patientProgramme.getTriageValidityDescription(triageNote) if params.patientProgramme %}
    {% set triageNoteRows = triageNoteRows | push([
      {
        html: triageNote.summary.createdAtAndBy
      },
      {
        html: triageNote.note or "—" | nhsukMarkdown
      },
      {
        html: triageNote.formatted.status + ("<br><span class=\"nhsuk-u-secondary-text-colour nhsuk-u-font-size-16\">" + validityDescription + "</span>" if validityDescription else "")
      }
    ]) %}
  {% endfor %}

  {% if triageNoteRows | length %}
    {{ table({
      id: params.id or "triage-notes",
      caption: params.caption or __("triage.note.label"),
      responsive: true,
      head: [
        {
          text: __("event.createdAt.label"),
          width: "one-quarter"
        },
        { text: __("event.note.label") },
        {
          text: __("event.status.label"),
          width: "one-quarter"
        }
      ],
      rows: triageNoteRows
    }) }}
  {% endif %}
{% endmacro %}
