{% extends "_layouts/default.njk" %}

{% set title = researchSession.title %}

{% block main %}
  <div class="nhsuk-width-container">
    <main class="nhsuk-main-wrapper" id="maincontent" role="main">
      {{ heading({
        text: title,
        size: "l"
      }) }}

      {{ researchSession.description | nhsukMarkdown }}

      {% if taskLinkGroups.length > 0 %}
        {% for taskLinkGroup in taskLinkGroups %}
          {% if taskLinkGroup.heading %}
            {{ heading({
              text: taskLinkGroup.heading,
              level: 2,
              size: "m"
            }) }}
          {% endif %}
          <ul class="nhsuk-list nhsuk-list--bullet">
            {% for taskLink in taskLinkGroup.links %}
              <li>{{ link({
                text: taskLink.label,
                href: taskLink.href
              }) }}</li>
            {% endfor %}
          </ul>
        {% endfor %}
      {% else %}
        {{ "No links have been added to this research session yet." | nhsukMarkdown }}
      {% endif %}
    </main>
  </div>
{% endblock %}
