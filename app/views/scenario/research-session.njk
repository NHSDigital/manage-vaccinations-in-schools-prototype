{% extends "_layouts/default.njk" %}

{% set title = researchSession.title %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [
      {
        text: __("home.show.title"),
        href: "/"
      },
      {
        text: __("scenario.breadcrumb.scenarios"),
        href: "/scenarios"
      },
      {
        text: __("scenario.breadcrumb.sessions"),
        href: "/scenarios/research"
      }
    ]
  }) }}
{% endblock %}

{% block content %}
  {{ heading({
    text: title,
    size: "l",
    caption: {
      text: "Research starting: " + researchSession.startDate | formatDate,
      placement: "after"
    }
  }) }}

  {{ researchSession.description | nhsukMarkdown }}

  {% if taskLinkGroups.length > 0 %}
    {% for taskLinkGroup in taskLinkGroups %}
      {% if taskLinkGroup.heading %}
        {{ heading({
          text: taskLinkGroup.heading,
          level: 2,
          size: "m"
        }) }}
      {% endif %}
      <ul class="nhsuk-list nhsuk-list--bullet">
        {% for taskLink in taskLinkGroup.links %}
          <li>{{ link({
            text: taskLink.label,
            href: taskLink.href
          }) }}</li>
        {% endfor %}
      </ul>
    {% endfor %}
  {% else %}
    {{ "No links have been added to this research session yet." | nhsukMarkdown }}
  {% endif %}
{% endblock %}
