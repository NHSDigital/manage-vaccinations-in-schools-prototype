{% extends "_layouts/form.njk" %}

{% set title = __("healthQuestions." + key + ".label") %}
{% set vaccineName = "nasal spray flu" if "Flu" in session.presetNames else "MMR" %}

{% block form %}
  {% call fieldset({
    legend: {
      isPageHeading: true,
      text: title | replace("the child", "your child"),
      size: "l"
    }
  }) %}
    {% if __("healthQuestions." + key + ".options") %}
    <ul class="nhsuk-list nhsuk-list--bullet">
      {% for option in __("healthQuestions." + key + ".options") %}
        <li>{{ option }}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {{ radios({
      hint: __("healthQuestions." + key + ".hint", vaccineName),
      items: [
        {
          label: __("consent.healthAnswers.yes"),
          conditional: {
            html: textarea({
              label: __("consent.healthAnswers.details"),
              hint: __("healthQuestions." + key + ".detailsHint"),
              decorate: ["consent", "healthAnswers", key, "details"]
            })
          } if not hasSubQuestions
        },
        {
          label: __("consent.healthAnswers.no")
        }
      ],
      decorate: ["consent", "healthAnswers", key, "answer"]
    }) }}
  {% endcall %}
{% endblock %}
