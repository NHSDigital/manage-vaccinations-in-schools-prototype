{% extends "_layouts/form.njk" %}

{% set title = __("consent.child.home-educated.title") %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        isPageHeading: true,
        text: title,
        size: "l"
      }
    },
    items: [{
      label: __("consent.child.home-educated.yes"),
      value: "yes"
    }, {
      label: __("consent.child.home-educated.no"),
      value: "no"
    }],
    decorate: "consent.child.homeEducated"
  }) }}
{% endblock %}
