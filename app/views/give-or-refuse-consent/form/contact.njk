{% extends "_layouts/form.njk" %}

{% set title = __("consent.contactRelationship.title") %}
{% set showContactDetails = true if not consent.patient.isSensitive else false %}

{% block form %}
  {{ heading({
    text: title,
    size: "l"
  }) }}

  {{ input({
    label: __("consent.contactRelationship.fullName.label"),
    decorate: "consent.contactRelationship_.fullName"
  }) }}

  {%- set fosterCarerHtml = radios({
    fieldset: {
      legend: __("consent.contactRelationship.hasParentalResponsibility.delegatedLabel")
    },
    hint: __("consent.contactRelationship.hasParentalResponsibility.hint"),
    items: getBooleanItems(),
    decorate: "consent.contactRelationship_.hasParentalResponsibility"
  }) %}

  {%- set guardianHtml = radios({
    fieldset: {
      legend: __("consent.contactRelationship.hasParentalResponsibility.label")
    },
    hint: __("consent.contactRelationship.hasParentalResponsibility.hint"),
    items: getBooleanItems(),
    decorate: "consent.contactRelationship_.hasParentalResponsibility"
  }) %}

  {%- set otherHtml = input({
    label: __("consent.contactRelationship.relationshipOther.label"),
    decorate: "consent.contactRelationship_.relationshipOther"
  }) + radios({
    fieldset: {
      legend: __("consent.contactRelationship.hasParentalResponsibility.label")
    },
    hint: __("consent.contactRelationship.hasParentalResponsibility.hint"),
    items: getBooleanItems(),
    decorate: "consent.contactRelationship_.hasParentalResponsibility"
  }) %}

  {# Add conditional html for ‘Foster carer’ option #}
  {% set items = injectConditionalHtml(parentalRelationshipItems, RelationshipType.Fosterer, fosterCarerHtml) %}

  {# Add conditional html for ‘Guardian’ option #}
  {% set items = injectConditionalHtml(items, RelationshipType.Guardian, guardianHtml) %}

  {# Add conditional html for ‘Other’ option #}
  {% set items = injectConditionalHtml(items, RelationshipType.Other, otherHtml) %}

  {{ radios({
    fieldset: {
      legend: __("consent.contactRelationship.relationship.label")
    },
    items: items,
    decorate: "consent.contactRelationship_.relationship"
  }) }}

  {{ input({
    label: __("consent.contactRelationship.email.label"),
    hint: __("consent.contactRelationship.email.hint"),
    decorate: "consent.contactRelationship_.email"
  }) if showContactDetails }}

  {{ input({
    label: __("consent.contactRelationship.tel.label") + " (optional)",
    hint: __("consent.contactRelationship.tel.hint"),
    decorate: "consent.contactRelationship_.tel"
  }) if showContactDetails }}

  {{ checkboxes({
    items: [
      {
        label: __("consent.contactRelationship.canSms.label"),
        value: true
      }
    ],
    decorate: "consent.contactRelationship_.canSms"
  }) if showContactDetails }}
{% endblock %}
