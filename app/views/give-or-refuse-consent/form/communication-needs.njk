{% extends "_layouts/form.njk" %}

{% set title = __("consent.hasCommunicationNeeds.title") %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        heading: __("consent.hasCommunicationNeeds.title"),
        size: "l"
      }
    },
    hint: __("consent.hasCommunicationNeeds.hint"),
    items: [
      {
        label: __("consent.hasCommunicationNeeds.yes"),
        value: true,
        conditional: {
          html: textarea({
            label: __("consent.communicationNeeds.title"),
            decorate: "consent.communicationNeeds"
          })
        }
      },
      {
        label: __("consent.hasCommunicationNeeds.no"),
        value: false
      }
    ],
    decorate: "consent.hasCommunicationNeeds"
  }) }}
{% endblock %}
