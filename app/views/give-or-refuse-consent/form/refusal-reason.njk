{% extends "_layouts/form.njk" %}

{% if consent.decision == ReplyDecision.OnlyMenACWY %}
  {% set title = __("consent.refusalReason.title", "Td/IPV vaccination") %}
  {% set vaccinations = 1 %}
{% elif consent.decision == ReplyDecision.OnlyTdIPV %}
  {% set title = __("consent.refusalReason.title", "MenACWY vaccination") %}
  {% set vaccinations = 1 %}
{% else %}
  {% set title = __("consent.refusalReason.title", { session: session }) %}
  {% set vaccinations = session.programmes.length %}
{% endif %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        isPageHeading: true,
        text: title,
        size: "l"
      }
    },
    items: [
      {
        label: __n("consent.refusalReason.alreadyVaccinatedMMR"),
        value: ReplyRefusal.AlreadyVaccinatedMMR
      } if SessionPresetName.MMR in session.presetNames else {
        label: __n("consent.refusalReason.alreadyVaccinated", vaccinations),
        value: ReplyRefusal.AlreadyVaccinated
      },
      {
        label: __n("consent.refusalReason.gettingElsewhere", vaccinations),
        value: ReplyRefusal.GettingElsewhere
      },
      {
        label: ReplyRefusal.OutsideSchool
      },
      {
        label: ReplyRefusal.Gelatine
      } if vaccineIncludesGelatine and SessionPresetName.Flu in session.presetNames,
      {
        label: ReplyRefusal.GelatineMMR
      } if vaccineIncludesGelatine and SessionPresetName.MMR in session.presetNames,
      {
        label: ReplyRefusal.Medical
      },
      {
        label: ReplyRefusal.Personal
      },
      {
        divider: "or"
      },
      {
        label: ReplyRefusal.Other,
        conditional: {
          html: input({
            label: __("consent.refusalReason.label"),
            decorate: "consent.refusalReasonOther"
          })
        }
      }
    ],
    decorate: "consent.refusalReason"
  }) }}
{% endblock %}
