{% extends "template-with-imports.njk" %}

{#- Decorated components -#}
{%- from "x-nhsuk/decorated/button/macro.njk" import button with context %}
{%- from "x-nhsuk/decorated/character-count/macro.njk" import characterCount with context %}
{%- from "x-nhsuk/decorated/checkboxes/macro.njk" import checkboxes with context %}
{%- from "x-nhsuk/decorated/date-input/macro.njk" import dateInput with context %}
{%- from "x-nhsuk/decorated/file-upload/macro.njk" import fileUpload with context %}
{%- from "x-nhsuk/decorated/input/macro.njk" import input with context %}
{%- from "x-nhsuk/decorated/password-input/macro.njk" import passwordInput with context %}
{%- from "x-nhsuk/decorated/radios/macro.njk" import radios with context %}
{%- from "x-nhsuk/decorated/select/macro.njk" import select with context %}
{%- from "x-nhsuk/decorated/textarea/macro.njk" import textarea with context %}

{#- Application macros -#}
{%- from "_macros/action-list.njk" import appActionList %}
{%- from "_macros/add-another.njk" import appAddAnother %}
{%- from "_macros/button-group.njk" import appButtonGroup with context %}
{%- from "_macros/count.njk" import appCount %}
{%- from "_macros/data-card.njk" import appDataCard with context %}
{%- from "_macros/environment.njk" import appEnvironment %}
{%- from "_macros/event.njk" import appEvent %}
{%- from "_macros/heading.njk" import appHeading %}
{%- from "_macros/secondary-navigation.njk" import appSecondaryNavigation %}
{%- from "_macros/status.njk" import appStatus %}
{%- from "_macros/timeline.njk" import appTimeline with context %}
{%- from "_macros/sub-navigation.njk" import appSubNavigation %}

{% set assetsName = assetsName | default("application") %}

{% block pageTitle -%}
  {%- if errors === true or (errors | length) %}Error: {% endif -%}
  {%- if pageName %}{{ pageName }} – {% endif -%}
  {{ serviceName }} – NHS
{%- endblock %}

{% block head %}
  {# Prevent NHS numbers from being treated as phone numbers #}
  <meta name="format-detection" content="telephone=no">

  <link href="/assets/stylesheets/{{ assetsName }}.css" rel="stylesheet" media="all">
  <script src="/assets/javascripts/{{ assetsName }}.js" type="module"></script>
{% endblock %}

{% block header %}
  {{ appEnvironment(environment) if environment }}
  {{ header(headerOptions if headerOptions else {
    service: {
      text: serviceName,
      href: "/home"
    },
    navigation: {
      items: [
        {
          href: "/schools",
          text: __("school.list.label"),
          active: navigation.activeSection == "schools"
        },
        {
          href: "/patients",
          text: __("patient.list.label"),
          active: navigation.activeSection == "patients"
        },
        {
          href: "/sessions",
          text: __("session.list.label"),
          active: navigation.activeSection == "sessions"
        },
        {
          classes: "app-header__navigation-item--with-count",
          href: "/reviews",
          html: __("review.list.label") + appCount(data.counts.review),
          active: navigation.activeSection == "reviews"
        },
        {
          href: "/reports",
          text: __("report.list.label"),
          active: navigation.activeSection == "reports"
        },
        {
          href: "/uploads",
          text: __("upload.list.label"),
          active: navigation.activeSection == "uploads"
        },
        {
          href: "/downloads",
          text: __("download.list.label"),
          active: navigation.activeSection == "downloads"
        },
        {
          href: "/vaccines",
          text: __("vaccine.list.label"),
          active: navigation.activeSection == "vaccines"
        },
        {
          href: team.uri,
          text: __("team.show.label"),
          active: navigation.activeSection == "teams"
        }
      ]
    } if account.role != UserRole.DataConsumer,
    account: {
      items: [
        {
          text: account.nameAndRole,
          icon: true
        },
        {
          href: "/account/change-role?referrer=" + navigation.referrer,
          text: __("account.change-role.label")
        },
        {
          href: "/account/sign-out",
          text: __("account.sign-out.title")
        }
      ] if account.role else [
        {
          text: __("account.sign-in.title"),
          href: "/"
        }
      ]
    }
  }) }}
{% endblock %}

{% block beforeContent %}
  {{ backLink({ href: paths.back or back }) if paths.back or back }}
{% endblock %}

{% block content %}
  {{ notificationBanner(success) if success }}
  {{ notificationBanner(message) if message }}
{% endblock %}

{% block footer %}
  {{ footer({
    meta: {
      text: "Today is " + today,
      items: [{
        text: "Homepage",
        href: "/"
      }, {
        text: "Activity log items",
        href: "/activity"
      }, {
        text: "CIS2 users",
        href: "/users"
      }, {
        text: "Reset data",
        href: "/reset"
      }, {
        text: "Design history",
        href: "https://design-history.prevention-services.nhs.uk/manage-vaccinations-in-schools/"
      }]
    }
  }) }}
{% endblock %}
