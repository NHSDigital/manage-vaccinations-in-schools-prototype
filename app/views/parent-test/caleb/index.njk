{% extends "_layouts/default.njk" %}

{% block content %}
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
      <h1 class="nhsuk-heading-l nhsuk-u-margin-bottom-2">Caleb Osei</h1>
      <p class="nhsuk-caption-l nhsuk-u-margin-bottom-4">
        <strong>Date of birth:</strong> 20 March 2020 (aged 6)
      </p>

      <h2 class="nhsuk-heading-l">Vaccination overview</h2>

      <div class="nhsuk-warning-callout">
        <h3 class="nhsuk-warning-callout__label">
          <span role="text">
            <span class="nhsuk-u-visually-hidden">Important: </span>
            May be missing a dose
          </span>
        </h3>
        <p>Caleb may be missing a dose of the MMR (measles, mumps, and rubella) vaccine.</p>
        <p><a href="/parent-test/caleb/mmr">View Caleb’s MMR record</a></p>
      </div>
      <p><a href="#you-are-here">View Caleb’s next vaccination due</a></p>

      <h3>Under 1</h3>
      <h4>8 weeks</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>6-in-1 (1st dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for 6-in-1 1st dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>Rotavirus (1st dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for Rotavirus 1st dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>MenB (1st dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for MenB 1st dose</span></a></li>
      </ul>
      <h4>12 weeks</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>6-in-1 (2nd dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for 6-in-1 2nd dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>MenB (2nd dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for MenB 2nd dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>Rotavirus (2nd dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for Rotavirus 2nd dose</span></a></li>
      </ul>
      <h4>16 weeks</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>6-in-1 (3rd dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for 6-in-1 3rd dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>Pneumococcal (1st dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for Pneumococcal 1st dose</span></a></li>
      </ul>
      <hr class="nhsuk-section-break nhsuk-section-break--l nhsuk-section-break--visible">

      <h3>Aged 1 to 15</h3>
      <h4>1 year</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>MMR (1st dose) <a href="/parent-test/caleb/mmr">View details<span class="nhsuk-u-visually-hidden"> for MMR 1st dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>Pneumococcal (2nd dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for Pneumococcal 2nd dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>MenB <a href="#">View details<span class="nhsuk-u-visually-hidden"> for MenB vaccine</span></a></li>
      </ul>
      <h4>2 years</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>Children’s flu vaccine (every year until children finish Year 11 of secondary school) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for Children’s flu vaccine</span></a></li>
      </ul>
      <h4>3 years and 4 months</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>4-in-1 pre-school booster <a href="#">View details<span class="nhsuk-u-visually-hidden"> for 4-in-1 pre-school booster vaccine</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--cross" style="fill:#d5281b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M17 18.5c-.4 0-.8-.1-1.1-.4l-10-10c-.6-.6-.6-1.6 0-2.1.6-.6 1.5-.6 2.1 0l10 10c.6.6.6 1.5 0 2.1-.3.3-.6.4-1 .4z M7 18.5c-.4 0-.8-.1-1.1-.4-.6-.6-.6-1.5 0-2.1l10-10c.6-.6 1.5-.6 2.1 0 .6.6.6 1.5 0 2.1l-10 10c-.3.3-.6.4-1 .4z"/></svg> <span class="nhsuk-u-visually-hidden">Not given. </span>MMR (2nd dose) <a href="/parent-test/caleb/mmr">View details<span class="nhsuk-u-visually-hidden"> for MMR 2nd dose</span></a></li>
      </ul>

      <!-- Placeholder marker. Final design for the "child is here" indicator is a
           separate future work piece. Do not treat this styling as final. -->
      <div id="you-are-here" tabindex="-1" class="nhsuk-u-margin-bottom-4" style="display: flex; align-items: flex-start; background-color: #005eb8; color: #ffffff; padding: 24px 24px;">
        <span aria-hidden="true" style="display: inline-block; width: 0; height: 0; border-top: 8px solid transparent; border-bottom: 8px solid transparent; border-right: 10px solid #ffffff; margin-right: 12px; margin-top: 4px;"></span>
        <div>
          <p class="nhsuk-u-margin-bottom-3"><strong>Caleb, 6 years old</strong></p>
          <p class="nhsuk-u-margin-bottom-3">Next vaccination: MMR, 2nd dose, overdue since 3 years 4 months</p>
          <p class="nhsuk-u-margin-bottom-0"><a class="nhsuk-link--reverse" href="/parent-test/caleb/mmr">View Caleb’s MMR record</a></p>
        </div>
      </div>

      <h4>12 to 13 years</h4>
      <ul class="nhsuk-list">
        <li><span style="display:inline-block;width:24px;vertical-align:middle;"></span> <span class="nhsuk-u-visually-hidden">Not due yet. </span>HPV</li>
      </ul>
      <h4>14 years</h4>
      <ul class="nhsuk-list">
        <li><span style="display:inline-block;width:24px;vertical-align:middle;"></span> <span class="nhsuk-u-visually-hidden">Not due yet. </span>Td/IPV (3-in-1 teenage booster)</li>
        <li><span style="display:inline-block;width:24px;vertical-align:middle;"></span> <span class="nhsuk-u-visually-hidden">Not due yet. </span>MenACWY</li>
      </ul>

      <a class="nhsuk-back-link" href="/parent-test/">
        Back to scenarios
      </a>
    </div>
  </div>
{% endblock %}
