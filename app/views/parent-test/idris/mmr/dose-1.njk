{% extends "_layouts/default.njk" %}

{% block content %}
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
      <nav class="nhsuk-breadcrumb nhsuk-u-margin-bottom-3" aria-label="Breadcrumb">
        <ol class="nhsuk-breadcrumb__list">
          <li class="nhsuk-breadcrumb__list-item">
            <a class="nhsuk-breadcrumb__link" href="/parent-test/idris">Overview</a>
          </li>
          <li class="nhsuk-breadcrumb__list-item">
            <a class="nhsuk-breadcrumb__link" href="/parent-test/idris/mmr">MMRV</a>
          </li>
          <li class="nhsuk-breadcrumb__list-item" aria-current="page">1st dose</li>
        </ol>
      </nav>

      <h1 class="nhsuk-heading-l nhsuk-u-margin-bottom-2">Idris Marsh</h1>
      <p class="nhsuk-caption-l nhsuk-u-margin-bottom-4">
        <strong>Date of birth:</strong> 10 March 2025 (aged 15 months)
      </p>

      <h2 class="nhsuk-heading-m">Vaccination details</h2>
      <div class="nhsuk-card">
        <div class="nhsuk-card__content">
          <dl class="nhsuk-summary-list">
            <div class="nhsuk-summary-list__row nhsuk-summary-list__row--no-actions">
              <dt class="nhsuk-summary-list__key">Date</dt>
              <dd class="nhsuk-summary-list__value">12 March 2026</dd>
            </div>
            <div class="nhsuk-summary-list__row nhsuk-summary-list__row--no-actions">
              <dt class="nhsuk-summary-list__key">Location</dt>
              <dd class="nhsuk-summary-list__value">Church Lane Surgery</dd>
            </div>
            <div class="nhsuk-summary-list__row nhsuk-summary-list__row--no-actions">
              <dt class="nhsuk-summary-list__key">Target disease(s)</dt>
              <dd class="nhsuk-summary-list__value">Measles, Mumps, Rubella, Chickenpox</dd>
            </div>
            <div class="nhsuk-summary-list__row nhsuk-summary-list__row--no-actions">
              <dt class="nhsuk-summary-list__key">Programme</dt>
              <dd class="nhsuk-summary-list__value">MMRV</dd>
            </div>
            <div class="nhsuk-summary-list__row nhsuk-summary-list__row--no-actions nhsuk-summary-list__row--no-border">
              <dt class="nhsuk-summary-list__key">Dose number</dt>
              <dd class="nhsuk-summary-list__value">1 of 2</dd>
            </div>
          </dl>
        </div>
      </div>

      <details class="nhsuk-details nhsuk-expander">
        <summary class="nhsuk-details__summary">
          <span class="nhsuk-details__summary-text">
            Show technical details
          </span>
        </summary>
        <div class="nhsuk-details__text">
          <dl class="nhsuk-summary-list">
            <div class="nhsuk-summary-list__row nhsuk-summary-list__row--no-actions">
              <dt class="nhsuk-summary-list__key">Source</dt>
              <dd class="nhsuk-summary-list__value">GP record</dd>
            </div>
            <div class="nhsuk-summary-list__row nhsuk-summary-list__row--no-actions">
              <dt class="nhsuk-summary-list__key">Product</dt>
              <dd class="nhsuk-summary-list__value">Priorix-Tetra</dd>
            </div>
            <div class="nhsuk-summary-list__row nhsuk-summary-list__row--no-actions">
              <dt class="nhsuk-summary-list__key">Batch number</dt>
              <dd class="nhsuk-summary-list__value">T340A26</dd>
            </div>
            <div class="nhsuk-summary-list__row nhsuk-summary-list__row--no-actions">
              <dt class="nhsuk-summary-list__key">Batch expiry</dt>
              <dd class="nhsuk-summary-list__value"></dd>
            </div>
            <div class="nhsuk-summary-list__row nhsuk-summary-list__row--no-actions">
              <dt class="nhsuk-summary-list__key">Dose volume</dt>
              <dd class="nhsuk-summary-list__value">0.5ml</dd>
            </div>
            <div class="nhsuk-summary-list__row nhsuk-summary-list__row--no-actions">
              <dt class="nhsuk-summary-list__key">Method</dt>
              <dd class="nhsuk-summary-list__value">Injection</dd>
            </div>
            <div class="nhsuk-summary-list__row nhsuk-summary-list__row--no-actions nhsuk-summary-list__row--no-border">
              <dt class="nhsuk-summary-list__key">Site</dt>
              <dd class="nhsuk-summary-list__value">Right upper arm</dd>
            </div>
          </dl>
        </div>
      </details>
    </div>
  </div>
{% endblock %}
