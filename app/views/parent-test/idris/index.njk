{% extends "_layouts/default.njk" %}

{% block content %}
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
      <h1 class="nhsuk-heading-l nhsuk-u-margin-bottom-2">Idris Marsh</h1>
      <p class="nhsuk-caption-l nhsuk-u-margin-bottom-4">
        <strong>Date of birth:</strong> 10 March 2025 (aged 15 months)
      </p>

      <h2 class="nhsuk-heading-l">Vaccination overview</h2>

      <div class="nhsuk-panel" style="background-color: #007f3b;">
        <h4 class="nhsuk-u-margin-bottom-3"><strong><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#ffffff;width:28px;height:28px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> Up to date</strong></h4>
        <p class="nhsuk-u-margin-bottom-0">Idris is up to date with the usual vaccinations for their age</p>
      </div>
      <p><a href="#you-are-here">View Idris’s next vaccination due</a></p>

      <h3>Under 1</h3>
      <h4>8 weeks</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>6-in-1 vaccine (1st dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for 6-in-1 1st dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>Rotavirus vaccine (1st dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for Rotavirus 1st dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>MenB vaccine (1st dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for MenB 1st dose</span></a></li>
      </ul>
      <h4>12 weeks</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>6-in-1 vaccine (2nd dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for 6-in-1 2nd dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>MenB vaccine (2nd dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for MenB 2nd dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>Rotavirus vaccine (2nd dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for Rotavirus 2nd dose</span></a></li>
      </ul>
      <h4>16 weeks</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>6-in-1 vaccine (3rd dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for 6-in-1 3rd dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>Pneumococcal vaccine (1st dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for Pneumococcal 1st dose</span></a></li>
      </ul>
      <hr class="nhsuk-section-break nhsuk-section-break--l nhsuk-section-break--visible">

      <h3>Aged 1 to 15 years</h3>
      <h4>1 year</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>MMRV vaccine (1st dose) <a href="/parent-test/idris/mmr">View details<span class="nhsuk-u-visually-hidden"> for MMRV 1st dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>Pneumococcal vaccine (2nd dose) <a href="#">View details<span class="nhsuk-u-visually-hidden"> for Pneumococcal 2nd dose</span></a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> <span class="nhsuk-u-visually-hidden">Given. </span>MenB vaccine <a href="#">View details<span class="nhsuk-u-visually-hidden"> for MenB vaccine</span></a></li>
      </ul>

      <!-- Placeholder marker. Final design for the "child is here" indicator is a
           separate future work piece. Do not treat this styling as final. -->
      <div id="you-are-here" class="nhsuk-u-margin-bottom-4" style="display: flex; align-items: flex-start; background-color: #ffeb3b; padding: 24px 24px;">
        <span aria-hidden="true" style="display: inline-block; width: 0; height: 0; border-top: 8px solid transparent; border-bottom: 8px solid transparent; border-right: 10px solid #212b32; margin-right: 12px; margin-top: 4px;"></span>
        <span>
          <p class="nhsuk-u-margin-bottom-0"><strong>Idris, 15 months old</strong></p>
          <p class="nhsuk-u-margin-bottom-0">Next vaccination: MMRV vaccine, 2nd dose, at 18 months</p>
          <p class="nhsuk-u-margin-bottom-0"><a href="/parent-test/idris/mmr">View Idris’s MMRV record</a></p>
        </span>
      </div>

      <h4>18 months</h4>
      <ul class="nhsuk-list">
        <li><span style="display:inline-block;width:24px;vertical-align:middle;"></span> MMRV vaccine (2nd dose)</li>
      </ul>
      <h4>2 years</h4>
      <ul class="nhsuk-list">
        <li><span style="display:inline-block;width:24px;vertical-align:middle;"></span> Children’s flu vaccine (every year until children finish Year 11 of secondary school)</li>
      </ul>
      <h4>3 years and 4 months</h4>
      <ul class="nhsuk-list">
        <li><span style="display:inline-block;width:24px;vertical-align:middle;"></span> 4-in-1 pre-school booster vaccine</li>
      </ul>
      <h4>12 to 13 years</h4>
      <ul class="nhsuk-list">
        <li><span style="display:inline-block;width:24px;vertical-align:middle;"></span> HPV vaccine</li>
      </ul>
      <h4>14 years</h4>
      <ul class="nhsuk-list">
        <li><span style="display:inline-block;width:24px;vertical-align:middle;"></span> Td/IPV vaccine (3-in-1 teenage booster)</li>
        <li><span style="display:inline-block;width:24px;vertical-align:middle;"></span> MenACWY vaccine</li>
      </ul>

      <a class="nhsuk-back-link" href="/parent-test/">
        Back to scenarios
      </a>
    </div>
  </div>
{% endblock %}
