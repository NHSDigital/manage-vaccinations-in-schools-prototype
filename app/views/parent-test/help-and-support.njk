{% extends "_layouts/default.njk" %}

{% block content %}
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
      <h1 class="nhsuk-heading-xl">Help and support</h1>
      <p>Speak to your GP or school age immunisation service (SAIS) if:</p>
      <ul class="nhsuk-list nhsuk-list--bullet">
        <li>you want to arrange a vaccination that your child missed</li>
      </ul>
      <p>Speak to your GP if:</p>
      <ul class="nhsuk-list nhsuk-list--bullet">
        <li>you think your child has had a vaccination that is not shown on their record</li>
        <li>you have any other questions or concerns about your child’s vaccination record</li>
      </ul>
    </div>
  </div>
{% endblock %}
