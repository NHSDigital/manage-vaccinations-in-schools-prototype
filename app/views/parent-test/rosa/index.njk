{% extends "_layouts/default.njk" %}

{% block content %}
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-full">
      <h1 class="nhsuk-heading-l nhsuk-u-margin-bottom-2">Rosa Bennett</h1>
      <p class="nhsuk-caption-l nhsuk-u-margin-bottom-4">
        <strong>Date of birth:</strong> 5 March 2020 (aged 6)
      </p>

      <h2 class="nhsuk-heading-l">Vaccination overview</h2>

      <div class="nhsuk-warning-callout">
        <h3 class="nhsuk-warning-callout__label">
          <span role="text">
            <span class="nhsuk-u-visually-hidden">Important: </span>
            May be missing a dose
          </span>
        </h3>
        <p>Rosa may be missing a dose of the MMR (measles, mumps and rubella) vaccine.</p>
        <p><a href="/parent-test/rosa/mmr">View Rosa’s MMR record</a></p>
      </div>

      <div class="nhsuk-tabs" data-module="nhsuk-tabs">
        <h2 class="nhsuk-tabs__title">Contents</h2>
        <ul class="nhsuk-tabs__list">
          <li class="nhsuk-tabs__list-item nhsuk-tabs__list-item--selected">
            <a class="nhsuk-tabs__tab" href="#vaccination-timeline">Vaccination timeline</a>
          </li>
          <li class="nhsuk-tabs__list-item">
            <a class="nhsuk-tabs__tab" href="#disease-protection">Disease protection</a>
          </li>
        </ul>
        <div class="nhsuk-tabs__panel" id="vaccination-timeline">
      <p><a href="#you-are-here">View Rosa’s next vaccination due</a></p>

      <h3>Under 1</h3>
