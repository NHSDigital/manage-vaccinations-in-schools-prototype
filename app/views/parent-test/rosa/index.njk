{% extends "_layouts/default.njk" %}

{% block content %}
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
      <h1 class="nhsuk-heading-l nhsuk-u-margin-bottom-2">Rosa Bennett</h1>
      <p class="nhsuk-caption-l nhsuk-u-margin-bottom-4">
        <strong>Date of birth:</strong> 5 March 2020 (aged 6)
      </p>

      <h2 class="nhsuk-heading-l">Vaccination overview</h2>

      <div class="nhsuk-panel" style="background-color: #d5281b;">
        <h4 class="nhsuk-u-margin-bottom-3"><strong><svg class="nhsuk-icon nhsuk-icon--cross" style="fill:#ffffff;width:28px;height:28px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M17 18.5c-.4 0-.8-.1-1.1-.4l-10-10c-.6-.6-.6-1.6 0-2.1.6-.6 1.5-.6 2.1 0l10 10c.6.6.6 1.5 0 2.1-.3.3-.6.4-1 .4z M7 18.5c-.4 0-.8-.1-1.1-.4-.6-.6-.6-1.5 0-2.1l10-10c.6-.6 1.5-.6 2.1 0 .6.6.6 1.5 0 2.1l-10 10c-.3.3-.6.4-1 .4z"/></svg> May be missing a dose</strong></h4>
        <p class="nhsuk-u-margin-bottom-3">Rosa may be missing a dose of the MMR (measles, mumps, and rubella) vaccine.</p>
        <p class="nhsuk-u-margin-bottom-0"><a href="/parent-test/rosa/mmr" style="color: #ffffff; text-decoration: underline;">View Rosa’s MMR record</a></p>
      </div>
      <p><a href="#you-are-here">View Rosa’s next vaccination due</a></p>

      <h3>Under 1</h3>
      <h4>8 weeks</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> 6-in-1 vaccine (1st dose) <a href="#">View details</a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> Rotavirus vaccine (1st dose) <a href="#">View details</a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> MenB vaccine (1st dose) <a href="#">View details</a></li>
      </ul>
      <h4>12 weeks</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> 6-in-1 vaccine (2nd dose) <a href="#">View details</a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> MenB vaccine (2nd dose) <a href="#">View details</a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> Rotavirus vaccine (2nd dose) <a href="#">View details</a></li>
      </ul>
      <h4>16 weeks</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> 6-in-1 vaccine (3rd dose) <a href="#">View details</a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> Pneumococcal vaccine (1st dose) <a href="#">View details</a></li>
      </ul>

      <hr class="nhsuk-section-break nhsuk-section-break--l nhsuk-section-break--visible">

      <h3>Aged 1 to 15 years</h3>
      <h4>1 year</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> MMR vaccine (1st dose) <a href="/parent-test/rosa/mmr">View details</a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> Pneumococcal vaccine (2nd dose) <a href="#">View details</a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> MenB vaccine <a href="#">View details</a></li>
      </ul>
      <h4>2 years</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> Children’s flu vaccine (every year until children finish Year 11 of secondary school) <a href="#">View details</a></li>
      </ul>
      <h4>3 years and 4 months</h4>
      <ul class="nhsuk-list">
        <li><svg class="nhsuk-icon nhsuk-icon--tick" style="fill:#007f3b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"/></svg> 4-in-1 pre-school booster vaccine <a href="#">View details</a></li>
        <li><svg class="nhsuk-icon nhsuk-icon--cross" style="fill:#d5281b;width:24px;height:24px;vertical-align:middle;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M17 18.5c-.4 0-.8-.1-1.1-.4l-10-10c-.6-.6-.6-1.6 0-2.1.6-.6 1.5-.6 2.1 0l10 10c.6.6.6 1.5 0 2.1-.3.3-.6.4-1 .4z M7 18.5c-.4 0-.8-.1-1.1-.4-.6-.6-.6-1.5 0-2.1l10-10c.6-.6 1.5-.6 2.1 0 .6.6.6 1.5 0 2.1l-10 10c-.3.3-.6.4-1 .4z"/></svg> MMR vaccine (2nd dose) <a href="/parent-test/rosa/mmr">View details</a></li>
      </ul>

      <!-- Placeholder marker. Final design for the "child is here" indicator is a
           separate future work piece. Do not treat this styling as final. -->
      <div id="you-are-here" class="nhsuk-u-margin-bottom-4" style="display: flex; align-items: flex-start; background-color: #ffeb3b; padding: 24px 24px;">
        <span style="display: inline-block; width: 0; height: 0; border-top: 8px solid transparent; border-bottom: 8px solid transparent; border-right: 10px solid #212b32; margin-right: 12px; margin-top: 4px;"></span>
        <span>
          <p class="nhsuk-u-margin-bottom-0"><strong>Rosa, 6 years old</strong></p>
          <p class="nhsuk-u-margin-bottom-0">Next vaccination: MMR vaccine, 2nd dose, overdue since 3 years 4 months</p>
          <p class="nhsuk-u-margin-bottom-0"><a href="/parent-test/rosa/mmr">View Rosa’s MMR record</a></p>
        </span>
      </div>

      <h4>12 to 13 years</h4>
      <ul class="nhsuk-list">
        <li><span style="display:inline-block;width:24px;vertical-align:middle;"></span> HPV vaccine</li>
      </ul>
      <h4>14 years</h4>
      <ul class="nhsuk-list">
        <li><span style="display:inline-block;width:24px;vertical-align:middle;"></span> Td/IPV vaccine (3-in-1 teenage booster)</li>
        <li><span style="display:inline-block;width:24px;vertical-align:middle;"></span> MenACWY vaccine</li>
      </ul>

      <a class="nhsuk-back-link" href="/parent-test/">
        Back to scenarios
      </a>
    </div>
  </div>
{% endblock %}
