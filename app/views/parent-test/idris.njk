{% extends "_layouts/default.njk" %}

{% block content %}
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
      <h1 class="nhsuk-heading-l nhsuk-u-margin-bottom-2">Idris Marsh</h1>
      <p class="nhsuk-caption-l nhsuk-u-margin-bottom-4">
        <strong>Date of birth:</strong> 10 March 2025 (aged 15 months)
      </p>

      <h3>MMRV vaccination status</h3>
      <div class="nhsuk-card">
        <div class="nhsuk-card__content">
          <h4><strong>Up to date</strong></h4>
          <p>Idris is up to date for their age with MMRV (measles, mumps, rubella and chickenpox) vaccinations</p>
          <p class="nhsuk-u-margin-bottom-2"><a href="/parent-test/understanding-records#how-we-calculate">How we calculate vaccination status</a></p>
        </div>
      </div>

      <h3>MMRV vaccination coverage</h3>
      <p>Most children need 2 doses of the MMRV vaccine</p>
      <table class="nhsuk-table">
        <thead class="nhsuk-table__head">
          <tr class="nhsuk-table__row">
            <th scope="col" class="nhsuk-table__header">1st dose</th>
            <th scope="col" class="nhsuk-table__header">2nd dose</th>
          </tr>
        </thead>
        <tbody class="nhsuk-table__body">
          <tr class="nhsuk-table__row">
            <td class="nhsuk-table__cell">✅</td>
            <td class="nhsuk-table__cell">Due from 10 September 2026</td>
          </tr>
        </tbody>
      </table>

      <h3>Vaccination timeline</h3>
      <div class="nhsuk-card">
        <div class="nhsuk-card__content">
          <p><strong>1st dose</strong> normally given at 12 months</p>
          <p>✅ Given 12 March 2026 (1 year 2 days) <a href="/parent-test/dose-detail">View details</a></p>
        </div>
      </div>
      <div class="nhsuk-card">
        <div class="nhsuk-card__content">
          <p><strong>2nd dose</strong> normally given at 18 months</p>
          <p>Not due yet. Your GP will send you an invitation for the MMRV 2nd dose. You do not have to do anything right now.</p>
        </div>
      </div>

      <p>This record shows the information we currently have. Recent vaccinations may not have reached us yet, and vaccinations given by another service or in another country may not be included.</p>
      <p>If anything looks wrong or missing, contact <a href="#">help and support</a>.</p>
    </div>
  </div>
{% endblock %}
