{% extends "_layouts/form.njk" %}

{% set singleProgramme = true if patientsByProgramme.length === 1 else false %}
{% set programmeCountKey = "singleProgramme" if singleProgramme else "multipleProgrammes" %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [
      {
        text: __("home.show.title"),
        href: "/"
      },
      {
        text: __("session.list.title"),
        href: "/sessions"
      },
      {
        text: session.location.name,
        href: session.uri
      }
    ]
  }) }}
{% endblock %}

{% block form %}
  {% if singleProgramme %}
    {{ heading({
      text: __mf("session.give-instructions.singleProgramme.title", {
        count: totalPatients,
        programmeName: patientsByProgramme[0].programmeNameInSentence
      }),
      size: "l"
    }) }}

    {{ input({
      type: "hidden",
      value: patientsByProgramme[0].programme_id,
      decorate: "psdProgramme_ids"
    }) }}
  {% else %}
    {% set checkboxItems = [
      {
        value: "all",
        text: __("session.give-instructions.multipleProgrammes.allProgrammes.label"),
        hint: __mf("session.give-instructions.multipleProgrammes.allProgrammes.hint", { count: totalPatients }),
        behaviour: "inclusive"
      },
      {
        divider: "or",
        behaviour: "inclusive"
      }
      ] %}
    {% for programmeItem in patientsByProgramme %}
      {% set checkboxItems = checkboxItems | push({
        value: programmeItem.programme_id,
        text: programmeItem.programmeName,
        hint: __mf("session.give-instructions.multipleProgrammes.oneProgramme.hint", {
          count: programmeItem.patientCount,
          programmeName: programmeItem.programmeNameInSentence
        })
      }) %}
    {% endfor %}

    {{ checkboxes({
      fieldset: {
        legend: {
          heading: __("session.give-instructions.multipleProgrammes.title"),
          size: "l"
        }
      },
      items: checkboxItems,
      decorate: "psdProgramme_ids"
    }) }}
  {% endif %}
{% endblock %}

{% block afterForm %}
  {{ insetText({
    html: __("session.give-instructions.warning") | nhsukMarkdown
  }) }}

  {{ appButtonGroup({
    buttons: [
      {
        text: __("session.give-instructions." + programmeCountKey + ".confirm")
      }
    ],
    links: [
      {
        text: __("session.give-instructions." + programmeCountKey + ".cancel"),
        href: session.uri + "/instructions"
      }
    ]
  }) }}
{% endblock %}
