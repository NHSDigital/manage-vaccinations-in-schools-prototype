{{ heading({
  text: __("session.tally.appointments.label"),
  level: 2,
  size: "m"
}) }}

<div class="nhsuk-grid-row nhsuk-card-group">
  {% set columnWidth = "quarter" %}

  {% set percentBooked = session.percentBooked %}
  {% if ('flu' in session.programme_ids) or (session.programmeAppointments('flu').length > 0) %}
    {# Remaining capacity broken down by nasal spray vs. injection appointments #}
    <div class="nhsuk-grid-column-one-{{ columnWidth }} nhsuk-card-group__item">
      {{ appDataCard({
        heading: {
          text: __("session.tally.appointments.percentBooked.label"),
          level: 3
        },
        colour: "white" if percentBooked < 90 else ("orange" if percentBooked < 100 else "red"),
        compact: true,
        data: percentBooked ~ "%"
      }) }}
    </div>
    <div class="nhsuk-grid-column-one-{{ columnWidth }} nhsuk-card-group__item">
      {{ appDataCard({
        heading: {
          text: __("session.tally.appointments.available.nasal.label"),
          level: 3
        },
        colour: "white",
        compact: true,
        data: session.availableCapacity(VaccineMethod.Intranasal)
      }) }}
    </div>
    <div class="nhsuk-grid-column-one-{{ columnWidth }} nhsuk-card-group__item">
      {{ appDataCard({
        heading: {
          text: __("session.tally.appointments.available.injection.label"),
          level: 3
        },
        colour: "white",
        compact: true,
        data: session.availableCapacity(VaccineMethod.Injection)
      }) }}
    </div>
  {% else %}
    {# Remaining capacity assumes all appointments are for injections #}
    <div class="nhsuk-grid-column-one-{{ columnWidth }} nhsuk-card-group__item">
      {{ appDataCard({
        heading: {
          text: __("session.tally.appointments.percentBooked.label"),
          level: 3
        },
        colour: "white" if percentBooked < 90 else ("orange" if percentBooked < 100 else "red"),
        compact: true,
        data: percentBooked ~ "%"
      }) }}
    </div>
    <div class="nhsuk-grid-column-one-{{ columnWidth }} nhsuk-card-group__item">
      {{ appDataCard({
        heading: {
          text: __("session.tally.appointments.available.label"),
          level: 3
        },
        compact: true,
        data: session.availableSlotCount
      }) }}
    </div>
  {% endif %}

  {# Vaccinators and days left to book #}
  <div class="nhsuk-grid-column-one-{{ columnWidth }} nhsuk-card-group__item">
    {{ appDataCard({
      heading: {
        text: __("session.tally.vaccinators.maximum.label") if session.hasVariableVaccinatorCounts else __("session.tally.vaccinators.consistent.label"),
        level: 3
      },
      compact: true,
      data: session.maximumVaccinatorCount
    }) }}
  </div>
  <div class="nhsuk-grid-column-one-{{ columnWidth }} nhsuk-card-group__item">
    {{ appDataCard({
      heading: {
        text: __("session.tally.appointments.daysLeft.label"),
        level: 3
      },
      colour: "orange" if session.daysLeftToBook < 7 and session.daysLeftToBook > 0,
      compact: true,
      data: session.daysLeftToBook
    }) }}
  </div>

  {# Appointments booked per programme #}
  {% for programme in session.bookedProgrammes %}
    <div class="nhsuk-grid-column-one-{{ columnWidth }} nhsuk-card-group__item">
      {{ appDataCard({
        heading: {
          text: __("session.tally.appointments.programmeRequests.label", programme.type),
          level: 3
        },
        colour: "green",
        compact: true,
        data: session.programmeAppointments(programme.id).length,
        href: session.uri + "/patients?programme_id=" + programme.id
      }) }}
    </div>
  {% endfor %}
</div>
