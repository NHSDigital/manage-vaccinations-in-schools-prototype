{% from "_macros/session-search.njk" import appSessionSearch with context %}

{% extends "_layouts/form.njk" %}

{% set gridColumns = "full" %}
{% set hideConfirmButton = true %}
{% set title = __("session.list.title") %}
{% set showDates = view == "planned" or view == "completed" %}

{% block form %}
  {{ super() }}

  {{ heading({
    text: title,
    size: "l"
  }) }}

  {% if not account.isSchoolUser %}
    {{ actionLink({
      text: __("session.new.label"),
      href: "/sessions/new"
    }) }}

    {{ actionLink({
      text: __("session.advertise.label"),
      href: "/sessions/advertise",
      classes: "nhsuk-u-margin-left-5"
    }) if clinicsAreScheduled }}
  {% endif %}

  <div class="nhsuk-grid-row">
    <app-auto-submit class="app-grid-column-filters">
      {{ appSessionSearch({
        clear: "/sessions"
      }) }}
    </app-auto-submit>

    <div class="app-grid-column-results">
      {% if data.type and data.type != "none" %}
        {% set title = data.type + "s" %}
      {% else %}
        {% set title = "All sessions" %}
      {% endif %}

      {{ heading({
        caption: {
          html: __mf("session.results", {
            from: results.from,
            to: results.to,
            count: results.count
          }),
          placement: "after"
        },
        text: title,
        level: 2,
        size: "m"
      }) }}

      {% for session in results.page %}
        {% include "session/_session-card.njk" %}
      {% endfor %}

      {{ pagination(pages) }}
    </div>
  </div>
{% endblock %}
