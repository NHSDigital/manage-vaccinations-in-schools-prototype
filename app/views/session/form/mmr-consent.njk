{% extends "_layouts/form.njk" %}

{% set title = __("session.mmrConsent.title") %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        isPageHeading: true,
        text: title,
        size: "l"
      }
    },
    items: [
      {
        label: SessionMMRConsent.Standard,
        hint: __("session.mmrConsent.standard.hint")
      },
      {
        label: SessionMMRConsent.Outbreak,
        hint: __("session.mmrConsent.outbreak.hint")
      }
    ],
    decorate: "session.mmrConsent"
  }) }}
{% endblock %}
