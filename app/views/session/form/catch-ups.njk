{% extends "_layouts/form.njk" %}

{% set title = __mf("session.catchUps.title", { count: session.programme_ids.length }) %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        text: title,
        size: "l",
        isPageHeading: true
      }
    },
    items: [
    {
      text: __("session.catchUps.yes"),
      value: true
    },
    {
      text: __("session.catchUps.no", { selectedProgrammeNames: session.programmeNames.sentenceCase }) | safe,
      value: false
    }
    ],
    decorate: "session.canVaccinateForOtherProgrammes"
  }) }}
{% endblock %}
