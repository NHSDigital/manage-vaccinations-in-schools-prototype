{% extends "_layouts/form.njk" %}

{% set title = __("session.vaccinationDuration.nasal.title") %}

{% block form %}
  {{ heading({
    text: title,
    size: "l"
  }) }}

  {% if 'flu' not in session.programme_ids %}
    <p class="nhsuk-hint">
      {{ __("session.vaccinationDuration.nasal.hint") }}
    </p>
  {% endif %}

  {{ input({
    label: __("session.vaccinationDuration.nasal.label"),
    suffix: __("session.vaccinationDuration.suffix"),
    width: 2,
    inputmode: "numeric",
    spellcheck: false,
    decorate: "session.nasalSprayLength"
  }) }}
{% endblock %}
