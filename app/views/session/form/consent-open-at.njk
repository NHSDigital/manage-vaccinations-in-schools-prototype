{% extends "_layouts/form.njk" %}

{% set title = __("session.consentOpenAt.title") %}

{% block form %}
  {{ dateInput({
    fieldset: {
      legend: {
        classes: "nhsuk-fieldset__legend--l",
        html: appHeading({
          caption: session.location.name if type == "edit",
          title: title
        })
      }
    },
    hint: __("session.consentOpenAt.hint"),
    decorate: "session.consentOpenAt_"
  }) }}
{% endblock %}
