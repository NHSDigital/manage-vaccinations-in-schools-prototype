{% extends "_layouts/form.njk" %}

{% set title = __("session.vaccinationDuration.vaccinationMultiple.title") %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        text: title,
        size: "l",
        isPageHeading: true
      }
    },
    items: [
      {
        text: __("session.vaccinationDuration.vaccinationMultiple.yes"),
        value: 2
      },
      {
        text: __("session.vaccinationDuration.vaccinationMultiple.no"),
        value: 1
      }
    ],
    decorate: "session.slotCountForLongAppointment"
  }) }}
{% endblock %}
