{% extends "_layouts/form.njk" %}

{% set title = __("session.programmes.title") %}

{% block form %}
  {% set presetNameItems = [] %}
  {% for preset in SessionPresets %}
    {% if not preset.clinicOnly %}
      {% set presetNameItems = presetNameItems | push({
        text: preset.programmeTypes | formatList,
        value: preset.name
      }) %}
    {% endif %}
  {% endfor %}

  {{ checkboxes({
    fieldset: {
      legend: {
        classes: "nhsuk-fieldset__legend--l",
        html: appHeading({
          caption: session.location.name if type == "edit",
          title: title
        })
      }
    },
    items: presetNameItems,
    decorate: "session.presetNames"
  }) }}
{% endblock %}
