{% extends "_layouts/form.njk" %}

{% set title = __("session.protocol.title") %}

{% block form %}
  {{ heading({
    caption: session.location.name,
    text: title,
    size: "l"
  }) }}

  {{ radios({
    fieldset: {
      legend: {
        text: __("session.protocolNurse.title"),
        size: "m"
      }
    },
    items: [
      {
        label: __("session.protocolNurse.pgd.label"),
        value: VaccinationProtocol.PGD
      },
      {
        label: __("session.protocolNurse.vgd.label"),
        value: VaccinationProtocol.VGD
      }
    ],
    decorate: "session.protocolNurse"
  }) }}

  {{ radios({
    fieldset: {
      legend: {
        text: __("session.protocolHCA.title"),
        size: "m"
      }
    },
    items: [
      {
        label: __("session.protocolHCA.no.label"),
        value: ""
      },
      {
        label: __("session.protocolHCA.yes.label"),
        value: VaccinationProtocol.VGD
      }
    ],
    decorate: "session.protocolHCA"
  }) }}

  {{ radios({
    fieldset: {
      legend: {
        text: __("session.hasPsdProtocol.title"),
        size: "m"
      }
    },
    items: [
      {
        label: __("session.hasPsdProtocol.no.label"),
        hint: __("session.hasPsdProtocol.no.hint"),
        value: false
      },
      {
        label: __("session.hasPsdProtocol.yes.label"),
        hint: __("session.hasPsdProtocol.yes.hint"),
        value: true
      }
    ],
    decorate: "session.hasPsdProtocol"
  }) }}
{% endblock %}
