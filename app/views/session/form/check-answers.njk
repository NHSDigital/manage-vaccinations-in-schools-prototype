{% extends "_layouts/form.njk" %}

{% set confirmButtonText = __("session.new.check-answers.confirm") %}
{% set title = __("session.new.check-answers.title") %}

{% block form %}
  {{ heading({
    text: title,
    size: "l"
  }) }}

  {% if session.type === SessionType.School %}
    {# School session summary #}
    {{ summaryList({
      card: {
        heading: {
          text: __("session.summary"),
          size: "m"
        }
      },
      lastRowBorder: false,
      rows: summaryRows(session, {
        type: {
          href: session.uri + "/new/type"
        },
        school: {
          href: session.uri + "/new/school"
        },
        programmes: {
          href: session.uri + "/new/programmes"
        },
        yearGroups: {
          href: session.uri + "/new/year-groups"
        },
        dates: {
          href: session.uri + "/new/dates"
        },
        consentOpenAt: {
          href: session.uri + "/new/consent-open-at"
        },
        reminderWeeks: {
          href: session.uri + "/new/reminders"
        },
        consentContacts: {
          href: session.uri + "/new/consent-contacts"
        },
        mmrConsent: {
          href: session.uri + "/new/mmr-consent"
        },
        hasRegistration: {
          href: session.uri + "/new/registration"
        }
      })
    }) }}
  {% else %}
    {# Clinic session summary #}
    {% set appointmentLengthKey = "dropIn" if session.clinicType === ClinicType.DropIn else "booking" %}
    {{ summaryList({
      card: {
        heading: {
          text: __("session.summary"),
          size: "m"
        }
      },
      lastRowBorder: false,
      rows: summaryRows(session, {
        type: {},
        clinicType: {
          href: session.uri + "/new/clinic-type"
        },
        programmes: {
          href: session.uri + "/new/programmes"
        },
        catchUps: {
          href: session.uri + "/new/catch-ups"
        } if not session.isFluOnlyClinic else none,
        location: {
          href: session.uri + "/new/clinic"
        },
        venueInformation: {
          href: session.uri + "/new/clinic-information"
        },
        date: {
          href: session.uri + "/new/date"
        },
        hasRegistration: {
          href: session.uri + "/new/registration"
        } if session.clinicType !== ClinicType.DropIn else none,
        vaccinationPeriods: {
          href: session.uri + "/new/vaccination-periods"
        },
        vaccinators: {
          href: session.uri + "/new/vaccinators"
        },
        appointmentLengths: {
          label: __("session.appointmentLengths.label." + appointmentLengthKey),
          href: session.uri + "/new/appointment-length"
        },
        totalSlots: {
          label: __("session.totalSlots.label." + appointmentLengthKey)
        }
      })
    }) }}
  {% endif %}

  {# Protocols used in the session #}
  {{ summaryList({
    card: {
      heading: {
        text: __("session.protocols.summary"),
        size: "m"
      }
    },
    lastRowBorder: false,
    rows: summaryRows(session, {
      protocolNurse: {
        label: __("session.protocols.nurse.label"),
        href: session.uri + "/new/protocols" if session.canSupportVGD
      },
      protocolHCA: {
        label: __("session.protocols.hca.label"),
        value: __("session.protocols.hca.none.summary") if not session.protocolForHCAs,
        href: session.uri + "/new/protocols"
      },
      psdUsage: {
        label: __("session.protocols.psdUsage.label"),
        href: session.uri + "/new/protocols"
      } if session.protocolForHCAs == VaccinationProtocol.PSD and session.hasPsdUsageChoice else none
    })
  }) }}
{% endblock %}
