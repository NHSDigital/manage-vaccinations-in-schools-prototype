{% extends "_layouts/form.njk" %}

{% set title = __("session.appointmentLengths.title") %}
{% set clinicTypeKey = "flu" if session.isFluOnlyClinic else "other" %}

{% block form %}
  {% call fieldset({
    legend: {
      heading: title,
      size: "l"
    }
  }) %}
    {# Ask about the length of the shortest appointment possible, and use as the slot length #}
    {{ input({
      label: {
        text: __("session.appointmentLengths." + clinicTypeKey + ".short.label"),
        size: "m"
      },
      suffix: __("session.appointmentLengths.suffix"),
      width: 2,
      inputmode: "numeric",
      spellcheck: false,
      decorate: "session.slotLength"
    }) }}
    
    {% if session.canBeSetUpForLongerAppointments %}
      {% if session.isFluOnlyClinic %}
        {# Ask about making IM flu vaccinations longer in flu-only clinics #}
        {{ radios({
          fieldset: {
            legend: {
              text: __("session.appointmentLengths." + clinicTypeKey + ".long.label"),
              size: "m"
            }
          },
          items: [
          {
            text: __("session.appointmentLengths." + clinicTypeKey + ".long.yes"),
            value: true
          },
          {
            text: __("session.appointmentLengths." + clinicTypeKey + ".long.no"),
            value: false
          }
          ],
          decorate: "session.useTwoSlotsForInjectedFlu"
        }) }}
      {% else %}
        {# Ask whether multiple injections should trigger a longer appointment (and how many) #}
        {{ radios({
          fieldset: {
            legend: {
              text: __("session.appointmentLengths." + clinicTypeKey + ".long.label"),
              size: "m"
            }
          },
          items: [
          {
            text: __("session.appointmentLengths." + clinicTypeKey + ".long.threeplus"),
            value: 3
          } if session.maximumNumberOfBookableInjections > 3,
          {
            text: __("session.appointmentLengths." + clinicTypeKey + ".long.three"),
            value: 3
          } if session.maximumNumberOfBookableInjections === 3,
          {
            text: __("session.appointmentLengths." + clinicTypeKey + ".long.twoplus"),
            value: 2
          } if session.maximumNumberOfBookableInjections > 2,
          {
            text: __("session.appointmentLengths." + clinicTypeKey + ".long.yes"),
            value: 2
          } if session.maximumNumberOfBookableInjections === 2,
          {
            text: __("session.appointmentLengths." + clinicTypeKey + ".long.no"),
            value: 0
          }
          ],
          decorate: "session.vaccinationCountForLongAppointment"
        }) }}
      {% endif %}
    {% else %}
      {# Can't have longer appointments, so just record neutral value for longer appointments #}
      {{ input({
        type: "hidden",
        value: 0,
        decorate: "session.vaccinationCountForLongAppointment"
      }) }}
    {% endif %}
  {% endcall %}
{% endblock %}
