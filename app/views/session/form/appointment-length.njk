{% extends "_layouts/form.njk" %}

{% set title = __("session.appointmentLengths.title") %}
{% set clinicType = "flu" if session.isFluOnlyClinic else "other" %}

{% block form %}
  {% call fieldset({
    legend: {
      heading: title,
      size: "l"
    }
  }) %}
    {{ input({
      label: {
        text: __("session.appointmentLengths." + clinicType + ".short.label"),
        size: "m"
      },
      suffix: __("session.appointmentLengths.suffix"),
      width: 2,
      inputmode: "numeric",
      spellcheck: false,
      decorate: "session.slotLength"
    }) }}
    
    {{ radios({
      fieldset: {
        legend: {
          text: __("session.appointmentLengths." + clinicType + ".long.label"),
          size: "m"
        }
      },
      items: [
      {
        text: __("session.appointmentLengths." + clinicType + ".long.yes"),
        value: 2
      },
      {
        text: __("session.appointmentLengths." + clinicType + ".long.no"),
        value: 1
      }
      ],
      decorate: "session.slotCountForLongAppointment"
    }) }}
  {% endcall %}
{% endblock %}
