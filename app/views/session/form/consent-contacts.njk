{% extends "_layouts/form.njk" %}

{% set title = __("session.consentContacts.title") %}
{% set nonRefusers = [1,2,3,4,5,6,7,8,9] | random %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        heading: title,
        size: "l"
      }
    },
    items: [{
      text: SessionConsentContacts.All,
      hint: __mf("session.consentContacts.nonRefusers.hint", {
        count: nonRefusers
      })
    }, {
      text: SessionConsentContacts.NonRefusers
    }],
    decorate: "session.consentContacts"
  }) }}
{% endblock %}
