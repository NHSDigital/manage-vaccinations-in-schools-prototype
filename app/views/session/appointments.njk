{% extends "_layouts/session.njk" %}

{% set title = session.shortName %}
{% set headingText = title %}
{% set caption = session.formatted.date %}

{% block content %}
  {% macro buildSlotHtml(appointment, bookingQueryString) %}
    {% if appointment !== null %}
      {# Link from child’s name #}
      {% if appointment.patient_uuid %}
        {{ appointment.link.matched | safe }}
      {% else %}
        {{ appointment.link.unmatched.withoutParent | safe }}
        <span class="nhsuk-u-secondary-text-colour nhsuk-u-font-size-16"> (unmatched)</span>
      {% endif %}

      {# Registration status #}
      {% if session.hasRegistration and session.isActive %}
        <br>
        {% if appointment.register %}
          {{ appointment.formatted.register | safe }}
        {% else %}
          {{ tag({
            text: RegistrationStatus.Pending,
            classes: "nhsuk-tag--grey"
          }) }}
        {% endif %}
      {% endif %}

      {# Selected vaccinations #}
      <br>
      {{ appointment.formatted.programmeTags | safe }}

      {# Adjustments and impairments #}
      {% if appointment.requiresAdjustments %}
        <br>
        {{ appointment.formatted.adjustmentsCount | safe }}
      {% endif %}
      {% if appointment.hasImpairments %}
        <br>
        {{ appointment.formatted.impairmentsCount | safe }}
      {% endif %}
    {% else %}
      {{ link(session.uri + "/add-appointment/?" + bookingQueryString, "Book") | safe }}
    {% endif %}
  {% endmacro %}

  {# Full calendar-like view of the vaccination periods' appointments and empty slots #}
  {% for vaccinationPeriodTable in vaccinationPeriodTables %}
    {# Create the rows of appointments and empty slots #}
    {% set tableRows = [] %}
    {% for row in vaccinationPeriodTable.rows %}
      {% set rowValues = [] %}
      {% for rowValue in row.rowValues %}
        {% set rowValues = rowValues | push(
          {
            text: rowValue.timeSlot
          }
          if rowValue.timeSlot else
          {
            html: buildSlotHtml(rowValue.appointment, row.bookingQueryString)
          }
        ) %}
      {% endfor %}
      {% set tableRows = tableRows | push(rowValues) %}
    {% endfor %}

    {% set periodHeading = "Vaccination period " + vaccinationPeriodTable.periodNumber if vaccinationPeriodTables.length > 1 else "All appointments" %}
    {{ table({
      id: "appointments",
      responsive: true,
      firstCellIsHeader: true,
      card: {
        heading: {
          html: heading({
            caption: {
              text: "From " + vaccinationPeriodTable.vaccinationPeriod.formatted.startAndEndTimes + ", with " + vaccinationPeriodTable.vaccinationPeriod.formatted.vaccinators,
              placement: "after"
            },
            text: periodHeading,
            level: 2,
            size: "m"
          })
        }
      },
      rows: tableRows
    }) }}
  {% endfor %}
{% endblock %}
