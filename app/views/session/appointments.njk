{% extends "_layouts/session.njk" %}

{% set title = session.shortName %}
{% set heading = title %}
{% set caption = session.formatted.date %}

{% block content %}
  {% macro buildSlotHtml(appointment, time) %}
    {% if appointment !== null %}
      {% if appointment.patient_uuid %}
        {{ appointment.link.patientSession | safe }}
      {% else %}
        {{ appointment.link.unmatched | safe }}
        <span class="nhsuk-u-secondary-text-colour nhsuk-u-font-size-16"> (unmatched)</span>
      {% endif %}
      <br>
      {{ appointment.formatted.programmeTags | safe }}
      {% if appointment.requiresAdjustments %}
        <br>
        {{ appointment.formatted.adjustmentsCount | safe }}
      {% endif %}
      {% if appointment.hasImpairments %}
        <br>
        {{ appointment.formatted.impairmentsCount | safe }}
      {% endif %}
    {% else %}
      <a href="#">Book</a>
    {% endif %}  
  {% endmacro %}

  {# Full calendar-like view of the vaccination periods' appointments and empty slots #}
  {% for vaccinationPeriodTable in vaccinationPeriodTables %}
    {# Create the rows of appointments and empty slots #}
    {% set tableRows = [] %}
    {% for row in vaccinationPeriodTable.rows %}
      {% set rowValues = [] %}
      {% for rowValue in row.rowValues %}
        {% set rowValues = rowValues | push(
          {
            header: rowValue.header,
            text: rowValue.timeSlot
          }
          if rowValue.timeSlot else
          {
            header: rowValue.header,
            html: buildSlotHtml(rowValue.appointment, row.time)
          }
        ) %}
      {% endfor %}
      {% set tableRows = tableRows | push(rowValues) %}
    {% endfor %}

    {% set periodHeading = "Vaccination period " + vaccinationPeriodTable.periodNumber if vaccinationPeriodTables.length > 1 else "All appointments" %}
    {{ table({
      id: "appointments",
      responsive: true,
      firstCellIsHeader: true,
      card: {
        headingHtml: appHeading({
          title: periodHeading,
          summary: "From " + vaccinationPeriodTable.vaccinationPeriod.formatted.startAndEndTimes + ", with " + vaccinationPeriodTable.vaccinationPeriod.formatted.vaccinators
        }),
        headingLevel: 3
      },
      rows: tableRows
    }) }}
  {% endfor %}
{% endblock %}
