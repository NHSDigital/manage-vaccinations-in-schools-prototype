{% extends "_layouts/form.njk" %}

{% set title = __("session.advertise.link.title") %}
{% set hideConfirmButton = true %}

{% block form %}
  {{ heading({
    text: title,
    size: "l"
  }) }}

  {{ code({
    text: bookingLink,
    button: true,
    copyButtonText: __("session.advertise.link.copy.label"),
    copiedButtonText: __("session.advertise.link.copied.label")
  }) }}

  {{ __("session.advertise.link.description", { programmeNames: programmeNames }) | nhsukMarkdown }}

  {{ button({
    text: __("session.advertise.link.confirm"),
    href: "/sessions"
  }) }}
{% endblock %}
