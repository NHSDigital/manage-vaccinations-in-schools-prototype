{%- from "card/macro.njk" import card %}
{%- from "heading/macro.njk" import heading %}
{%- from "summary-list/macro.njk" import summaryList %}
{%- from "tables/macro.njk" import table %}
{%- from "_macros/action-list.njk" import appActionList %}

{#
  A contact, with their contact details and contact points

  @param {Contact} contact - Contact
  @param {boolean} canChange - User can change contacts
#}
{% macro contactRelationshipSection(contactRelationship, canChange) %}
  {#
    Contact points can be archived or restored on any contact the user can
    change, including archived contacts (restoring one restores the contact)
  #}
  {% set canChangeContacts = canChange and contactRelationship.isSaved %}
  {% set canChangeContactRelationship = canChangeContacts and not contactRelationship.isArchived %}

  {#
    The card adds its heading to each action as hidden text, so actions don’t
    need their own
  #}
  {% call card({
    classes: "nhsuk-u-margin-top-0",
    heading: {
      text: contactRelationship.fullNameAndRelationship,
      level: 3,
      size: "m"
    },
    actions: {
      items: [
        {
          text: __("contact.new.tel.label"),
          href: contactRelationship.uri + "/contacts/new/tel"
        } if canChangeContactRelationship and not contactRelationship.isSensitive,
        {
          text: __("contact.new.email.label"),
          href: contactRelationship.uri + "/contacts/new/email"
        } if canChangeContactRelationship and not contactRelationship.isSensitive,
        {
          text: __("actions.edit"),
          href: contactRelationship.uri + "/edit"
        } if canChangeContactRelationship,
        {
          text: __("actions.archive"),
          href: contactRelationship.uri + "/archive"
        } if canChangeContactRelationship
      ]
    } if canChangeContactRelationship
  }) %}
    {#
      Preferences are only known once a parent has responded to a consent
      request, so only show them if they’ve been given. Communication needs
      are given with each response or booking, so aren’t shown here
    #}
    {% set preferenceRows = summaryRows(contactRelationship, {
      canSms: {}
    }) %}

    {{ summaryList({
      lastRowBorder: false,
      rows: preferenceRows
    }) if preferenceRows | length }}

    {% if not contactRelationship.isSensitive %}
      {% set contactRows = [] %}
      {% for contact in contactRelationship.sortedContacts %}
        {% set contactRows = contactRows | push([
          {
            classes: "app-table__cell--muted" if contact.isArchived,
            width: "one-third",
            html: contact.formatted.value
          },
          {
            classes: "app-table__cell--muted" if contact.isArchived,
            text: contact.formatted.archivedAt or contact.formatted.updatedAt or contact.formatted.createdAt
          },
          {
            classes: "app-table__cell--muted" if contact.isArchived,
            html: contact.formatted.sources
          },
          {
            classes: "app-table__cell--muted" if contact.isArchived,
            html: appActionList({
              items: [
                {
                  text: __("actions.restore"),
                  href: contactRelationship.uri + "/contacts/" + contact.uuid + "/restore"
                }
              ] if contact.isArchived else [
                {
                  text: __("actions.archive"),
                  href: contactRelationship.uri + "/contacts/" + contact.uuid + "/archive"
                }
              ]
            })
          } if canChangeContacts else none
        ]) %}
      {% endfor %}

      {{ table({
        responsive: true,
        caption: __mf("contact.count", { count: contactRelationship.activeContacts.length }),
        head: [
          {
            text: __("contact.value.label"),
            width: "one-third"
          },
          {
            text: __("contact.updatedAt.label"),
            width: "one-quarter"
          },
          {
            text: __("contact.sources.label"),
            width: "one-quarter"
          },
          {
            text: __("actions.label")
          } if canChangeContacts else none
        ],
        lastRowBorder: false,
        rows: contactRows
      }) }}
    {% endif %}
  {% endcall %}
{% endmacro %}
