{% from "_macros/action-list.njk" import appActionList %}
{% from "_macros/heading.njk" import appHeading %}
{% from "_macros/section-navigation.njk" import appSectionNavigation %}

{% macro patientNavigation(params) %}
  {{ appHeading({
    title: params.patient.fullName
  }) }}

  {{ appActionList({
    items: [{
      tag: {
        text: __("patient.isArchived.label"),
        classes: "nhsuk-tag--grey"
      }
    }]
  }) if patient.isArchived }}

  {{ appSectionNavigation({
    items: sectionNavigationItems
  }) }}

  <h2 class="nhsuk-heading-m nhsuk-u-visually-hidden">
    {{ __("patient." + params.view + ".title") }}
  </h2>
{% endmacro %}
