{% from "patient/_navigation.njk" import patientNavigation with context %}

{% extends "_layouts/form.njk" %}

{% set gridColumns = "full" %}
{% set hideConfirmButton = true %}
{% set title = patient.initials %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [
      {
        text: __("home.show.title"),
        href: "/"
      },
      {
        text: __("patient.list.title"),
        href: "/patients"
      }
    ]
  }) }}
{% endblock %}

{% block form %}
  {{ super() }}

  {{ patientNavigation({
    patient: patient,
    view: "contacts"
  }) }}

  {{ actionLink({
    text: __("contactRelationship.new.label"),
    href: "/contact-relationships/new?patient_uuid=" + patient.uuid
  }) }}

  {# Note: this isn't guaranteed to work if the patient has multiple notices but should be fine for canned data #}
  {{ appStatus({
    text: patient.notice.name,
    icon: "warning",
    colour: "blue"
  }) if patient.isSensitive }}

  {% for contactRelationship in patient.contactRelationships %}
    {{ summaryList({
      card: {
        heading: {
          text: contactRelationship.fullNameAndRelationship,
          level: 4,
          size: "m"
        },
        actions: {
          items: [
            {
              text: __("actions.edit"),
              href: contactRelationship.uri + "/edit"
            },
            {
              text: __("actions.delete"),
              href: contactRelationship.uri + "/delete"
            }
          ]
        }
      },
      lastRowBorder: false,
      rows: summaryRows(contactRelationship, {
        email: {},
        tel: {}
      })
    }) }}
  {% endfor %}
{% endblock %}
