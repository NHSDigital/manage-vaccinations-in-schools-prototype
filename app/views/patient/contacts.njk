{% from "patient/_navigation.njk" import patientNavigation with context %}
{% from "patient/_contact-relationship.njk" import contactRelationshipSection with context %}

{% extends "_layouts/form.njk" %}

{% set gridColumns = "full" %}
{% set hideConfirmButton = true %}
{% set title = patient.initials %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [
      {
        text: __("home.show.title"),
        href: "/"
      },
      {
        text: __("patient.list.title"),
        href: "/patients"
      }
    ]
  }) }}
{% endblock %}

{% block form %}
  {{ super() }}

  {{ patientNavigation({
    patient: patient,
    view: "contacts"
  }) }}

  {{ actionLink({
    text: __("contactRelationship.new.label"),
    href: "/contact-relationships/new?patient_uuid=" + patient.uuid
  }) if not account.isSchoolUser }}

  {# Note: this isn't guaranteed to work if the patient has multiple notices but should be fine for canned data #}
  {{ appStatus({
    text: patient.notice.name,
    icon: "warning",
    colour: "blue"
  }) if patient.isSensitive }}

  {% for contactRelationship in patient.activeContactRelationships %}
    {{ contactRelationshipSection(contactRelationship, not account.isSchoolUser) }}
  {% endfor %}

  {% if patient.archivedContactRelationships.length %}
    <p class="nhsuk-body">
      {{ link({
        text: __("contactRelationship.archived.label"),
        href: patient.uri + "/contact-relationships/archived"
      }) }}
    </p>
  {% endif %}
{% endblock %}
