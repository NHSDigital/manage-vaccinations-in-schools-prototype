{% from "patient/_navigation.njk" import patientNavigation with context %}

{% extends "_layouts/form.njk" %}

{% set gridColumns = "full" %}
{% set hideConfirmButton = true %}
{% set title = patient.initials %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [{
      text: __("home.show.title"),
      href: "/"
    }, {
      text: __("patient.list.title"),
      href: "/patients"
    }]
  }) }}
{% endblock %}

{% block form %}
  {{ super() }}

  {{ patientNavigation({
    patient: patient,
    view: "contacts"
  }) }}

  {{ actionLink({
    text: __("contact.new.label"),
    href: "/contacts/new?patient_uuid=" + patient.uuid
  }) }}

  {% for contact in patient.contacts %}
    {{ summaryList({
      card: {
        heading: contact.fullNameAndRelationship,
        headingLevel: 4,
        headingSize: "m",
        actions: {
          items: [{
            text: __("actions.edit"),
            href: contact.uri + "/edit"
          }, {
            text: __("actions.delete"),
            href: contact.uri + "/delete"
          }]
        }
      },
      lastRowBorder: false,
      rows: summaryRows(contact, {
        email: {},
        tel: {},
        communicationNeeds: {}
      })
    }) }}
  {% endfor %}
{% endblock %}
