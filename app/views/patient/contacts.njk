{% from "patient/_navigation.njk" import patientNavigation with context %}
{% from "patient/_contact.njk" import contactSection with context %}

{% extends "_layouts/form.njk" %}

{% set gridColumns = "full" %}
{% set hideConfirmButton = true %}
{% set title = patient.initials %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [
      {
        text: __("home.show.title"),
        href: "/"
      },
      {
        text: __("patient.list.title"),
        href: "/patients"
      }
    ]
  }) }}
{% endblock %}

{% block form %}
  {{ super() }}

  {{ patientNavigation({
    patient: patient,
    view: "contacts"
  }) }}

  {# Note: this isn't guaranteed to work if the patient has multiple notices but should be fine for canned data #}
  {{ appStatus({
    text: patient.notice.name,
    icon: "warning",
    colour: "blue"
  }) if patient.isSensitive }}

  {% for contact in patient.contacts %}
    {{ contactSection(contact, not account.isSchoolUser) }}
  {% endfor %}

  {{ actionLink({
    text: __("contact.new.label"),
    href: "/contacts/new?patient_uuid=" + patient.uuid
  }) if not account.isSchoolUser }}
{% endblock %}
