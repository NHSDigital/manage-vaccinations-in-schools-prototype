{% call details({
  classes: "nhsuk-expander",
  summary: __("patient.notes.new.title")
}) %}
  {{ textarea({
    label: __("event.note.label"),
    hint: __("event.note.hint"),
    rows: 5,
    decorate: "note"
  }) }}

  {{ button({
    text: __("patient.notes.new.confirm"),
    attributes: {
      formaction: patient.uri + "/new/note"
    }
  }) }}
{% endcall %}
