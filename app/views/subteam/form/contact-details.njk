{% extends "_layouts/form.njk" %}

{% set title = __("subteam.contactDetails.title") %}

{% block form %}
  {{ radios({
    fieldset: {
      legend: {
        caption: subteam.name,
        heading: title,
        size: "l"
      }
    },
    hint: __("subteam.contactDetails.hint"),
    items: [
      {
        text: __("subteam.contactDetails.team", { team: team }),
        hint: {
          text: [team.email, team.tel] | join(", ")
        },
        value: "team",
        checked: true
      },
      {
        text: __("subteam.contactDetails.subteam"),
        value: "subteam",
        conditional: {
          html: input({
            label: __("subteam.email.label"),
            hint: __("subteam.email.hint"),
            type: "email",
            decorate: "subteam.email"
          }) + input({
            label: __("subteam.tel.label"),
            hint: __("subteam.tel.hint"),
            type: "tel",
            classes: "nhsuk-input--width-20",
            decorate: "subteam.tel"
          })
        }
      }
    ],
    decorate: "subteam.contactDetails"
  }) }}
{% endblock %}
