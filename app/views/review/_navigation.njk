{% from "_macros/heading.njk" import appHeading %}
{% from "_macros/section-navigation.njk" import appSectionNavigation %}

{% macro reviewNavigation(params) %}
  {{ appHeading({
    title: __("review.list.title")
  }) }}

  {{ appSectionNavigation({
    items: [
      {
        text: __("notice.list.label"),
        badge: { text: data.counts.notices },
        href: "/notices",
        current: params.view == "notice"
      },
      {
        text: __("consent.list.label"),
        badge: { text: data.counts.consents },
        href: "/consents",
        current: params.view == "consent"
      },
      {
        text: __("appointments.list.label"),
        badge: { text: data.counts.appointments },
        href: "/unmatched-appointments",
        current: params.view == "appointments"
      },
      {
        text: __("move.list.label"),
        badge: { text: data.counts.moves },
        href: "/moves",
        current: params.view == "move"
      }
    ]
  }) }}

  {{ appHeading({
    classes: "nhsuk-u-visually-hidden",
    title: __(params.view + ".list.title"),
    level: 2
  }) }}
{% endmacro %}
