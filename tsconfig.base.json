{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "/nhsuk-frontend/nhsuk-frontend.min.js": ["./node_modules/nhsuk-frontend"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ESNext",
    "types": []
  },
  "exclude": ["./node_modules", "./assets"],
  "typeAcquisition": {
    "enable": false
  }
}
